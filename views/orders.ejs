<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("partials/head") %>
  <title>Orders</title>
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>

  <%- include("partials/nav") %>

  <main class="shell shell--wide">

    <header class="shell__header">
      <div>
        <h1>Orders</h1>
        <p class="shell__sub">
          <%= isSource
              ? "Sales in the destination stores you supply, raised here at your own prices."
              : "Your sales, and the order each one raised at the store that supplied it." %>
        </p>
      </div>
    </header>

    <p class="notice notice--error" id="page-error" hidden></p>

    <%# One table, two tabs, the same shape as Products. "Waiting" holds
        anything not yet placed at the source -- queued, failed or skipped --
        because from the merchant's side those are all "the source has not got
        this yet". %>
    <nav class="tabs">
      <button
        class="tabs__tab<%= tab === "placed" ? " tabs__tab--on" : "" %>"
        type="button" data-tab="placed">
        Placed (<%= counts.placed %>)
      </button>
      <button
        class="tabs__tab<%= tab === "waiting" ? " tabs__tab--on" : "" %>"
        type="button" data-tab="waiting">
        Waiting (<%= counts.waiting %>)
      </button>
    </nav>

    <section class="panel">

      <% if (!orders.length) { %>

        <p class="panel__copy">
          <% if (tab === "waiting") { %>
            Nothing is waiting. Every sale so far has reached
            <%= isSource ? "this store" : "its source store" %>.
          <% } else if (isSource) { %>
            No orders yet. When a destination store sells one of your synced
            products, the matching order appears here.
          <% } else { %>
            No orders yet. When someone buys a synced product from your store,
            the order raised at its source store appears here.
          <% } %>
        </p>

      <% } else { %>

      <table class="table">
        <thead>
          <tr>
            <th>Order</th>
            <th><%= isSource ? "Sold by" : "Source store" %></th>
            <th>Items</th>
            <%# Both totals, side by side: the difference between them IS the
                markup, and this is the only screen that shows it. %>
            <th><%= isSource ? "You are owed" : "Customer paid" %></th>
            <th><%= isSource ? "Customer paid" : "Source price" %></th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(function (order) { %>
            <tr>
              <td>
                <span class="media__body">
                  <span class="table__title">
                    <%= order.destination_order_name || ("#" + order.destination_shopify_order_id) %>
                  </span>
                  <span class="muted">
                    <% if (order.source_order_name) { %>
                      &rarr; <%= order.source_order_name %> here
                    <% } else { %>
                      not yet placed
                    <% } %>
                  </span>
                </span>
              </td>
              <td>
                <%= isSource
                    ? (order.destination_store_name || order.destination_shop_domain)
                    : (order.source_store_name || order.source_shop_domain) %>
              </td>
              <td><%= order.line_count %></td>

              <%# The source's column comes first for a source, so each store
                  reads its own money in the same place. %>
              <td>
                <strong>
                  <%= order.currency %>
                  <%= (isSource ? order.source_total : order.destination_total) === null
                      ? "—"
                      : (isSource ? order.source_total : order.destination_total).toFixed(2) %>
                </strong>
              </td>
              <td class="muted">
                <%= order.currency %>
                <%= (isSource ? order.destination_total : order.source_total) === null
                    ? "—"
                    : (isSource ? order.destination_total : order.source_total).toFixed(2) %>
              </td>

              <td>
                <span class="pill pill--<%= order.sync_status %>">
                  <%= order.sync_status === "synced" ? "placed" : order.sync_status %>
                </span>
                <% if (order.error_message && order.sync_status !== "synced") { %>
                  <span class="muted"><%= order.error_message %></span>
                <% } %>
              </td>

              <td class="table__actions">
                <button
                  class="btn btn--small view-order"
                  type="button"
                  data-order="<%= order.id %>">
                  View
                </button>
                <%# Only the destination retries: its sale is what raised this
                    order, so it is the end that owns the decision. %>
                <% if (!isSource && order.sync_status !== "synced") { %>
                  <button
                    class="btn btn--small btn--primary retry-order"
                    type="button"
                    data-order="<%= order.id %>">
                    Place now
                  </button>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <% } %>
    </section>

  </main>

  <script>
    (function () {
      var pageError = document.getElementById("page-error");

      function fail(message) {
        pageError.textContent = message;
        pageError.hidden = false;
      }

      /* ---------------- tabs ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".tabs__tab"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            // A real navigation, not a class toggle: the two tabs hold
            // different rows and the server decides which.
            window.appNavigate("/orders?tab=" + button.dataset.tab);
          });
        });

      /* ---------------- view one order ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".view-order"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            window.appNavigate("/orders/" + button.dataset.order);
          });
        });

      /* ---------------- place a waiting order now ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".retry-order"))
        .forEach(function (button) {
          button.addEventListener("click", async function () {
            pageError.hidden = true;
            button.disabled = true;
            button.textContent = "Placing…";

            try {
              var response = await window.appFetch(
                "/orders/" + button.dataset.order + "/retry",
                { method: "POST" }
              );

              var data = await response.json().catch(function () { return {}; });

              if (!response.ok) throw new Error(data.error || "Request failed");

              window.appToast("Placed at the source as " + data.name);
              window.appNavigate("/orders?tab=placed");
            } catch (err) {
              button.disabled = false;
              button.textContent = "Place now";
              fail(err.message);
            }
          });
        });
    })();
  </script>

</body>

</html>
