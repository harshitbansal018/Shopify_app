<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head") %>
  <title><%= product.title %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>

  <%- include("../partials/nav") %>

  <main class="shell">

    <header class="shell__header">
      <div>
        <button class="back-btn" type="button" id="back"><span class="back-btn__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></span>Products</button>
        <h1>
          <% if (product.destination_shopify_product_id) { %>
            <a class="record-link"
               href="<%= shopifyAdminUrl(shop, 'products', product.destination_shopify_product_id) %>"
               target="_blank" rel="noopener noreferrer"><%= product.title %></a>
          <% } else { %>
            <%= product.title %>
          <% } %>
        </h1>
        <p class="shell__sub">
          <%= shared.length %> of <%= totalVariants %>
          variant<%= totalVariants === 1 ? "" : "s" %> shared
          <% if (product.vendor) { %> &mdash; <%= product.vendor %><% } %>
        </p>
      </div>
    </header>

    <p class="notice notice--error" id="page-error" hidden></p>

    <% if (!isShared) { %>
      <p class="notice notice--warn">
        These variants are on offer from
        <strong><%= product.source_store_name || product.source_shop_domain %></strong>.
        Nothing has been added to your store yet &mdash; tick the product on the
        Products list and press <strong>Sync selected</strong>.
      </p>
    <% } %>

    <p class="notice">
      <% if (typeof shippingPolicy !== "undefined" && shippingPolicy && shippingPolicy.mode !== "disabled") { %>
        <strong>Shipping included:</strong> <%= shippingPolicy.currency %> <%= Number(shippingPolicy.flat_rate || 0).toFixed(2) %> per unit is already included before your margin.
      <% } else { %>
        <strong>Shipping not included:</strong> configure this product's delivery in your Shopify shipping settings.
      <% } %>
      <br>
      <% if (typeof sourceSettings !== "undefined" && sourceSettings && sourceSettings.sync_taxes) { %>
        <strong>Tax included:</strong> <%= Number(sourceSettings.tax_rate_percent || 0) %>% is already included before your margin; the synced variant is non-taxable to prevent double charging.
      <% } else { %>
        <strong>Tax not included:</strong> configure tax for this product in your destination Shopify store.
      <% } %>
    </p>

    <!-- <section class="panel">
      <h2 class="panel__title">Variants in this product</h2> -->

        <%# Read-only: this store cannot change what it was sent, so there is
            no actions column at all rather than a row of dead buttons. The
            columns stay when the table is empty; a table that vanishes reads
            as a screen that failed. %>
        <table class="table">
          <thead>
            <tr>
              <th>Variant</th>
              <th>SKU</th>
              <th>Price</th>
              <th>Stock</th>
            </tr>
          </thead>
          <tbody>
            <% if (!shared.length) { %>
              <tr class="row--empty">
                <td class="table__empty" colspan="4">
                  <strong>No records found</strong>
                </td>
              </tr>
            <% } else { %>
            <% shared.forEach(function (variant) { %>
              <tr>
                <td>
                  <span class="table__title">
                    <%# Shopify calls a single default variant "Default Title",
                        which means nothing to a merchant. These rows carry the
                        name under source_title. %>
                    <% var name = [variant.option1, variant.option2, variant.option3]
                         .filter(Boolean).join(" / ")
                       || variant.source_title; %>
                    <%= name === "Default Title" ? "Single variant" : (name || "—") %>
                  </span>
                </td>
                <td>
                  <% if (variant.sku) { %>
                    <span class="variants__sku"><%= variant.sku %></span>
                  <% } else { %>
                    <span class="muted">—</span>
                  <% } %>
                </td>
                <td>
                  <%= variant.source_price === null || variant.source_price === undefined
                      ? "—" : variant.source_price %>
                </td>
                <td class="muted">
                  <%= variant.inventory_quantity === null ||
                      variant.inventory_quantity === undefined
                      ? "—" : variant.inventory_quantity %>
                  <% if (variant.allocated_quantity !== undefined) { %>
                    <span class="muted"> reserved remaining<% if (variant.sold_quantity) { %> (<%= variant.sold_quantity %> sold)<% } %></span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
            <% } %>
          </tbody>
        </table>

    </section>

  </main>

  <script>
    document.getElementById("back").addEventListener("click", function () {
      window.appNavigate("/products");
    });
  </script>

</body>

</html>
