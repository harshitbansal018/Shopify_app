<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head") %>
  <title>Products</title>
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>

  <%- include("../partials/nav") %>

  <main class="shell shell--wide">

    <header class="shell__header">
      <div>
        <h1>Products</h1>
        <p class="shell__sub">
          Products synced into this store, and where each one came from.
        </p>
      </div>

      <div class="shell__actions">
        <%# A pair, and both act on the ticked rows: refresh these, or stop
            receiving these. Both start disabled, because nothing is ticked on
            load -- a button that does something to "everything" when nothing
            is chosen is the one a merchant presses by accident.

            Only on the Synced tab: these are products already in the store.
            The Unsynced tab's own buttons accept or decline instead. %>
        <%# The actions on ticked rows live in the floating bar under the
            table, which appears once anything is ticked. %>
      </div>
    </header>

    <p class="notice notice--error" id="page-error" hidden></p>

    <%# One table, three tabs, always shown: "nothing here" on one of them is
        itself the answer and the other tab may still have something.
        "Unsynced" is either a new source offer or a product whose existing
        destination copy has been moved to Draft. %>
    <%# Tabs and search on one row: both narrow the same table, so they belong
        together rather than stacked as two separate-looking controls. %>
    <div class="listbar">
      <nav class="tabs">
        <button
          class="tabs__tab<%= tab === "all" ? " tabs__tab--on" : "" %>"
          type="button" data-tab="all">
          All (<%= counts.all %>)
        </button>
        <button
          class="tabs__tab<%= tab === "synced" ? " tabs__tab--on" : "" %>"
          type="button" data-tab="synced">
          Synced (<%= counts.synced %>)
        </button>
        <button
          class="tabs__tab<%= tab === "unsynced" ? " tabs__tab--on" : "" %>"
          type="button" data-tab="unsynced">
          Unsynced (<%= counts.unsynced %>)
        </button>
      </nav>

      <%# One supplier, or all of them. Only offered once there is a choice to
          make: a dropdown with one store in it is a label pretending to be a
          control. Navigates through the page script, so the tab and the
          search come along -- narrowing to a store mid-search means "this
          supplier's matches", not "start again". %>
      <% if (connections.length > 1) { %>
        <div class="listbar__filter">
          <label class="field__label" for="store-filter">Source store</label>
          <select class="field__input field__input--compact" id="store-filter">
            <option value="" <%= storeFilter ? "" : "selected" %>>All stores</option>
            <% connections.forEach(function (connection) { %>
              <option
                value="<%= connection.id %>"
                <%= storeFilter === connection.id ? "selected" : "" %>>
                <%= connection.source.store_name || connection.source.shop_domain %><%=
                  connection.status !== "active" ? " (" + connection.status + ")" : "" %>
              </option>
            <% }); %>
          </select>
        </div>
      <% } %>

      <%# Searches inside the current tab and store filter. Across both tabs
          would be worse: they mean different things to act on, and a result
          you cannot see without also switching tab is a dead end. %>
      <%- include("../partials/search", {
        action: "/products",
        search: search,
        placeholder: "Search by title, vendor, SKU or source store",
        hidden: [
          { name: "tab", value: tab },
          { name: "store", value: storeFilter || "" },
        ],
        clearHref: "/products?tab=" + tab + (storeFilter ? "&store=" + storeFilter : ""),
      }) %>
    </div>

    <% var productSelectionLimit = null; %>
    <% if (typeof planStatus !== "undefined" && planStatus && planStatus.plan && planStatus.limits.products !== null) { %>
      <% productSelectionLimit = Math.max(0, planStatus.limits.products - planStatus.usage.products); %>
    <% } %>

    <%# How much of the plan is in use, beside the list that fills it. The limit
        is enforced when products are accepted; this is here so the merchant
        sees it coming instead of meeting it as an error. %>
    <% if (typeof planStatus !== "undefined" && planStatus && planStatus.plan && planStatus.limits.products !== null) { %>
      <% var room = productSelectionLimit; %>
      <section class="plan-capacity<%= room <= 0 ? " plan-capacity--full" : "" %>" role="status">
        <div class="plan-capacity__usage">
          <strong><%= planStatus.usage.products %> / <%= planStatus.limits.products %></strong>
          <span>products used</span>
        </div>
        <div class="plan-capacity__message">
          <strong class="plan-capacity__title">
            <%= planStatus.plan.name %> plan<%= room <= 0 ? " limit reached" : " usage" %>
          </strong>
          <span class="plan-capacity__copy">
            <% if (room > 0) { %>
              You can sync <%= room %> more product<%= room === 1 ? "" : "s" %>.
            <% } else { %>
              Unsync products or upgrade your plan to add more.
            <% } %>
          </span>
        </div>
        <% if (room <= 0) { %>
          <a class="btn btn--primary btn--small plan-capacity__action"
             href="/plans" data-navigate="/plans">Upgrade plan</a>
        <% } %>
      </section>
    <% } %>

    <%# Only when there is something to act on: buttons over an empty list
        are just dead controls. %>
    <% if (tab === "unsynced" && products.length) { %>
      <div class="panel__header">
        <p class="panel__copy">
          A source store has offered these. Tick the ones you want and press
          <strong>Sync selected</strong> &mdash; nothing is added to your
          store until you do.
        </p>
      </div>
    <% } %>

    <%# The table keeps its columns when it is empty and says so in a row of
        its own: a table that vanishes reads as a screen that failed. %>
        <table class="table">
          <thead>
            <tr>
              <%# Both tabs: the Unsynced tab ticks rows to sync or decline,
                  the Synced tab ticks them to unsync. Only this page's rows --
                  nothing off-screen is ever included in an action. %>
              <th class="table__check">
                <input
                  type="checkbox"
                  id="check-all-awaiting"
                  aria-label="Select all on this page">
              </th>
              <th>Product</th>
              <th>Source store</th>
              <th>Inventory</th>
              <th>Total variants</th>
              <th>Status</th>
              <th>Variants</th>
              <th class="table__actions-head">Actions</th>
            </tr>
          </thead>
          <tbody id="product-rows">
            <% if (!products.length) { %>
              <tr class="row--empty">
                <%# One cell across every column, the checkbox one included. %>
                <td class="table__empty" colspan="8">
                  <strong>No records found</strong>
                </td>
              </tr>
            <% } else { %>
            <% products.forEach(function (product) { %>
              <% var rowSynced = product.accepted_at !== null; %>
              <tr>
                <td class="table__check">
                  <%# One class for both tabs -- what the tick MEANS is decided
                      by which button acts on it, not by the checkbox.

                      Disabled rather than absent on a 'deleted' row: the
                      product is gone at the source, so there is nothing left
                      to sync or unsync, and this is the same reason its status
                      is a label rather than a button. A column that sometimes
                      has no control in it reads as broken. %>
                  <input
                    type="checkbox"
                    class="awaiting-check"
                    value="<%= product.mapping_id %>"
                    data-synced="<%= rowSynced ? 1 : 0 %>"
                    <% if (product.sync_status === "deleted") { %>disabled data-unavailable="1"<% } %>
                    <%= !rowSynced && productSelectionLimit === 0 ? "disabled" : "" %>
                    title="<%= product.sync_status === "deleted"
                      ? "Deleted at the source store"
                      : (!rowSynced && productSelectionLimit === 0
                        ? "Your product plan limit has been reached"
                        : "") %>"
                    aria-label="<%= rowSynced ? "Unsync" : "Sync" %> <%= product.title %>">
                </td>
                <td>
                  <span class="media">
                    <% if (product.image_url) { %>
                      <img class="media__thumb" src="<%= product.image_url %>"
                           alt="" loading="lazy" width="40" height="40">
                    <% } else { %>
                      <span class="media__thumb media__thumb--empty" aria-hidden="true"></span>
                    <% } %>
                    <span class="media__body">
                      <% if (product.destination_shopify_product_id) { %>
                        <a class="table__title record-link"
                           href="<%= shopifyAdminUrl(shop, 'products', product.destination_shopify_product_id) %>"
                           target="_blank" rel="noopener noreferrer">
                          <%= product.title %>
                        </a>
                      <% } else { %>
                        <span class="table__title"><%= product.title %></span>
                      <% } %>
                      <span class="muted">
                        <%# The product's own state at the source. It used to
                            sit under Status, which now means the sync. %>
                        <%= (product.status || "").toUpperCase() || "—" %>
                        <% if (product.vendor) { %>&middot; <%= product.vendor %><% } %>
                      </span>
                    </span>
                  </span>
                </td>
                <td>
                  <%# The point of this screen: which store sent it. %>
                  <%= product.source_store_name || product.source_shop_domain %>
                </td>
                <td>
                  <%# Red at zero: a product with no stock will sync but sell
                      nothing, and that is worth noticing before accepting. %>
                  <span class="<%= product.inventory ? "" : "stock--none" %>">
                    <%= product.inventory %> in stock
                  </span>
                </td>
                <td><%= product.offered_variant_count %></td>
                <td>
                  <%# Status is display-only. The matching single-product
                      control lives in the final Actions column. %>
                  <% if (product.sync_status === "deleted") { %>
                    <span class="pill pill--failed">deleted</span>
                  <% } else if (!rowSynced) { %>
                    <span class="pill pill--pending">unsynced</span>
                  <% } else { %>
                    <span class="pill pill--<%= product.sync_status %>">
                      <%= product.sync_status %>
                    </span>
                    <% if (product.sync_status === "failed" && product.error_message) { %>
                      <span class="muted"><%= product.error_message %></span>
                    <% } %>
                  <% } %>
                </td>
                <td class="table__actions">
                  <button
                    class="btn btn--small view-product"
                    type="button"
                    data-product="<%= product.mapping_id %>">
                    View
                  </button>
                </td>
                <td class="table__actions">
                  <% if (product.sync_status !== "deleted") { %>
                    <button
                      class="btn btn--small product-sync-action<%= rowSynced ? " btn--danger" : " btn--success" %>"
                      type="button"
                      data-mapping="<%= product.mapping_id %>"
                      data-action="<%= rowSynced ? "unsync" : "sync" %>"
                      <%= !rowSynced && productSelectionLimit === 0 ? "disabled" : "" %>
                      title="<%= !rowSynced
                        ? (productSelectionLimit === 0
                          ? "Your product plan limit has been reached"
                          : "Sync into this store")
                        : "Stop syncing and move back to Unsynced" %>">
                      <%= rowSynced ? "Unsync" : "Sync" %>
                    </button>
                  <% } %>
                </td>
              </tr>
            <% }); %>
            <% } %>
          </tbody>
        </table>

    <%# Floats in over the table once anything is ticked. Unsynced: accept or
        decline. Synced: refresh what is already there or stop
        receiving. %>
      <div class="bulkbar" id="bulkbar" role="region" aria-label="Bulk actions" hidden>
        <span class="bulkbar__count" id="bulk-count">0 selected</span>
        <% if (tab === "all") { %>
          <button class="bulkbar__btn" type="button" id="accept-button" disabled>Sync selected</button>
          <button class="bulkbar__btn bulkbar__btn--danger" type="button" id="unsync-button" disabled>Unsync selected</button>
          <button class="bulkbar__btn bulkbar__btn--ghost" type="button" id="decline-button" disabled>Decline</button>
        <% } else if (tab === "unsynced") { %>
          <button class="bulkbar__btn" type="button" id="accept-button" disabled>Sync selected</button>
          <button class="bulkbar__btn bulkbar__btn--ghost" type="button" id="decline-button" disabled>Decline</button>
        <% } else { %>
          <button class="bulkbar__btn" type="button" id="sync-button" disabled>Refresh now</button>
          <button class="bulkbar__btn bulkbar__btn--danger" type="button" id="unsync-button" disabled>Unsync selected</button>
        <% } %>
        <button class="bulkbar__close" type="button" id="bulk-clear" aria-label="Clear selection">&times;</button>
      </div>

    <div id="products-pager">
      <%- include("../partials/pager", { pager: pager, noun: "products" }) %>
    </div>

  </main>

  <script>
    (function () {
      var acceptButton = document.getElementById("accept-button");
      var syncButton = document.getElementById("sync-button");
      var declineButton = document.getElementById("decline-button");
      var unsyncButton = document.getElementById("unsync-button");
      var checkAll = document.getElementById("check-all-awaiting");
      var pageError = document.getElementById("page-error");
      var selectionLimit = acceptButton
        ? <%- json(productSelectionLimit) %>
        : null;

      /*
       * Show an error, and where the plan refused one, the way out of it.
       *
       * "Upgrade your plan to add more" is only half a sentence without
       * somewhere to go, and a merchant reading it should not have to hunt
       * the nav for Plans.
       *
       * Built with DOM nodes rather than innerHTML: the message is written by
       * the server and carries names a merchant typed.
       */
      function fail(message, offerPlans) {
        pageError.textContent = message;

        if (offerPlans) {
          pageError.appendChild(document.createTextNode(" "));

          var link = document.createElement("a");
          link.className = "link";
          link.href = "/plans";
          // Picked up by the delegated handler in shopifyClient.js, which
          // watches the document -- so a link added now works like any other.
          link.setAttribute("data-navigate", "/plans");
          link.textContent = "See plans";

          pageError.appendChild(link);
        }

        pageError.hidden = false;
      }

      /* The server sends a `limit` object when a plan is what refused the
       * request. Carried on the Error so the catch can tell a plan refusal
       * from an ordinary failure. */
      function requestFailed(data) {
        var error = new Error(data.error || "Request failed");
        error.plan = Boolean(data.limit);
        return error;
      }

      /* A /products URL that keeps whatever is being searched for.
       *
       * Every navigation on this screen goes through it. After an action moves
       * a row to the other tab, the merchant should arrive there still looking
       * for what they were looking for -- not back at the full list. */
      var currentSearch = <%- json(search || "") %>;
      var currentTab = <%- json(tab) %>;

      var currentStore = <%- json(storeFilter ? String(storeFilter) : "") %>;

      function productsUrl(tab) {
        var params = new URLSearchParams();

        if (tab) params.set("tab", tab);
        if (currentSearch) params.set("q", currentSearch);
        if (currentStore) params.set("store", currentStore);

        var query = params.toString();
        return query ? "/products?" + query : "/products";
      }

      var productRows = document.getElementById("product-rows");
      var productsPager = document.getElementById("products-pager");
      var productLiveVersion = <%- json(
        typeof liveVersion !== "undefined" ? liveVersion : ""
      ) %>;
      var liveRefreshing = false;

      function liveProductsUrl() {
        var url = new URL(window.location.href);
        url.pathname = "/products/live";
        url.searchParams.delete("id_token");
        return url.pathname + url.search;
      }

      function updateDestinationCounts(counts) {
        ["all", "synced", "unsynced"].forEach(function (key) {
          var tab = document.querySelector('.tabs__tab[data-tab="' + key + '"]');
          if (tab && counts && counts[key] !== undefined) {
            var label = key.charAt(0).toUpperCase() + key.slice(1);
            tab.textContent = label + " (" + counts[key] + ")";
          }
        });
      }

      async function refreshProductsLive(force) {
        if (liveRefreshing || document.hidden) return false;
        if (!force && document.querySelector(".is-loading")) return false;
        liveRefreshing = true;

        try {
          var response = await window.appFetch(liveProductsUrl(), {
            background: true
          });
          var data = await response.json().catch(function () { return {}; });
          if (!response.ok || !data.ok) return false;

          updateDestinationCounts(data.counts);
          if (acceptButton) selectionLimit = data.productSelectionLimit;
          Array.prototype.slice.call(
            document.querySelectorAll('.product-sync-action[data-action="sync"]')
          ).forEach(function (button) {
            button.disabled = selectionLimit === 0;
            button.title = selectionLimit === 0
              ? "Your product plan limit has been reached"
              : "Sync into this store";
          });
          if (data.version === productLiveVersion) {
            refresh();
            return false;
          }
          productLiveVersion = data.version;
          if (productsPager && productsPager.innerHTML.trim() !== data.pager.trim()) {
            productsPager.innerHTML = data.pager;
          }
          if (productRows && productRows.innerHTML.trim() !== data.rows.trim()) {
            productRows.innerHTML = data.rows;
            if (checkAll) checkAll.checked = false;
            bindViewButtons();
            bindSyncActions();
            refresh();
            return true;
          }
        } catch (_) {
          // A background failure is retried quietly. Button actions continue
          // to report failures in the page error banner.
        } finally {
          liveRefreshing = false;
        }

        return false;
      }

      var productLiveTimer = setInterval(function () {
        refreshProductsLive(false);
      }, 4000);

      window.addEventListener("pagehide", function () {
        clearInterval(productLiveTimer);
      });

      /* ---------------- store filter ---------------- */

      var storeFilter = document.getElementById("store-filter");

      if (storeFilter) {
        storeFilter.addEventListener("change", function () {
          // A real navigation: the server decides which rows there are, so
          // the tab counts and the list cannot disagree. The tab and the
          // search stay; the page number does not -- a new filter is a new
          // list, and page 3 of it is probably empty.
          currentStore = storeFilter.value;
          window.appNavigate(productsUrl(<%- json(tab) %>));
        });
      }

      /* ---------------- tabs ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".tabs__tab"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            // A real navigation, not a class toggle: the two tabs hold
            // different rows and the server decides which ones.
            //
            // The search comes along: switching tabs mid-search means "the
            // other tab, still looking for this".
            // The search and the store filter come along: switching tabs
            // mid-search means "the other tab, still looking for this".
            window.appNavigate(productsUrl(button.dataset.tab));
          });
        });

      /* ---------------- view one product ---------------- */

      function bindViewButtons() {
        Array.prototype.slice.call(document.querySelectorAll(".view-product"))
        .forEach(function (button) {
          if (button.dataset.liveBound) return;
          button.dataset.liveBound = "1";
          button.addEventListener("click", function () {
            window.appNavigate("/products/" + button.dataset.product);
          });
        });
      }

      bindViewButtons();

      /* ---------------- refresh what is already accepted ---------------- */

      if (syncButton) {
        syncButton.addEventListener("click", async function () {
          pageError.hidden = true;

          // Every bulk button goes down together: a second action fired
          // mid-request would send the same ids twice.
          // appFetch owns the pressed button's disabled/loading state. Disable
          // only its neighbours here so the helper sees this button as active
          // and can restore it correctly if the request fails.
          bulkButtons.forEach(function (button) {
            if (button !== syncButton) button.disabled = true;
          });
          syncButton.textContent = "Refreshing…";

          try {
            var response = await window.appFetch("/products/sync", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ mapping_ids: chosen() }),
              busy: syncButton
            });
            var data = await response.json().catch(function () { return {}; });

            if (!response.ok) throw requestFailed(data);

            window.appToast(data.synced + " updated, " + data.failed + " failed");
            await refreshProductsLive(true);
          } catch (err) {
            refresh();
            fail(err.message, err.plan);
          }
        });
      }

      /* ---------------- one product from the Actions column ---------------- */

      function bindSyncActions() {
        Array.prototype.slice.call(document.querySelectorAll(".product-sync-action"))
        .forEach(function (pill) {
          if (pill.dataset.liveBound) return;
          pill.dataset.liveBound = "1";
          pill.addEventListener("click", async function () {
            var unsync = pill.dataset.action === "unsync";

            // Syncing writes to the store, so it needs no warning; stopping
            // one does, because the merchant is giving up future updates.
            if (unsync && !(await window.appConfirm(
              "Stop syncing this product?\n\n" +
              "It moves back to Unsynced and becomes Draft in Shopify. " +
              "Sync it again to make it Active and resume updates.",
              { confirmLabel: "Stop syncing" }
            ))) return;

            pageError.hidden = true;
            pill.disabled = true;
            pill.textContent = unsync ? "stopping…" : "syncing…";

            try {
              var response = await window.appFetch(
                unsync ? "/products/decline" : "/products/accept",
                {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ mapping_ids: [pill.dataset.mapping] }),
                  busy: pill
                }
              );

              var data = await response.json().catch(function () { return {}; });

              if (!response.ok) throw requestFailed(data);

              window.appToast(unsync ? "Moved to Unsynced" : "Synced");
              await refreshProductsLive(true);
            } catch (err) {
              // A plan refusal is authoritative even if this page was opened
              // before another tab used the last slot. Keep every action that
              // ADDS a product disabled; retrying cannot succeed until usage
              // changes or the plan is upgraded. Unsync is never plan-blocked.
              if (err.plan && !unsync) {
                selectionLimit = 0;
                Array.prototype.slice.call(
                  document.querySelectorAll(
                    '.product-sync-action[data-action="sync"]'
                  )
                ).forEach(function (button) {
                  button.disabled = true;
                  button.title = "Your product plan limit has been reached";
                });
                refresh();
              }
              pill.disabled = !unsync && selectionLimit === 0;
              pill.textContent = pill.dataset.was;
              fail(err.message, err.plan);
            }
          });

          // Remembered before any click, so a failure can put the word back.
          pill.dataset.was = pill.textContent.trim();
        });
      }

      bindSyncActions();

      /* ---------------- acting on the ticked rows ----------------

         Both tabs tick rows; what the tick MEANS differs. Unsynced offers
         Sync selected and Decline, Synced offers Unsync selected. The
         selection code below is shared, and each button is wired only if this
         tab actually rendered it. */

      // Buttons that act on the selection, whichever tab we are on.
      var bulkButtons = [acceptButton, declineButton, unsyncButton, syncButton]
        .filter(Boolean);

      // A page with no rows to tick: the rest of this is a read-only list.
      if (!bulkButtons.length) return;

      function checks() {
        // A deleted source product is permanently unavailable. Plan-disabled
        // boxes remain in this list so they can be enabled again immediately
        // when the merchant unticks one of their current choices.
        return Array.prototype.slice.call(
          document.querySelectorAll(".awaiting-check:not([data-unavailable])")
        );
      }

      function chosen() {
        return checks()
          .filter(function (c) { return c.checked; })
          .map(function (c) { return c.value; });
      }

      function chosenBySyncState(synced) {
        return checks()
          .filter(function (c) {
            return c.checked && (c.dataset.synced === "1") === synced;
          })
          .map(function (c) { return c.value; });
      }

      var bulkbar = document.getElementById("bulkbar");
      var bulkCount = document.getElementById("bulk-count");
      var bulkClear = document.getElementById("bulk-clear");

      function refresh() {
        var count = chosen().length;
        var unsyncedCount = chosenBySyncState(false).length;
        var syncedCount = chosenBySyncState(true).length;

        if (acceptButton && selectionLimit !== null) {
          checks().forEach(function (c) {
            var heldByLimit = c.dataset.synced !== "1" &&
              !c.checked && unsyncedCount >= selectionLimit;
            c.disabled = heldByLimit;
            c.title = heldByLimit
              ? "You have selected all products available on your plan"
              : "";
          });

        }

        checks().forEach(function (c) {
          c.closest("tr").classList.toggle("is-selected", c.checked);
        });
        if (bulkbar) {
          bulkbar.hidden = count === 0;
          bulkCount.textContent = count + " selected";
        }
        if (checkAll) {
          var syncedAvailable = checks().filter(function (c) {
            return c.dataset.synced === "1";
          }).length;
          var unsyncedAvailable = checks().length - syncedAvailable;
          var all = syncedAvailable + (selectionLimit === null
            ? unsyncedAvailable
            : Math.min(unsyncedAvailable, selectionLimit));
          checkAll.checked = count > 0 && count === all;
          checkAll.indeterminate = count > 0 && count < all;
          checkAll.disabled = all === 0;
        }

        bulkButtons.forEach(function (button) { button.disabled = count === 0; });
        // Sync selected creates new accepted products and consumes plan
        // capacity. Never let a restored/stale checked checkbox re-enable it
        // when there are zero slots. Decline remains available because it
        // removes an offer and consumes no capacity.
        if (acceptButton) {
          acceptButton.disabled = unsyncedCount === 0 || selectionLimit === 0;
        }
        if (declineButton) declineButton.disabled = unsyncedCount === 0;
        if (unsyncButton) unsyncButton.disabled = syncedCount === 0;
        if (syncButton) syncButton.disabled = syncedCount === 0;

        // The count goes on the primary action of each tab, so the merchant
        // can see how many they are about to act on without recounting ticks.
        if (acceptButton) {
          acceptButton.textContent = unsyncedCount
            ? "Sync " + unsyncedCount + " selected"
            : "Sync selected";
        }
        if (unsyncButton) {
          unsyncButton.textContent = syncedCount
            ? "Unsync " + syncedCount + " selected"
            : "Unsync selected";
        }
        if (syncButton) {
          syncButton.textContent = syncedCount
            ? "Refresh " + syncedCount + " now"
            : "Refresh now";
        }
        // No count on Decline -- it is the quieter of the two actions on this
        // tab -- but its word still has to come back after a failed attempt
        // left it reading "Declining…".
        if (declineButton) declineButton.textContent = "Decline";
      }

      if (productRows) productRows.addEventListener("change", function (event) {
        if (event.target.matches(".awaiting-check")) refresh();
      });

      if (checkAll) {
        checkAll.addEventListener("change", function () {
          var unsyncedPicked = 0;
          checks().forEach(function (c) {
            var isSynced = c.dataset.synced === "1";
            var hasRoom = selectionLimit === null || unsyncedPicked < selectionLimit;
            c.checked = checkAll.checked && (isSynced || hasRoom);
            if (c.checked && !isSynced) unsyncedPicked++;
          });
          refresh();
        });
      }

      if (bulkClear) {
        bulkClear.addEventListener("click", function () {
          checks().forEach(function (c) { c.checked = false; });
          refresh();
        });
      }

      async function send(url, label, pressed, mappingIds) {
        pageError.hidden = true;

        // Every one of them, not just the one pressed: a second action fired
        // mid-request would send the same ids twice.
        // Leave the pressed button to appFetch, which adds its visible spinner
        // and remembers its original enabled state. Lock only the other bulk
        // actions while this request is running.
        bulkButtons.forEach(function (button) {
          if (button !== pressed) button.disabled = true;
        });

        // The button the merchant actually pressed is the one that reports
        // back. Sync and Decline sit side by side on the Unsynced tab, so
        // picking a fixed one would spin Sync while Decline was running.
        if (pressed) pressed.textContent = label;

        try {
          var response = await window.appFetch(url, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ mapping_ids: mappingIds || chosen() }),
            busy: pressed
          });

          var data = await response.json().catch(function () { return {}; });

          if (!response.ok) throw requestFailed(data);

          return data;
        } catch (err) {
          refresh();
          fail(err.message, err.plan);
          return null;
        }
      }

      if (acceptButton) acceptButton.addEventListener("click", async function () {
        // Accepting also pulls the products in, so this can take a moment.
        var data = await send(
          "/products/accept",
          "Syncing…",
          acceptButton,
          chosenBySyncState(false)
        );

        if (!data) return;

        window.appToast(data.synced + " synced, " + data.failed + " failed");
        await refreshProductsLive(true);
      });

      /* ---- Synced tab: stop receiving several at once ---- */

      if (unsyncButton) unsyncButton.addEventListener("click", async function () {
        var count = chosenBySyncState(true).length;

        // The Shopify copy stays in Admin but is made Draft, so it cannot keep
        // selling after this app stops managing it.
        if (!(await window.appConfirm(
          "Stop syncing " + count + " product(s)?\n\n" +
          "They will become Draft in Shopify and stop receiving updates. " +
          "Their unsold reserved inventory will return to the source. " +
          "They are not deleted.\n\n" +
          "Sync them again from the Unsynced tab to make them Active and " +
          "resume updates.",
          { confirmLabel: "Stop syncing" }
        ))) return;

        var data = await send(
          "/products/decline",
          "Unsyncing…",
          unsyncButton,
          chosenBySyncState(true)
        );

        if (!data) return;

        var unsyncMessage = "Unsynced " + data.declined + " product(s)";
        if (data.returned) {
          unsyncMessage += ". Returned " + data.returned + " unsold unit(s) to the source";
        }
        window.appToast(unsyncMessage);
        await refreshProductsLive(true);
      });

      if (declineButton) declineButton.addEventListener("click", async function () {
        if (!(await window.appConfirm(
          "Stop receiving " + chosenBySyncState(false).length + " product(s)?\n\n" +
          "Any existing Shopify copy will become Draft and stop receiving updates. " +
          "Unsold reserved inventory will return to the source.",
          { confirmLabel: "Decline" }
        ))) return;

        var data = await send(
          "/products/decline",
          "Declining…",
          declineButton,
          chosenBySyncState(false)
        );

        if (!data) return;

        var declineMessage = "Declined " + data.declined + " product(s)";
        if (data.returned) {
          declineMessage += ". Returned " + data.returned + " unsold unit(s) to the source";
        }
        window.appToast(declineMessage);
        await refreshProductsLive(true);
      });

      // Apply a zero/full allowance immediately, before the first interaction.
      refresh();
    })();
  </script>

</body>

</html>
