<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head") %>
  <title><%= connection.source.store_name || connection.source.shop_domain %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>

  <%- include("../partials/nav") %>

  <main class="shell shell--wide">

    <%
      var money = function (value) {
        var amount = Number(value);
        return currency + " " + (isFinite(amount) ? amount : 0).toFixed(2);
      };

      /* A supplier connected but with nothing sold has no summary row of its
         own; zeros are the honest reading of that, not an error. */
      var owed = supplier ? supplier.outstanding : 0;
    %>

    <header class="shell__header">
      <div>
        <button class="back-btn" type="button" id="back"><span class="back-btn__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></span>Payouts</button>
        <% var supplierName = connection.source.store_name || connection.source.shop_domain; %>
        <div class="detail-title">
          <span class="avatar avatar--lg" aria-hidden="true"><%= String(supplierName).charAt(0).toUpperCase() %></span>
          <div>
            <h1><%= supplierName %></h1>
            <p class="shell__sub"><%= connection.source.shop_domain %></p>
          </div>
        </div>
      </div>
      <% if (owed > 0) { %>
        <span class="pill pill--pending"><%= money(owed) %> to pay</span>
      <% } else if (owed < 0) { %>
        <span class="pill"><%= money(Math.abs(owed)) %> in credit</span>
      <% } else { %>
        <span class="pill pill--synced">settled</span>
      <% } %>
    </header>

    <p class="notice notice--error" id="page-error" hidden></p>

    <%
      var cost = supplier ? Number(supplier.cost) || 0 : 0;
      var paid = supplier ? Number(supplier.paid) || 0 : 0;
      var revenue = supplier ? Number(supplier.revenue) || 0 : 0;
      var paidPct = cost > 0 ? Math.max(0, Math.min(100, Math.round((paid / cost) * 100))) : 0;
      var margin = revenue > 0 ? Math.round(((supplier ? Number(supplier.profit) || 0 : 0) / revenue) * 100) : null;
    %>

    <section class="payout-hero">
      <div class="payout-hero__main">
        <span class="payout-hero__label">Still to pay this supplier</span>
        <span class="card__value <%= owed > 0 ? "card__value--warn" : "" %>">
          <%= money(owed) %>
        </span>
        <span class="payout-hero__note">
          <% if (owed < 0) { %>
            You are in credit with them
          <% } else if (supplier && supplier.upcoming_cost > 0) { %>
            <%= money(supplier.upcoming_cost) %> more once shipped
          <% } else if (owed > 0) { %>
            Cost minus what you have paid
          <% } else { %>
            All settled &mdash; nothing outstanding
          <% } %>
        </span>

        <div class="payout-hero__progress">
          <div class="payout-hero__progress-row">
            <span>Paid so far</span>
            <strong><%= paidPct %>%</strong>
          </div>
          <span class="progress" aria-hidden="true"><span style="width: <%= paidPct %>%"></span></span>
          <span class="payout-hero__fine">
            <%= money(paid) %> paid of <%= money(cost) %> &middot; <%= supplier ? supplier.payments : 0 %> payment(s) recorded
          </span>
        </div>
      </div>

      <div class="payout-hero__stats">
        <div class="stat">
          <span class="stat__icon stat__icon--brand" aria-hidden="true"><%- include("../partials/icon", { name: "wallet" }) %></span>
          <span class="stat__body">
            <span class="stat__label">Revenue</span>
            <span class="stat__value"><%= money(supplier ? supplier.revenue : 0) %></span>
            <span class="stat__note"><%= supplier ? supplier.fulfilled_orders : 0 %> fulfilled order(s)</span>
          </span>
        </div>
        <div class="stat">
          <span class="stat__icon stat__icon--waiting" aria-hidden="true"><%- include("../partials/icon", { name: "box" }) %></span>
          <span class="stat__body">
            <span class="stat__label">Cost</span>
            <span class="stat__value"><%= money(supplier ? supplier.cost : 0) %></span>
            <span class="stat__note">What this supplier charges</span>
          </span>
        </div>
        <div class="stat">
          <span class="stat__icon <%= supplier && supplier.profit < 0 ? "stat__icon--danger" : "stat__icon--ok" %>" aria-hidden="true"><%- include("../partials/icon", { name: "check" }) %></span>
          <span class="stat__body">
            <span class="stat__label">Profit</span>
            <span class="stat__value <%= supplier && supplier.profit < 0 ? "stock--none" : "stat__value--ok" %>">
              <%= money(supplier ? supplier.profit : 0) %>
            </span>
            <span class="stat__note">
              Your margin on their goods<% if (margin !== null) { %> &middot; <strong><%= margin %>%</strong><% } %>
            </span>
          </span>
        </div>
      </div>
    </section>

    <section class="panel">
      <h2 class="panel__title panel__title--icon">
        <span class="stat__icon stat__icon--brand" aria-hidden="true"><%- include("../partials/icon", { name: "wallet" }) %></span>
        Record a payment
      </h2>
      <p class="panel__copy">
        <%# Said plainly, because a screen full of money can easily be mistaken
            for one that moves it. %>
        This is your own record of a transfer you have already made. No money
        moves through this app, and the supplier is not notified.
      </p>

      <div class="toggles">
        <label class="field">
          <span class="field__label">Amount<% if (currency) { %> (<%= currency %>)<% } %></span>
          <input class="field__input" type="number" id="amount"
                 step="0.01" min="0.01"
                 value="<%= owed > 0 ? owed.toFixed(2) : "" %>"
                 placeholder="0.00" autocomplete="off">
        </label>
        <label class="field">
          <span class="field__label">Paid on</span>
          <%# Defaults to today, but editable: a merchant recording Friday's
              transfer on Monday needs Friday. %>
          <input class="field__input" type="date" id="paid-at"
                 value="<%= new Date().toISOString().slice(0, 10) %>">
        </label>
        <label class="field">
          <span class="field__label">Reference</span>
          <input class="field__input" type="text" id="reference"
                 placeholder="Bank reference or invoice no." autocomplete="off">
        </label>
      </div>

      <div class="shell__actions">
        <button class="btn btn--primary" type="button" id="record">
          Record payment
        </button>
      </div>
    </section>

    <section class="panel">
      <h2 class="panel__title panel__title--icon">
        <span class="stat__icon stat__icon--ok" aria-hidden="true"><%- include("../partials/icon", { name: "check" }) %></span>
        Payments
      </h2>

      <table class="table">
        <thead>
          <tr>
            <th>Paid on</th>
            <th>Amount</th>
            <th>Reference</th>
            <th class="table__actions-head">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!payments.length) { %>
            <tr class="row--empty">
              <td class="table__empty" colspan="4">
                <strong>No records found</strong>
              </td>
            </tr>
          <% } else { %>
          <% payments.forEach(function (payment) { %>
            <tr>
              <td>
                <%= new Date(payment.paid_at).toISOString().slice(0, 10) %>
              </td>
              <td><strong><%= money(payment.amount) %></strong></td>
              <td class="muted"><%= payment.reference || "—" %></td>
              <td class="table__actions">
                <button
                  class="btn btn--small btn--danger delete-payment"
                  type="button"
                  data-payment="<%= payment.id %>"
                  data-amount="<%= money(payment.amount) %>">
                  Delete
                </button>
              </td>
            </tr>
          <% }); %>
          <% } %>
        </tbody>
      </table>

      <%- include("../partials/pager", { pager: paymentPager, noun: "payments" }) %>
    </section>

    <section class="panel">
      <h2 class="panel__title panel__title--icon">
        <span class="stat__icon stat__icon--brand" aria-hidden="true"><%- include("../partials/icon", { name: "truck" }) %></span>
        Sales behind this
      </h2>
      <p class="panel__copy">
        <%# "You owe 459.00" is not something a merchant can check or dispute
            without seeing which sales it came from. %>
        Only fulfilled orders count towards what you owe.
      </p>

      <table class="table">
        <thead>
          <tr>
            <th>Order</th>
            <th>Status</th>
            <th>Customer paid</th>
            <th>Supplier price</th>
            <th>Profit</th>
          </tr>
        </thead>
        <tbody>
          <% if (!orders.length) { %>
            <tr class="row--empty">
              <td class="table__empty" colspan="5">
                <strong>No records found</strong>
              </td>
            </tr>
          <% } else { %>
          <% orders.forEach(function (order) { %>
            <%
              var counts = order.source_fulfillment_status === "fulfilled";
              var profit = order.destination_total - order.source_total;
            %>
            <tr class="<%= counts ? "" : "row--placeholder" %>">
              <td>
                <%# The sale in the buyer's own Shopify admin. A new tab: this app
                    lives inside that admin's frame, and replacing it would put the
                    merchant outside the app with no way back but the browser. %>
                <a class="table__title record-link"
                   href="<%= shopifyAdminUrl(order.destination_shop_domain, 'orders', order.destination_shopify_order_id) %>"
                   target="_blank" rel="noopener noreferrer"><%= order.destination_order_name
                    || ("#" + order.destination_shopify_order_id) %></a>
              </td>
              <td>
                <span class="pill pill--<%=
                  order.source_fulfillment_status === "fulfilled" ? "synced"
                  : order.source_fulfillment_status === "cancelled" ? "failed"
                  : order.source_fulfillment_status === "partial" ? "paused"
                  : "pending" %>">
                  <%= order.source_fulfillment_status === "unfulfilled" ? "unfulfilled"
                      : order.source_fulfillment_status === "partial" ? "partially fulfilled"
                      : order.source_fulfillment_status %>
                </span>
              </td>
              <td><%= money(order.destination_total) %></td>
              <td class="muted"><%= money(order.source_total) %></td>
              <td>
                <% if (counts) { %>
                  <strong><%= money(profit) %></strong>
                <% } else { %>
                  <%# Dimmed above, and dashed here: it has earned nothing yet. %>
                  <span class="muted">—</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
          <% } %>
        </tbody>
      </table>

      <%- include("../partials/pager", { pager: orderPager, noun: "sales" }) %>
    </section>

  </main>

  <script>
    (function () {
      var pageError = document.getElementById("page-error");

      function fail(message) {
        pageError.textContent = message;
        pageError.hidden = false;
      }

      document.getElementById("back").addEventListener("click", function () {
        window.appNavigate("/payouts");
      });

      async function post(button, path, body, busyLabel) {
        pageError.hidden = true;

        var label = button.textContent;
        button.disabled = true;
        button.textContent = busyLabel;

        try {
          var response = await window.appFetch(
            "/payouts/<%= connection.id %>/" + path,
            {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(body || {}),
              busy: button
            }
          );

          var data = await response.json().catch(function () { return {}; });

          if (!response.ok) throw new Error(data.error || "Request failed");

          return data;
        } catch (err) {
          button.disabled = false;
          button.textContent = label;
          fail(err.message);
          return null;
        }
      }

      var record = document.getElementById("record");

      record.addEventListener("click", async function () {
        var amount = Number(document.getElementById("amount").value);

        // Checked here as well as on the server: a merchant should be told
        // straight away rather than after a round trip.
        if (!isFinite(amount) || amount <= 0) {
          return fail("Enter the amount you paid.");
        }

        var data = await post(record, "payments", {
          amount: amount,
          paid_at: document.getElementById("paid-at").value || null,
          reference: document.getElementById("reference").value.trim() || null
        }, "Saving…");

        if (!data) return;

        window.appToast("Payment recorded");
        window.appNavigate("/payouts/<%= connection.id %>");
      });

      Array.prototype.slice.call(document.querySelectorAll(".delete-payment"))
        .forEach(function (button) {
          button.addEventListener("click", async function () {
            if (!(await window.appConfirm(
              "Delete the " + button.dataset.amount + " payment?\n\n" +
              "It goes back onto what you owe this supplier.",
              { confirmLabel: "Delete payment", destructive: true }
            ))) return;

            var data = await post(
              button,
              "payments/" + button.dataset.payment + "/delete",
              {},
              "Deleting…"
            );

            if (!data) return;

            window.appToast("Payment deleted");
            window.appNavigate("/payouts/<%= connection.id %>");
          });
        });
    })();
  </script>

</body>

</html>
