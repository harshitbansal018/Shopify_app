<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head") %>
  <title>Payouts</title>
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>

  <%- include("../partials/nav") %>

  <main class="shell shell--wide">

    <header class="shell__header">
      <div>
        <h1>Payouts</h1>
        <p class="shell__sub">
          What you have earned on your suppliers' products, and what you still
          owe them for it.
        </p>
      </div>
    </header>

    <%
      /* One place to format money, so a null never reaches the page as "NaN"
         and every figure carries its currency. */
      var money = function (value) {
        var amount = Number(value);
        return currency + " " + (isFinite(amount) ? amount : 0).toFixed(2);
      };
    %>

    <%
      var costTotal = Number(totals.cost) || 0;
      var revenueTotal = Number(totals.revenue) || 0;
      /* Share of the suppliers' bill already paid. */
      var paidPct = costTotal > 0
        ? Math.max(0, Math.min(100, Math.round(((costTotal - (Number(totals.outstanding) || 0)) / costTotal) * 100)))
        : 0;
      /* Profit as a share of revenue. */
      var margin = revenueTotal > 0 ? Math.round(((Number(totals.profit) || 0) / revenueTotal) * 100) : null;
    %>

    <%# What has to be paid leads: it is the one figure here the merchant must
        act on. Revenue, cost and profit explain how it was reached. %>
    <section class="payout-hero">
      <div class="payout-hero__main card">
        <span class="payout-hero__label">Still to pay</span>
        <span class="card__value <%= totals.outstanding > 0 ? "card__value--warn" : "" %>">
          <%= money(totals.outstanding) %>
        </span>
        <span class="payout-hero__note">
          <% if (totals.upcoming > 0) { %>
            <%= money(totals.upcoming) %> more once shipped
          <% } else { %>
            Nothing else pending
          <% } %>
        </span>

        <div class="payout-hero__progress">
          <div class="payout-hero__progress-row">
            <span>Paid to suppliers</span>
            <strong><%= paidPct %>%</strong>
          </div>
          <span class="progress" aria-hidden="true"><span style="width: <%= paidPct %>%"></span></span>
          <span class="payout-hero__fine">
            of <%= money(totals.cost) %> owed for fulfilled orders
          </span>
        </div>
      </div>

      <div class="payout-hero__stats">
        <div class="stat card">
          <span class="stat__icon stat__icon--brand" aria-hidden="true"><%- include("../partials/icon", { name: "wallet" }) %></span>
          <span class="stat__body">
            <span class="stat__label">Revenue</span>
            <span class="stat__value"><%= money(totals.revenue) %></span>
            <span class="stat__note">What shoppers paid for supplied goods</span>
          </span>
        </div>
        <div class="stat card">
          <span class="stat__icon stat__icon--waiting" aria-hidden="true"><%- include("../partials/icon", { name: "box" }) %></span>
          <span class="stat__body">
            <span class="stat__label">Cost</span>
            <span class="stat__value"><%= money(totals.cost) %></span>
            <span class="stat__note">What your suppliers charge for them</span>
          </span>
        </div>
        <div class="stat card">
          <%# Green when ahead, red when the markup is negative. %>
          <span class="stat__icon <%= totals.profit < 0 ? "stat__icon--danger" : "stat__icon--ok" %>" aria-hidden="true"><%- include("../partials/icon", { name: "check" }) %></span>
          <span class="stat__body">
            <span class="stat__label">Profit</span>
            <span class="stat__value card__value <%= totals.profit < 0 ? "card__value--warn" : "stat__value--ok" %>">
              <%= money(totals.profit) %>
            </span>
            <span class="stat__note">
              Revenue minus cost<% if (margin !== null) { %> &middot; <strong><%= margin %>% margin</strong><% } %>
            </span>
          </span>
        </div>
      </div>
    </section>

    <section class="panel">
      <div class="panel__header">
        <h2 class="panel__title">By supplier</h2>
        <span class="muted">
          <%# The rule behind every figure, said once rather than guessed at. %>
          Counted when the supplier marks a sale fulfilled &mdash; cancelled
          orders were refunded and are not owed.
        </span>
      </div>

      <%# The table keeps its columns when it is empty and says so in a row of
          its own: a table that vanishes reads as a screen that failed. %>
      <table class="table">
        <thead>
          <tr>
            <th>Supplier</th>
            <th>Orders</th>
            <th>Revenue</th>
            <th>Cost</th>
            <th>Profit</th>
            <th>Paid</th>
            <th>Still to pay</th>
            <th class="table__actions-head">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!suppliers.length) { %>
            <tr class="row--empty">
              <td class="table__empty" colspan="8">
                <strong>No records found</strong>
              </td>
            </tr>
          <% } else { %>
          <% suppliers.forEach(function (supplier) { %>
            <tr>
              <td>
                <% var supplierName = supplier.source_store_name || supplier.source_shop_domain || "?"; %>
                <span class="media">
                  <span class="avatar" aria-hidden="true"><%= String(supplierName).charAt(0).toUpperCase() %></span>
                  <span class="media__body">
                    <span class="table__title"><%= supplierName %></span>
                    <% if (supplier.source_store_name) { %>
                      <span class="muted"><%= supplier.source_shop_domain %></span>
                    <% } %>
                  </span>
                </span>
              </td>

              <td>
                <%= supplier.fulfilled_orders %>
                <% if (supplier.open_orders) { %>
                  <%# Not owed yet, but coming. Worth seeing before it lands. %>
                  <span class="muted"><%= supplier.open_orders %> open</span>
                <% } %>
              </td>

              <td><%= money(supplier.revenue) %></td>
              <td class="muted"><%= money(supplier.cost) %></td>
              <td>
                <strong class="<%= supplier.profit < 0 ? "stock--none" : "profit--ok" %>">
                  <%= money(supplier.profit) %>
                </strong>
                <% var rowRevenue = Number(supplier.revenue) || 0; %>
                <% if (rowRevenue > 0) { %>
                  <span class="muted"><%= Math.round((Number(supplier.profit) || 0) / rowRevenue * 100) %>% margin</span>
                <% } %>
              </td>
              <td>
                <% var rowCost = Number(supplier.cost) || 0; %>
                <% var rowPct = rowCost > 0 ? Math.max(0, Math.min(100, Math.round((Number(supplier.paid) || 0) / rowCost * 100))) : 0; %>
                <span class="muted"><%= money(supplier.paid) %></span>
                <span class="progress progress--small" title="<%= rowPct %>% paid" aria-hidden="true"><span style="width: <%= rowPct %>%"></span></span>
              </td>

              <td>
                <% if (supplier.outstanding > 0) { %>
                  <strong><%= money(supplier.outstanding) %></strong>
                <% } else if (supplier.outstanding < 0) { %>
                  <%# Paid more than is owed. Not an error -- a merchant who
                      settled a round figure up front is in credit. %>
                  <span class="muted">
                    <%= money(Math.abs(supplier.outstanding)) %> in credit
                  </span>
                <% } else { %>
                  <span class="pill pill--synced">settled</span>
                <% } %>
              </td>

              <td class="table__actions">
                <button
                  class="btn btn--small view-supplier"
                  type="button"
                  data-connection="<%= supplier.connection_id %>">
                  View
                </button>
              </td>
            </tr>
          <% }); %>
          <% } %>
        </tbody>
      </table>
    </section>

  </main>

  <script>
    (function () {
      Array.prototype.slice.call(document.querySelectorAll(".view-supplier"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            window.appNavigate("/payouts/" + button.dataset.connection);
          });
        });
    })();
  </script>

</body>

</html>
