<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head") %>
  <title>Stores</title>
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>

  <%- include("../partials/nav") %>

  <main class="shell">

    <header class="shell__header">
      <div>
        <h1>Stores</h1>
        <p class="shell__sub">
          The source stores sending products into this one.
        </p>
      </div>

      <div class="shell__actions">
        <%# A destination redeems a code; it never hands one out. The form is
            behind a button because connecting is a one-off act, and a form
            sitting open on every visit reads as work still to do. %>
        <button class="btn btn--primary" type="button" id="add-store-button">
          + Add store
        </button>
      </div>
    </header>

      <h2 class="panel__title">Source stores sending here</h2>

      <table class="table">
        <thead>
          <tr>
            <th>Store</th>
            <th>Domain</th>
            <th>Status</th>
            <th>Sync</th>
            <th>Products</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!connections.length) { %>
            <tr class="row--empty">
              <td class="table__empty" colspan="6">
                <strong>No records found</strong>
                <span>
                  No source store is connected yet. Press <strong>Add store</strong>
                  and enter the pairing code from the source store.
                </span>
              </td>
            </tr>
          <% } else { %>
          <% connections.forEach(function (connection) { %>
            <% var other = connection.source; %>
            <tr>
              <td>
                <span class="table__title">
                  <%= other.store_name || other.shop_domain %>
                </span>
              </td>
              <td class="muted"><%= other.shop_domain %></td>
              <td>
                <span class="pill pill--<%= connection.status %>"><%= connection.status %></span>
                <%# A downgrade pauses stores rather than deleting them, so
                    the way back is here: its products never left. %>
                <% if (connection.status === "paused") { %>
                  <button
                    class="btn btn--small resume-store"
                    type="button"
                    data-connection="<%= connection.id %>"
                    data-store="<%= other.store_name || other.shop_domain %>">
                    Resume
                  </button>
                <% } %>
              </td>
              <td class="muted"><%= connection.sync_mode %></td>
              <td>
                <%# What removing this store would actually delete. Shown in
                    the row as well as in the dialog, so the number is not a
                    surprise sprung at the moment of confirming. %>
                <%= connection.removal.products %> in your store
              </td>
              <td class="table__actions">
                <button
                  class="btn btn--small btn--danger delete-store"
                  type="button"
                  data-connection="<%= connection.id %>"
                  data-store="<%= other.store_name || other.shop_domain %>"
                  data-domain="<%= other.shop_domain %>"
                  data-products="<%= connection.removal.products %>"
                  data-orders="<%= connection.removal.orders %>"
                  data-payments="<%= connection.removal.payments %>"
                  data-outstanding="<%= connection.removal.outstanding %>"
                  data-currency="<%= connection.removal.currency || "" %>">
                  Delete
                </button>
              </td>
            </tr>
          <% }); %>
          <% } %>
        </tbody>
      </table>

  </main>

  <%# The admin's own dialog. App Bridge's <s-modal> opens over the whole
      admin rather than inside the app's frame, and looks like every other
      dialog a merchant meets there. The buttons go in its action slots; the
      form stays a real form so that Enter in the code box submits it. %>
  <s-modal id="add-store-modal" heading="Add a source store">
    <form id="connect-form">

      <p class="modal__copy">
        Open this app on the source store, generate its pairing code, and enter
        it here. The connection goes live straight away.
      </p>

      <label class="field">
        <span class="field__label">Source pairing code</span>
        <input
          class="field__input field__input--compact"
          type="text"
          id="connect-code"
          name="code"
          placeholder="ABCD-1234"
          autocomplete="off"
          spellcheck="false"
          maxlength="9">
      </label>

      <p class="notice notice--error" id="connect-error" hidden></p>

    </form>

    <s-button slot="primary-action" variant="primary" id="connect-button">Add store</s-button>
    <s-button slot="secondary-actions" id="connect-cancel">Cancel</s-button>
  </s-modal>

  <%# The confirmation. Its own dialog rather than a one-line appConfirm: this
      deletes real products out of a real Shopify store, and the merchant has
      to be able to READ what goes before agreeing to it. The heading names
      the store; it is filled in when the dialog opens. %>
  <s-modal id="delete-store-modal" heading="Delete this store?">

      <p class="notice notice--error">
        <strong>This cannot be undone.</strong>
        <span id="delete-store-products"></span>
      </p>

      <p class="modal__copy">Deleting this store will:</p>

      <ul class="modal__list">
        <li id="delete-store-line-products"></li>
        <li>Stop this store receiving anything else from them.</li>
        <li id="delete-store-line-orders"></li>
        <li id="delete-store-line-payments"></li>
      </ul>

      <%# Only when there is money in the balance. An outstanding figure is the
          sharpest consequence of all, and burying it in a list nobody reads
          would be the wrong place for it. %>
      <p class="notice notice--warn" id="delete-store-owed" hidden></p>

      <p class="modal__copy muted">
        Your own orders and customers are not touched. Only the products this
        supplier put here are removed from your Shopify catalogue.
      </p>

      <%# How far a long delete has got. The button itself only spins. %>
      <p class="modal__copy" id="delete-store-progress" hidden></p>

      <p class="notice notice--error" id="delete-store-error" hidden></p>

    <s-button slot="primary-action" variant="primary" tone="critical" id="delete-store-confirm">
      Delete store and products
    </s-button>
    <s-button slot="secondary-actions" id="delete-store-cancel">Cancel</s-button>
  </s-modal>

  <script>
    (function () {
      var openButton = document.getElementById("add-store-button");
      var modal = document.getElementById("add-store-modal");
      var form = document.getElementById("connect-form");
      var input = document.getElementById("connect-code");
      var addButton = document.getElementById("connect-button");
      var cancelButton = document.getElementById("connect-cancel");
      var error = document.getElementById("connect-error");

      function showError(message) {
        error.textContent = message;
        error.hidden = false;
      }

      /* ---------------- open / close ---------------- */

      function open() {
        // Reset every time: a code that failed a moment ago must not be
        // sitting in the box, and neither must its error.
        error.hidden = true;
        input.value = "";
        addButton.disabled = false;

        // The admin's overlay brings the backdrop, Esc and the X with it.
        window.appOpen(modal);
        input.focus();
      }

      function close() {
        window.appClose(modal);
      }

      openButton.addEventListener("click", open);
      cancelButton.addEventListener("click", close);

      // The Add store button sits in the dialog's action slot, outside the
      // form, so it asks the form to submit rather than being its button.
      // Enter in the code box still submits: a form with one text field
      // submits implicitly.
      addButton.addEventListener("click", function () {
        form.requestSubmit();
      });

      /* ---------------- redeem the code ---------------- */

      form.addEventListener("submit", async function (event) {
        event.preventDefault();
        error.hidden = true;

        var code = input.value.trim();

        if (!code) {
          return showError("Enter the source store's code.");
        }

        addButton.disabled = true;

        try {
          var response = await window.appFetch("/stores/connect", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ code: code }),
            busy: addButton
          });

          var data = await response.json().catch(function () { return {}; });

          if (!response.ok) {
            // Left open with the code still typed: the merchant will want to
            // fix a mistyped character, not start again.
            addButton.disabled = false;
            return showError(data.error || "Could not connect.");
          }

          close();
          window.appToast("Connected to " + data.connection.source);
          window.appNavigate("/stores");
        } catch (err) {
          addButton.disabled = false;
          showError("Could not reach the app. Try again.");
        }
      });

      /* ---------------- deleting a source store ---------------- */

      var deleteModal = document.getElementById("delete-store-modal");
      var deleteConfirm = document.getElementById("delete-store-confirm");
      var deleteCancel = document.getElementById("delete-store-cancel");
      var deleteError = document.getElementById("delete-store-error");
      var deleteProgress = document.getElementById("delete-store-progress");
      var owedNotice = document.getElementById("delete-store-owed");

      // Which store the open dialog is about. Read from the row's button, so
      // the dialog is written once rather than once per row.
      var pending = null;

      function plural(count, one, many) {
        return count + " " + (count === 1 ? one : many);
      }

      function openDeleteModal(button) {
        pending = button.dataset;

        var products = Number(pending.products) || 0;
        var orders = Number(pending.orders) || 0;
        var payments = Number(pending.payments) || 0;
        var outstanding = Number(pending.outstanding) || 0;

        deleteModal.setAttribute("heading", "Delete " + pending.store + "?");

        // The headline consequence, stated in the merchant's own terms: these
        // are products sitting in their live Shopify catalogue.
        document.getElementById("delete-store-products").textContent = products
          ? plural(products, "product", "products") +
            " will be permanently deleted from your Shopify store."
          : "This store has not put any products in your Shopify store.";

        document.getElementById("delete-store-line-products").textContent = products
          ? "Delete " + plural(products, "product", "products") +
            " from your catalogue, with their variants, images and inventory."
          : "Remove the link to " + pending.domain + ".";

        document.getElementById("delete-store-line-orders").textContent = orders
          ? "Forget " + plural(orders, "order", "orders") +
            " raised against this supplier."
          : "Leave your orders alone — there are none from this supplier.";

        document.getElementById("delete-store-line-payments").textContent = payments
          ? "Erase " + plural(payments, "recorded payment", "recorded payments") +
            " and this supplier's payout history."
          : "Erase this supplier's payout history.";

        // Money still owed is the one thing a merchant must not discover
        // afterwards, so it gets its own notice rather than a bullet.
        if (outstanding > 0) {
          owedNotice.textContent =
            "You still owe " +
            (pending.currency ? pending.currency + " " : "") +
            outstanding.toFixed(2) +
            " to this supplier. Deleting the store erases the record of it. " +
            "Settle up, or note the figure, before continuing.";
          owedNotice.hidden = false;
        } else {
          owedNotice.hidden = true;
        }

        deleteError.hidden = true;
        deleteProgress.hidden = true;
        deleteConfirm.disabled = false;

        window.appOpen(deleteModal);

        // Focus lands on Cancel, not on the destructive button: a stray Enter
        // must not delete a catalogue.
        deleteCancel.focus();
      }

      function closeDeleteModal() {
        window.appClose(deleteModal);
        pending = null;
      }

      // Closed by Esc or the X, the same as Cancel.
      deleteModal.addEventListener("afterhide", function () {
        pending = null;
      });

      Array.prototype.slice.call(document.querySelectorAll(".delete-store"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            openDeleteModal(button);
          });
        });

      deleteCancel.addEventListener("click", closeDeleteModal);

      deleteConfirm.addEventListener("click", async function () {
        if (!pending) return;

        var connectionId = pending.connection;
        var name = pending.store;

        deleteError.hidden = true;
        deleteProgress.hidden = true;

        // Spinning for the whole run, not per request: between rounds the
        // button must not flick back to clickable.
        window.appBusy(deleteConfirm, true);

        /* Deleting comes back in rounds: a store can hold a thousand products
         * and a thousand Shopify calls do not fit in one request. Keep asking
         * until the server says it is done, showing what is left as it goes --
         * a dialog that sits silent for two minutes reads as a hang. */
        var removed = 0;

        try {
          for (;;) {
            var response = await window.appFetch(
              "/stores/" + connectionId + "/delete",
              { method: "POST" }
            );

            var data = await response.json().catch(function () { return {}; });

            if (!response.ok) {
              window.appBusy(deleteConfirm, false);
              deleteError.textContent = data.error || "Could not delete that store.";
              deleteError.hidden = false;
              return;
            }

            removed += data.deleted || 0;

            if (data.done) break;

            // Nothing moved and something refused: going round again would
            // fail the same way. Stop and say why, with the store still there.
            if (!data.deleted) {
              window.appBusy(deleteConfirm, false);
              deleteError.textContent =
                (data.error ||
                  "Some products could not be deleted from your store.") +
                " Removed " + removed + " so far; " + data.remaining +
                " left. The store has been kept so you can try again.";
              deleteError.hidden = false;
              return;
            }

            deleteProgress.textContent =
              "Deleting… " + data.remaining + " left.";
            deleteProgress.hidden = false;
          }

          window.appBusy(deleteConfirm, false);
          closeDeleteModal();
          window.appToast(
            "Deleted " + name + " and " + plural(removed, "product", "products")
          );
          window.appNavigate("/stores");
        } catch (err) {
          window.appBusy(deleteConfirm, false);
          deleteError.textContent = "Could not reach the app. Try again.";
          deleteError.hidden = false;
        }
      });

      /* ---------------- resuming a paused source store ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".resume-store"))
        .forEach(function (button) {
          button.addEventListener("click", async function () {
            var label = button.textContent;
            button.disabled = true;
            button.textContent = "Resuming…";

            try {
              var response = await window.appFetch(
                "/stores/" + button.dataset.connection + "/resume",
                { method: "POST", busy: button }
              );

              var data = await response.json().catch(function () { return {}; });

              if (!response.ok) {
                // Most often the plan's source-store limit, and the message
                // says so and points at the fix.
                window.appToast(data.error || "Could not resume that store.", true);
                button.disabled = false;
                button.textContent = label;
                return;
              }

              window.appToast("Resumed " + button.dataset.store);
              window.appNavigate("/stores");
            } catch (err) {
              window.appToast("Could not reach the app. Try again.", true);
              button.disabled = false;
              button.textContent = label;
            }
          });
        });
    })();
  </script>

</body>

</html>
