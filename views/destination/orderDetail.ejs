<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head") %>
  <title><%= order.destination_order_name || "Order" %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>

  <%- include("../partials/nav") %>

  <main class="shell">

    <header class="shell__header">
      <div>
        <button class="link link--back" type="button" id="back">&larr; Orders</button>
        <h1>
          <a class="record-link"
             href="<%= shopifyAdminUrl(order.destination_shop_domain, 'orders', order.destination_shopify_order_id) %>"
             target="_blank" rel="noopener noreferrer"><%= order.destination_order_name || ("#" + order.destination_shopify_order_id) %></a>
        </h1>
        <p class="shell__sub">
          Sold by
          <strong><%= order.destination_store_name || order.destination_shop_domain %></strong>,
          supplied by
          <strong><%= order.source_store_name || order.source_shop_domain %></strong>
        </p>
      </div>
      <span class="pill pill--<%=
        order.source_fulfillment_status === "fulfilled" ? "synced"
        : order.source_fulfillment_status === "cancelled" ? "failed" : "pending" %>">
        <%= order.source_fulfillment_status === "unfulfilled"
            ? "awaiting supplier" : order.source_fulfillment_status %>
      </span>
    </header>

    <% if (order.cancel_status === "failed" && order.cancel_error) { %>
      <p class="notice notice--error">
        The supplier cannot supply this, but your order could not be cancelled
        automatically &mdash; <%= order.cancel_error %>
      </p>
    <% } %>

    <section class="panel">
      <h2 class="panel__title">What was bought</h2>

      <p class="panel__copy">
        <%# The whole point of the two price columns. Saying it once here is
            cheaper than a merchant working it out from the numbers. %>
        The source store is charged its own price for each line. The margin
        between the two columns is yours, set under
        <s-link href="/settings">Settings</s-link>.
      </p>

      <%# The table keeps its columns when it is empty and says so in a row of
          its own: a table that vanishes reads as a screen that failed. %>
      <table class="table">
        <thead>
          <tr>
            <th>Product</th>
            <th>SKU</th>
            <th>Qty</th>
            <th>Source price</th>
            <th>Customer paid</th>
            <th>Source total</th>
          </tr>
        </thead>
        <tbody>
          <% var sourceTotal = 0; var paidTotal = 0; %>
          <% if (!lines.length) { %>
            <tr class="row--empty">
              <td class="table__empty" colspan="6">
                <strong>No records found</strong>
                <span>
                  None of the products on this order are synced from this source any
                  more, so there is nothing left to charge for.
                </span>
              </td>
            </tr>
          <% } else { %>
          <% lines.forEach(function (line) { %>
            <%
              var lineSource = (line.source_price || 0) * line.quantity;
              var linePaid = (line.destination_price || 0) * line.quantity;
              sourceTotal += lineSource;
              paidTotal += linePaid;
            %>
            <tr>
              <td>
                <span class="media__body">
                  <% if (line.destination_shopify_product_id) { %>
                    <a class="table__title record-link"
                       href="<%= shopifyAdminUrl(order.destination_shop_domain, 'products', line.destination_shopify_product_id) %>"
                       target="_blank" rel="noopener noreferrer"><%= line.source_product_title || line.title %></a>
                  <% } else { %>
                    <span class="table__title"><%= line.source_product_title || line.title %></span>
                  <% } %>
                  <% if (line.source_variant_title) { %>
                    <span class="muted"><%= line.source_variant_title %></span>
                  <% } %>
                </span>
              </td>
              <td class="muted"><%= line.source_sku || line.destination_sku || "—" %></td>
              <td><%= line.quantity %></td>
              <td>
                <%= order.currency %>
                <%= line.source_price === null ? "—" : line.source_price.toFixed(2) %>
              </td>
              <td class="muted">
                <%= order.currency %>
                <%= line.destination_price === null ? "—" : line.destination_price.toFixed(2) %>
              </td>
              <td><strong><%= order.currency %> <%= lineSource.toFixed(2) %></strong></td>
            </tr>
          <% }); %>
          <% } %>
        </tbody>
        <%# Nothing to total when there are no lines. %>
        <% if (lines.length) { %>
        <tfoot>
          <tr>
            <td colspan="3"></td>
            <td class="muted">Totals</td>
            <td class="muted"><%= order.currency %> <%= paidTotal.toFixed(2) %></td>
            <td><strong><%= order.currency %> <%= sourceTotal.toFixed(2) %></strong></td>
          </tr>
        </tfoot>
        <% } %>
      </table>
    </section>

    <section class="panel">
      <h2 class="panel__title">Order</h2>
      <dl class="facts">
        <div class="facts__row">
          <dt>Sale</dt>
          <dd>
            <a class="record-link"
               href="<%= shopifyAdminUrl(order.destination_shop_domain, 'orders', order.destination_shopify_order_id) %>"
               target="_blank" rel="noopener noreferrer"><%= order.destination_order_name || ("#" + order.destination_shopify_order_id) %></a>
          </dd>
        </div>
        <div class="facts__row">
          <dt>Payment</dt>
          <dd><%= order.financial_status || "—" %></dd>
        </div>
        <div class="facts__row">
          <dt>Fulfillment</dt>
          <dd><%= order.fulfillment_status || "unfulfilled" %></dd>
        </div>

        <%# What the supplier has done. They set it on their own Orders screen
            in this app; nothing here touches your Shopify order, except the
            cancellation below. %>
        <div class="facts__row">
          <dt>Supplier</dt>
          <dd>
            <% if (order.source_cancelled_at) { %>
              cancelled<%= order.source_cancel_reason ? ` (${order.source_cancel_reason})` : "" %>
            <% } else { %>
              <%= order.source_fulfillment_status || "unfulfilled" %>
              <% if (order.source_status_at) { %>
                <span class="muted">
                  as of <%= new Date(order.source_status_at).toISOString().slice(0, 16).replace("T", " ") %> UTC
                </span>
              <% } %>
            <% } %>
          </dd>
        </div>

        <% if (order.source_tracking.length) { %>
          <div class="facts__row">
            <dt>Tracking</dt>
            <dd>
              <%# One row per parcel: an order can ship in several boxes, and
                  the shopper needs every number, not the first one. %>
              <% order.source_tracking.forEach(function (parcel) { %>
                <div>
                  <%= parcel.company || "Tracking" %>: <strong><%= parcel.number %></strong>
                  <% if (parcel.url) { %>
                    <a class="link" href="<%= parcel.url %>" target="_blank" rel="noopener">track</a>
                  <% } %>
                </div>
              <% }); %>
            </dd>
          </div>
        <% } %>

        <% if (order.source_cancelled_at) { %>
          <div class="facts__row">
            <dt>Your order</dt>
            <dd>
              <%# The one thing the source can do that reaches into this store.
                  It is spelled out because it moves the shopper's money. %>
              <% if (order.cancel_status === "cancelled") { %>
                cancelled and refunded, because the source cancelled theirs
              <% } else if (order.cancel_status === "failed") { %>
                could not be cancelled &mdash; <%= order.cancel_error %>
              <% } else { %>
                being cancelled and refunded&hellip;
              <% } %>
            </dd>
          </div>
        <% } %>

        <% if (order.cancelled_at) { %>
          <div class="facts__row">
            <dt>Cancelled here</dt>
            <%# Cancelling YOUR sale does NOT cancel the order at the source.
                That needs a decision about refunds, so it is left to a human. %>
            <dd>yes &mdash; the source order was not cancelled automatically</dd>
          </div>
        <% } %>
      </dl>
    </section>

  </main>

  <script>
    document.getElementById("back").addEventListener("click", function () {
      window.appNavigate("/orders");
    });
  </script>

</body>

</html>
