<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head") %>
  <title>Orders</title>
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>

  <%- include("../partials/nav") %>

  <main class="shell shell--wide">

    <header class="shell__header">
      <div>
        <h1>Orders</h1>
        <p class="shell__sub">
          Your sales, and what the store that supplies each one has done about it.
        </p>
      </div>
    </header>

    <%# The same two tabs the SOURCE sees, so the two merchants are looking at
        the same list in the same order when they talk to each other. %>
    <nav class="tabs">
      <button
        class="tabs__tab<%= tab === "open" ? " tabs__tab--on" : "" %>"
        type="button" data-tab="open">
        Awaiting supplier (<%= counts.open %>)
      </button>
      <button
        class="tabs__tab<%= tab === "done" ? " tabs__tab--on" : "" %>"
        type="button" data-tab="done">
        Done (<%= counts.done %>)
      </button>
    </nav>

    <section class="panel">

      <%# The table keeps its columns when it is empty and says so in a row of
          its own: a table that vanishes reads as a screen that failed. %>
      <table class="table">
        <thead>
          <tr>
            <th>Order</th>
            <th>Source store</th>
            <th>Items</th>
            <%# Both totals, side by side: the difference between them IS the
                markup, and this is the only screen that shows it. This store's
                own money comes first. %>
            <th>Customer paid</th>
            <th>Source price</th>
            <%# The source is the store that actually ships, so this column is
                the only real answer to "where is my order?". %>
            <th>Supplier status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (!orders.length) { %>
            <tr class="row--empty">
              <td class="table__empty" colspan="7">
                <strong>No records found</strong>
                <span>
                  <% if (tab === "open") { %>
                    Nothing outstanding. Every sale so far has been dealt with.
                  <% } else { %>
                    No orders yet. When someone buys a synced product from your store,
                    the order raised at its source store appears here.
                  <% } %>
                </span>
              </td>
            </tr>
          <% } else { %>
          <% orders.forEach(function (order) { %>
            <tr>
              <td>
                <%# Just the sale's own number. The source order number is on
                    the detail page; here the Status column already says
                    whether it has been placed. %>
                <span class="table__title">
                  <%= order.destination_order_name || ("#" + order.destination_shopify_order_id) %>
                </span>
              </td>
              <td>
                <%= order.source_store_name || order.source_shop_domain %>
              </td>
              <td><%= order.line_count %></td>

              <td>
                <strong>
                  <%= order.currency %>
                  <%= order.destination_total === null ? "—" : order.destination_total.toFixed(2) %>
                </strong>
              </td>
              <td class="muted">
                <%= order.currency %>
                <%= order.source_total === null ? "—" : order.source_total.toFixed(2) %>
              </td>

              <td>
                <%# Set by the source on its own Orders screen. This app never
                    writes it, and never touches your Shopify order -- except
                    to cancel it, which is the one case below. %>
                <% if (order.source_fulfillment_status === "cancelled") { %>
                  <span class="pill pill--failed">supplier cannot supply</span>
                  <% if (order.cancel_status === "cancelled") { %>
                    <span class="muted">your order was cancelled and refunded</span>
                  <% } else if (order.cancel_status === "failed") { %>
                    <span class="muted"><%= order.cancel_error %></span>
                  <% } else { %>
                    <span class="muted">cancelling your order&hellip;</span>
                  <% } %>
                <% } else if (order.source_fulfillment_status === "fulfilled") { %>
                  <span class="pill pill--synced">fulfilled</span>
                  <%# Tracking and whether your own Shopify order has been
                      updated are per shipment now, on the order's own page. %>
                <% } else if (order.source_fulfillment_status === "partial") { %>
                  <%# The supplier has sent some of it. Your Shopify order is
                      fulfilled for those lines only; the rest is still coming. %>
                  <span class="pill pill--paused">partially fulfilled</span>
                  <span class="muted">more to come</span>
                <% } else { %>
                  <span class="pill pill--pending">unfulfilled</span>
                <% } %>
              </td>

              <td class="table__actions">
                <button
                  class="btn btn--small view-order"
                  type="button"
                  data-order="<%= order.id %>">
                  View
                </button>
                <%# No action here: the supplier does the work, and cancelling
                    is theirs to decide. This screen is a window onto it. %>
              </td>
            </tr>
          <% }); %>
          <% } %>
        </tbody>
      </table>

      <%- include("../partials/pager", { pager: pager, noun: "orders" }) %>
    </section>

  </main>

  <script>
    (function () {
      /* ---------------- tabs ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".tabs__tab"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            // A real navigation, not a class toggle: the two tabs hold
            // different rows and the server decides which.
            window.appNavigate("/orders?tab=" + button.dataset.tab);
          });
        });

      /* ---------------- view one order ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".view-order"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            window.appNavigate("/orders/" + button.dataset.order);
          });
        });

    })();
  </script>

</body>

</html>
