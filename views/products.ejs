<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("partials/head") %>
  <title>Products</title>
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>

  <%- include("partials/nav") %>

  <main class="shell shell--wide">

    <header class="shell__header">
      <div>
        <h1>Products</h1>
        <p class="shell__sub">
          <% if (isSource) { %>
            Products staged here, and which of them go out to your destination stores.
          <% } else { %>
            Products synced into this store, and where each one came from.
          <% } %>
        </p>
      </div>

      <div class="shell__actions">
        <% if (isSource) { %>
          <%# No sync button here on purpose: the source offers products, the
              destination decides when to pull them in. %>
          <button class="btn btn--primary" type="button" id="add-button">+ Add products</button>
        <% } else if (connections.length) { %>
          <%# Updates to products already accepted -- nothing new is added. %>
          <button class="btn" type="button" id="sync-button">Sync now</button>
        <% } %>
      </div>
    </header>

    <p class="notice notice--error" id="page-error" hidden></p>

    <% if (isSource && !activeConnections.length) { %>
      <p class="notice notice--warn">
        No destination store is connected yet, so nothing can be pushed. Connect
        one from <s-link href="/stores">Stores</s-link> first &mdash; you can
        still add products to the table in the meantime.
      </p>
    <% } %>

    <%# Only the source gets a whole-screen empty state. A destination always
        shows its tabs, because "nothing here" on one of them is itself the
        answer and the other tab may still have something. %>
        <% if (isSource && !counts.shared && !counts.unshared) { %>


      <section class="empty">
        <h2>No products yet</h2>
        <p>
          Use <strong>Add products</strong> to pull products in from this
          store's Shopify catalogue. Nothing is sent anywhere until you allow
          it.
        </p>
      </section>

    <% } else if (isSource) { %>
            <nav class="tabs">
        <button
          class="tabs__tab<%= tab === "shared" ? " tabs__tab--on" : "" %>"
          type="button" data-tab="shared">
          Shared (<%= counts.shared %>)
        </button>
        <button
          class="tabs__tab<%= tab === "unshared" ? " tabs__tab--on" : "" %>"
          type="button" data-tab="unshared">
          Unshared (<%= counts.unshared %>)
        </button>
      </nav>


      <section class="panel">
        <% if (tab === "unshared" && products.length) { %>
        <div class="panel__header">
          <h2 class="panel__title"><%= products.length %> product<%= products.length === 1 ? "" : "s" %></h2>
          <div class="panel__add">
            <button class="btn btn--small" type="button" id="allow-button" disabled>
              Allow selected
            </button>
          </div>
        </div>
         <% } %>

        <% if (!products.length) { %>

          <p class="panel__copy">
            <%= tab === "unshared"
                ? "Everything staged here is already shared. Use Add products to bring in more."
                : "Nothing shared yet. Tick a product on the Unshared tab and press Allow selected." %>
          </p>

        <% } else { %>

        <table class="table">
          <thead>
            <tr>
              <%# Nothing to tick on the Shared tab: those are already out. %>
              <% if (tab === "unshared") { %>
                <th class="table__check">
                  <input type="checkbox" id="check-all" aria-label="Select all">
                </th>
              <% } %>
              <th>Product</th>
              <th>Variants</th>
              <th>Status</th>
              <th>Shared</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(function (product) { %>
              <tr>
                <% if (tab === "unshared") { %>
                  <td class="table__check">
                    <input
                      type="checkbox"
                      class="row-check"
                      value="<%= product.id %>"
                      aria-label="Select <%= product.title %>">
                  </td>
                <% } %>
                <td>
                  <span class="media">
                    <% if (product.image_url) { %>
                      <img class="media__thumb" src="<%= product.image_url %>"
                           alt="" loading="lazy" width="40" height="40">
                    <% } else { %>
                      <span class="media__thumb media__thumb--empty" aria-hidden="true"></span>
                    <% } %>
                    <span class="media__body">
                      <span class="table__title"><%= product.title %></span>
                      <% if (product.vendor) { %>
                        <span class="muted"><%= product.vendor %></span>
                      <% } %>
                    </span>
                  </span>
                </td>
                <td>
                  <%# Just the count here; the variants themselves live on the
                      product's own page, behind View. %>
                  <%= product.variants.length %>
                  <% if (product.variants.length < product.variant_count) { %>
                    <span class="muted">of <%= product.variant_count %></span>
                  <% } %>
                </td>
                <td><span class="muted"><%= product.status || "—" %></span></td>
                <td>
                  <% if (!product.allowed) { %>
                    <span class="muted">Not shared</span>
                  <% } else { %>
                    <% if (product.synced) { %>
                      <span class="pill pill--active"><%= product.synced %> synced</span>
                    <% } %>
                    <% if (product.awaiting) { %>
                      <%# Offered, but the destination has not ticked it yet --
                          nothing the source can do about it. %>
                      <span class="pill"><%= product.awaiting %> awaiting them</span>
                    <% } %>
                    <% if (product.pending) { %>
                      <span class="pill pill--paused"><%= product.pending %> pending</span>
                    <% } %>
                    <% if (product.failed) { %>
                      <span class="pill pill--failed" title="<%= product.error_message || "" %>">
                        <%= product.failed %> failed
                      </span>
                    <% } %>
                  <% } %>
                </td>
                <td class="table__actions">
                  <button
                    class="btn btn--small view-product"
                    type="button"
                    data-product="<%= product.id %>">
                    View
                  </button>
                  <button
                    class="btn btn--small btn--danger delete-product"
                    type="button"
                    data-product="<%= product.id %>"
                    data-title="<%= product.title %>"
                    data-synced="<%= product.synced %>">
                    Delete
                  </button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <% } %>
      </section>

    <% } else { %>

      <%# One table, two tabs. "Unsynced" is what a source has offered and this
          store has not accepted; nothing of it has been written here yet. %>
      <nav class="tabs">
        <button
          class="tabs__tab<%= tab === "synced" ? " tabs__tab--on" : "" %>"
          type="button" data-tab="synced">
          Synced (<%= counts.synced %>)
        </button>
        <button
          class="tabs__tab<%= tab === "unsynced" ? " tabs__tab--on" : "" %>"
          type="button" data-tab="unsynced">
          Unsynced (<%= counts.unsynced %>)
        </button>
      </nav>

      <section class="panel">

        <%# Only when there is something to act on: buttons over an empty list
            are just dead controls. %>
        <% if (tab === "unsynced" && products.length) { %>
          <div class="panel__header">
            <p class="panel__copy">
              A source store has offered these. Tick the ones you want and press
              <strong>Sync selected</strong> &mdash; nothing is added to your
              store until you do.
            </p>
            <div class="panel__add">
              <button class="btn btn--small" type="button" id="decline-button" disabled>
                Decline
              </button>
              <button class="btn btn--primary btn--small" type="button" id="accept-button" disabled>
                Sync selected
              </button>
            </div>
          </div>
        <% } %>

        <% if (!products.length) { %>

          <p class="panel__copy">
            <%= tab === "unsynced"
                ? "Nothing is waiting for you. When a source store offers a product it appears here."
                : "Nothing synced yet. Check the Unsynced tab for anything waiting." %>
          </p>

        <% } else { %>

        <table class="table">
          <thead>
            <tr>
              <% if (tab === "unsynced") { %>
                <th class="table__check">
                  <input type="checkbox" id="check-all-awaiting" aria-label="Select all">
                </th>
              <% } %>
              <th>Product</th>
              <th>Source store</th>
              <th>Inventory</th>
              <th>Total variants</th>
              <th>Status</th>
              <th>Actions</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(function (product) { %>
              <tr>
                <% if (tab === "unsynced") { %>
                  <td class="table__check">
                    <input
                      type="checkbox"
                      class="awaiting-check"
                      value="<%= product.mapping_id %>"
                      aria-label="Accept <%= product.title %>">
                  </td>
                <% } %>
                <td>
                  <span class="media">
                    <% if (product.image_url) { %>
                      <img class="media__thumb" src="<%= product.image_url %>"
                           alt="" loading="lazy" width="40" height="40">
                    <% } else { %>
                      <span class="media__thumb media__thumb--empty" aria-hidden="true"></span>
                    <% } %>
                    <span class="media__body">
                      <span class="table__title"><%= product.title %></span>
                      <span class="muted">
                        <%# The product's own state at the source. It used to
                            sit under Status, which now means the sync. %>
                        <%= (product.status || "").toUpperCase() || "—" %>
                        <% if (product.vendor) { %>&middot; <%= product.vendor %><% } %>
                      </span>
                    </span>
                  </span>
                </td>
                <td>
                  <%# The point of this screen: which store sent it. %>
                  <%= product.source_store_name || product.source_shop_domain %>
                </td>
                <td>
                  <%# Red at zero: a product with no stock will sync but sell
                      nothing, and that is worth noticing before accepting. %>
                  <span class="<%= product.inventory ? "" : "stock--none" %>">
                    <%= product.inventory %> in stock
                  </span>
                </td>
                <td><%= product.offered_variant_count %></td>
                <td>
                  <%# Clicking the status is what changes it: syncing one
                      product is a single decision, and ticking a box then
                      reaching for a button makes two steps of it.

                      'deleted' is the exception -- the product is gone at the
                      source, so there is nothing to sync back. %>
                  <% if (product.sync_status === "deleted") { %>
                    <span class="pill pill--failed">deleted</span>
                  <% } else if (tab === "unsynced") { %>
                    <button
                      class="pill pill--pending pill--action status-toggle"
                      type="button"
                      data-mapping="<%= product.mapping_id %>"
                      data-action="sync"
                      title="Sync into this store">
                      unsynced
                    </button>
                  <% } else { %>
                    <button
                      class="pill pill--<%= product.sync_status %> pill--action status-toggle"
                      type="button"
                      data-mapping="<%= product.mapping_id %>"
                      data-action="unsync"
                      title="Stop syncing &mdash; moves back to Unsynced">
                      <%= product.sync_status %>
                    </button>
                    <% if (product.sync_status === "failed" && product.error_message) { %>
                      <span class="muted"><%= product.error_message %></span>
                    <% } %>
                  <% } %>
                </td>
                <td class="table__actions">
                  <button
                    class="btn btn--small view-product"
                    type="button"
                    data-product="<%= product.mapping_id %>">
                    View
                  </button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <% } %>
      </section>

    <% } %>

  </main>

  <%# The two roles get different controls, so each is sent only its own. %>
  <% if (isSource) { %>
  <script>
    (function () {
      var pageError = document.getElementById("page-error");

      function fail(node, message) {
        node.textContent = message;
        node.hidden = false;
      }

      async function post(url, body) {
        var response = await window.appFetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body || {})
        });
        var data = await response.json().catch(function () { return {}; });
        if (!response.ok) throw new Error(data.error || "Request failed");
        return data;
      }

      /* ---------------- the table: allow selected ---------------- */

      var allowButton = document.getElementById("allow-button");
      var checkAll = document.getElementById("check-all");

      function rowChecks() {
        return Array.prototype.slice.call(document.querySelectorAll(".row-check"));
      }

      /**
       * One entry per ticked product, always offering EVERY variant.
       *
       * variant_ids is null on purpose: the table shares whole products, and
       * dropping individual variants happens on the product's own page. The
       * server keeps any narrowing already made rather than overwriting it.
       */
      function selections() {
        return rowChecks()
          .filter(function (c) { return c.checked; })
          .map(function (c) {
            return { source_product_id: c.value, variant_ids: null };
          });
      }

      function refreshAllowButton() {
        if (!allowButton) return;

        var count = selections().length;
        allowButton.disabled = count === 0;
        allowButton.textContent = count
          ? "Allow " + count + " selected"
          : "Allow selected";
      }

      rowChecks().forEach(function (check) {
        check.addEventListener("change", refreshAllowButton);
      });

      if (checkAll) {
        checkAll.addEventListener("change", function () {
          rowChecks().forEach(function (c) { c.checked = checkAll.checked; });
          refreshAllowButton();
        });
      }

      if (allowButton) {
        allowButton.addEventListener("click", async function () {
          pageError.hidden = true;
          allowButton.disabled = true;

          try {
            var data = await post("/products/allow", { selections: selections() });
            window.appToast("Allowed on " + data.destinations + " destination store(s)");
            // They have moved to the other tab, so follow them there.
            window.appNavigate("/products?tab=shared");
          } catch (err) {
            allowButton.disabled = false;
            fail(pageError, err.message);
          }
        });
      }

      /** "gid://shopify/Product/900" -> "900" */
      function numericId(gid) {
        return String(gid).split("/").pop();
      }

      /* ---------------- tabs ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".tabs__tab"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            // A real navigation, not a class toggle: the two tabs hold
            // different rows and the server decides which ones.
            window.appNavigate("/products?tab=" + button.dataset.tab);
          });
        });

      /* ---------------- row actions: view / delete ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".view-product"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            window.appNavigate("/products/" + button.dataset.product);
          });
        });

      Array.prototype.slice.call(document.querySelectorAll(".delete-product"))
        .forEach(function (button) {
          button.addEventListener("click", async function () {
            var synced = Number(button.dataset.synced) || 0;

            // This removes the product from OTHER merchants' stores, so say so
            // in as many words before doing it.
            if (!window.confirm(
              'Delete "' + button.dataset.title + '"?\n\n' +
              (synced
                ? "It will be PERMANENTLY DELETED from " + synced +
                  " destination store(s), along with its variants and images.\n\n"
                : "") +
              "It will also be removed from this list. This cannot be undone."
            )) return;

            pageError.hidden = true;
            button.disabled = true;
            button.textContent = "Deleting…";

            try {
              var data = await post("/products/" + button.dataset.product + "/delete");
              window.appToast("Deleted from " + data.deleted + " store(s)");
              window.appNavigate("/products");
            } catch (err) {
              button.disabled = false;
              button.textContent = "Delete";
              fail(pageError, err.message);
            }
          });
        });

      /* ---------------- add products (App Bridge resource picker) ---------------- */

      var addButton = document.getElementById("add-button");

      if (!addButton) return;

      addButton.addEventListener("click", async function () {
        pageError.hidden = true;

        // The picker is provided by the admin, so it only exists when the app
        // is actually embedded in it.
        if (!window.shopify || typeof window.shopify.resourcePicker !== "function") {
          return fail(
            pageError,
            "Open this app from your Shopify admin to add products."
          );
        }

        var selected;

        try {
          // "product", not "variant": this picker groups variants under their
          // product with names, images and search. The variant picker renders
          // a flat list with none of that.
          //
          // Deliberately NOT pre-ticked with what is already staged. Doing so
          // made the picker hand every staged product back on every Add, and
          // the server then re-imported the whole catalogue to add one thing.
          // Opening blank means only what the merchant just picked is sent.
          selected = await window.shopify.resourcePicker({
            type: "product",
            multiple: true,
            action: "add",
            // Drafts are allowed through: they sync to the destination as
            // drafts too. An archived product has nothing useful to copy.
            filter: { archived: false }
          });
        } catch (error) {
          return fail(pageError, "The product picker could not open.");
        }

        // undefined means the merchant closed it -- a choice, not a failure.
        if (!selected || !selected.length) return;

        addButton.disabled = true;
        addButton.textContent = "Adding…";

        try {
          // Only ids are sent -- the product's, and whichever of its variants
          // were ticked. The server re-reads everything else from Shopify, so
          // nothing the browser says about a title or a price is trusted.
          var data = await post("/products/import", {
            products: selected.map(function (product) {
              return {
                id: numericId(product.id),
                variant_ids: (product.variants || []).map(function (variant) {
                  return numericId(variant.id);
                })
              };
            })
          });

          window.appToast("Added " + data.imported + " product(s)");
          window.appNavigate("/products");
        } catch (err) {
          addButton.disabled = false;
          addButton.textContent = "+ Add products";
          fail(pageError, err.message);
        }
      });
    })();
  </script>
  <% } else { %>
  <script>
    (function () {
      var acceptButton = document.getElementById("accept-button");
      var syncButton = document.getElementById("sync-button");
      var declineButton = document.getElementById("decline-button");
      var checkAll = document.getElementById("check-all-awaiting");
      var pageError = document.getElementById("page-error");

      function fail(message) {
        pageError.textContent = message;
        pageError.hidden = false;
      }

      /* ---------------- tabs ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".tabs__tab"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            // A real navigation, not a class toggle: the two tabs hold
            // different rows and the server decides which ones.
            window.appNavigate("/products?tab=" + button.dataset.tab);
          });
        });

      /* ---------------- view one product ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".view-product"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            window.appNavigate("/products/" + button.dataset.product);
          });
        });

      /* ---------------- refresh what is already accepted ---------------- */

      if (syncButton) {
        syncButton.addEventListener("click", async function () {
          pageError.hidden = true;
          syncButton.disabled = true;
          syncButton.textContent = "Syncing…";

          try {
            var response = await window.appFetch("/products/sync", { method: "POST" });
            var data = await response.json().catch(function () { return {}; });

            if (!response.ok) throw new Error(data.error || "Request failed");

            window.appToast(data.synced + " updated, " + data.failed + " failed");
            window.appNavigate("/products");
          } catch (err) {
            syncButton.disabled = false;
            syncButton.textContent = "Sync now";
            fail(err.message);
          }
        });
      }

      /* ---------------- the status pill, as a switch ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".status-toggle"))
        .forEach(function (pill) {
          pill.addEventListener("click", async function () {
            var unsync = pill.dataset.action === "unsync";

            // Syncing writes to the store, so it needs no warning; stopping
            // one does, because the merchant is giving up future updates.
            if (unsync && !window.confirm(
              "Stop syncing this product?\n\n" +
              "It moves back to Unsynced. What is already in your store stays, " +
              "it just will not be updated any more."
            )) return;

            pageError.hidden = true;
            pill.disabled = true;
            pill.textContent = unsync ? "stopping…" : "syncing…";

            try {
              var response = await window.appFetch(
                unsync ? "/products/decline" : "/products/accept",
                {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ mapping_ids: [pill.dataset.mapping] })
                }
              );

              var data = await response.json().catch(function () { return {}; });

              if (!response.ok) throw new Error(data.error || "Request failed");

              window.appToast(unsync ? "Moved to Unsynced" : "Synced");
              // The row belongs on the other tab now, so go and show it there.
              window.appNavigate("/products?tab=" + (unsync ? "unsynced" : "synced"));
            } catch (err) {
              pill.disabled = false;
              pill.textContent = pill.dataset.was;
              fail(err.message);
            }
          });

          // Remembered before any click, so a failure can put the word back.
          pill.dataset.was = pill.textContent.trim();
        });

      /* ---------------- accept what is on offer ---------------- */

      // Nothing offered: the rest of this page is a read-only list.
      if (!acceptButton) return;

      function checks() {
        return Array.prototype.slice.call(
          document.querySelectorAll(".awaiting-check")
        );
      }

      function chosen() {
        return checks()
          .filter(function (c) { return c.checked; })
          .map(function (c) { return c.value; });
      }

      function refresh() {
        var count = chosen().length;
        acceptButton.disabled = count === 0;
        declineButton.disabled = count === 0;
        acceptButton.textContent = count
          ? "Sync " + count + " selected"
          : "Sync selected";
      }

      checks().forEach(function (check) {
        check.addEventListener("change", refresh);
      });

      if (checkAll) {
        checkAll.addEventListener("change", function () {
          checks().forEach(function (c) { c.checked = checkAll.checked; });
          refresh();
        });
      }

      async function send(url, label) {
        pageError.hidden = true;
        acceptButton.disabled = true;
        declineButton.disabled = true;
        acceptButton.textContent = label;

        try {
          var response = await window.appFetch(url, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ mapping_ids: chosen() })
          });

          var data = await response.json().catch(function () { return {}; });

          if (!response.ok) throw new Error(data.error || "Request failed");

          return data;
        } catch (err) {
          refresh();
          fail(err.message);
          return null;
        }
      }

      acceptButton.addEventListener("click", async function () {
        // Accepting also pulls the products in, so this can take a moment.
        var data = await send("/products/accept", "Syncing…");

        if (!data) return;

        window.appToast(data.synced + " synced, " + data.failed + " failed");
        // They are synced now, so show them where they landed.
        window.appNavigate("/products?tab=synced");
      });

      declineButton.addEventListener("click", async function () {
        if (!window.confirm(
          "Stop receiving " + chosen().length + " product(s)?\n\n" +
          "Anything already in your store stays; it just will not be updated."
        )) return;

        var data = await send("/products/decline", "Declining…");

        if (!data) return;

        window.appToast("Declined " + data.declined + " product(s)");
        window.appNavigate("/products");
      });
    })();
  </script>
  <% } %>

</body>

</html>
