<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head") %>
  <title><%= product.title %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>

  <%- include("../partials/nav") %>

  <main class="shell">

    <header class="shell__header">
      <div>
        <button class="back-btn" type="button" id="back"><span class="back-btn__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></span>Products</button>
        <h1>
          <a class="record-link"
             href="<%= shopifyAdminUrl(shop, 'products', product.shopify_product_id) %>"
             target="_blank" rel="noopener noreferrer"><%= product.title %></a>
        </h1>
        <p class="shell__sub">
          <%= shared.length %> of <%= totalVariants %>
          variant<%= totalVariants === 1 ? "" : "s" %> shared
          <% if (product.vendor) { %> &mdash; <%= product.vendor %><% } %>
        </p>
      </div>
    </header>

    <p class="notice notice--error" id="page-error" hidden></p>

    <!-- <% if (!isShared) { %>
      <p class="notice notice--warn">
        These are the variants you picked when you added this product. Nothing
        has been offered to a destination store yet &mdash; tick the product on
        the Products list and press <strong>Allow selected</strong> when you are
        happy with this list.
      </p>
    <% } %> -->

    <!-- <section class="panel">
      <h2 class="panel__title">Variants going to your destination stores</h2> -->

        <!-- <p class="panel__copy">
          Delete a variant to stop sending it. The destination store keeps
          whatever it already has until the next sync, which then removes it
          there too.
        </p> -->

        <%
          var inventoryDestinations = typeof allocationDestinations !== "undefined"
            ? allocationDestinations
            : [];
          var inlineDestination = inventoryDestinations.length === 1
            ? inventoryDestinations[0]
            : null;
          var inlineDestinationName = inlineDestination
            ? (inlineDestination.connection.destination.store_name ||
              inlineDestination.connection.destination.shop_domain)
            : "";
          var inlineInventoryEnabled = inlineDestination
            ? inlineDestination.inventoryEnabled !== false
            : false;
        %>

        <%# The table keeps its columns when it is empty and says so in a row
            of its own: a table that vanishes reads as a screen that failed. %>
        <table class="table">
          <thead>
            <tr>
              <th>Variant</th>
              <th>SKU</th>
              <th>Price</th>
              <th>Source stock</th>
              <% if (inlineDestination) { %>
                <th class="allocation-column">
                  Allocate
                  <span class="allocation-store"><%= inlineDestinationName %></span>
                </th>
              <% } %>
              <th class="table__actions-head">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!shared.length) { %>
              <tr class="row--empty">
                <td class="table__empty" colspan="<%= inlineDestination ? 6 : 5 %>">
                  <strong>No records found</strong>
                </td>
              </tr>
            <% } else { %>
            <% shared.forEach(function (variant) {
              var name = [variant.option1, variant.option2, variant.option3]
                .filter(Boolean).join(" / ") || variant.title;
              var inlineAllocation = inlineDestination
                ? inlineDestination.allocations.get(Number(variant.id))
                : null;
              var inlineAllocated = inlineAllocation
                ? Number(inlineAllocation.allocated_quantity || 0)
                : 0;
              var inlineSold = inlineAllocation
                ? Number(inlineAllocation.sold_quantity || 0)
                : 0;
              var inlineRemaining = inlineAllocation
                ? Number(inlineAllocation.remaining_quantity || 0)
                : 0;
              var sourceAvailable = Number(variant.inventory_quantity);
              var inlineMax = inlineAllocated +
                (Number.isFinite(sourceAvailable) ? Math.max(sourceAvailable, 0) : 0);
            %>
              <tr>
                <td>
                  <span class="table__title">
                    <%# Shopify calls a single default variant "Default Title",
                        which means nothing to a merchant. %>
                    <%= name === "Default Title" ? "Single variant" : (name || "—") %>
                  </span>
                </td>
                <td>
                  <% if (variant.sku) { %>
                    <span class="variants__sku"><%= variant.sku %></span>
                  <% } else { %>
                    <span class="muted">—</span>
                  <% } %>
                </td>
                <td>
                  <%= variant.price === null || variant.price === undefined ? "—" : variant.price %>
                </td>
                <td class="muted">
                  <%= variant.inventory_quantity === null ||
                      variant.inventory_quantity === undefined
                      ? "—" : variant.inventory_quantity %>
                </td>
                <% if (inlineDestination) { %>
                  <td class="allocation-column">
                    <div class="quantity-stepper">
                      <button
                        class="quantity-stepper__button allocation-step"
                        type="button"
                        data-step="-1"
                        aria-label="Decrease inventory for <%= name %>"
                        <%= inlineInventoryEnabled ? "" : "disabled" %>>&minus;</button>
                      <input
                        class="field__input allocation-input"
                        type="number"
                        min="<%= inlineSold %>"
                        max="<%= inlineMax %>"
                        step="1"
                        value="<%= inlineAllocated %>"
                        data-connection="<%= inlineDestination.connection.id %>"
                        data-variant="<%= variant.id %>"
                        data-sold="<%= inlineSold %>"
                        data-current="<%= inlineAllocated %>"
                        data-tracked="<%= variant.inventory_tracked === 0 ? 0 : 1 %>"
                        <%= inlineInventoryEnabled ? "" : "disabled" %>
                        aria-label="Inventory allotted to <%= inlineDestinationName %> for <%= name %>">
                      <button
                        class="quantity-stepper__button allocation-step"
                        type="button"
                        data-step="1"
                        aria-label="Increase inventory for <%= name %>"
                        <%= inlineInventoryEnabled ? "" : "disabled" %>>+</button>
                    </div>
                    <span class="allocation-limit">
                      Remaining <%= inlineRemaining %> &middot; Max <%= inlineMax %>
                      <% if (variant.inventory_tracked === 0) { %>
                        &middot; Track quantity is off in source Shopify
                      <% } %>
                    </span>
                  </td>
                <% } %>
                <td class="table__actions">
                  <button
                    class="btn btn--small btn--danger remove-variant"
                    type="button"
                    data-variant="<%= variant.id %>"
                    <%= shared.length === 1 ? "disabled" : "" %>
                    title="<%= shared.length === 1
                        ? 'The last shared variant cannot be removed. Delete the product instead.'
                        : 'Stop sharing this variant' %>">
                    Delete
                  </button>
                </td>
              </tr>
            <% }); %>
            <% } %>
          </tbody>
        </table>

        <% if (inlineDestination) { %>
          <% if (!inlineInventoryEnabled) { %>
            <p class="notice notice--warn">
              Inventory allocation is unavailable for <%= inlineDestinationName %>.
              Keep the connection active and enable inventory sync in the
              destination Settings before changing it.
            </p>
          <% } %>
          <div
            class="allocation-form__actions allocation-controls"
            data-connection="<%= inlineDestination.connection.id %>"
            data-needs-allow="<%= inlineDestination.needsAllow ? 1 : 0 %>">
            <button class="btn btn--small btn--primary allocation-save" type="button" <%= inlineInventoryEnabled ? "" : "disabled" %>>
              <%= inlineDestination.needsAllow ? "Share & save" : "Save" %>
            </button>
          </div>
        <% } %>

        <%# Nothing shared at all is its own state, handled in the row above. %>
        <% if (shared.length && shared.length < totalVariants) { %>
          <p class="muted">
            <%= totalVariants - shared.length %> variant<%= totalVariants - shared.length === 1 ? " is" : "s are" %> not being shared.
          </p>
          <div class="shell__actions">
            <button class="btn btn--small" type="button" id="reset-variants">
              Share all <%= totalVariants %> variants
            </button>
          </div>
        <% } %>

        <% if (inventoryDestinations.length > 1) { %>
          <section class="allocation-panel" aria-labelledby="allocation-heading">
            <div class="allocation-panel__header">
              <div>
                <h2 class="panel__title" id="allocation-heading">Inventory allocation</h2>
                <p class="panel__copy">
                  Reserve stock for each destination. Reserved units are removed from
                  this source store now, so the same unit cannot sell in two stores.
                </p>
              </div>
            </div>

            <% inventoryDestinations.forEach(function (destination) {
              var connection = destination.connection;
              var mapping = destination.mapping;
              var allowedIds = mapping.allowed_variant_ids
                ? mapping.allowed_variant_ids.map(Number)
                : null;
              var destinationVariants = allowedIds
                ? shared.filter(function (variant) { return allowedIds.indexOf(Number(variant.id)) !== -1; })
                : shared;
              var destinationName = connection.destination.store_name || connection.destination.shop_domain;
              var inventoryEnabled = destination.inventoryEnabled !== false;
            %>
              <form class="allocation-form" data-connection="<%= connection.id %>">
                <div class="allocation-form__title">
                  <strong><%= destinationName %></strong>
                  <span class="muted">Total reserved includes units already sold.</span>
                </div>
                <% if (!inventoryEnabled) { %>
                  <p class="notice notice--warn">
                    Inventory allocation is unavailable for this destination.
                    Keep the connection active and enable inventory sync in the
                    destination Settings before changing it.
                  </p>
                <% } %>
                <table class="table table--allocation">
                  <thead>
                    <tr>
                      <th>Variant</th>
                      <th>Available at source</th>
                      <th>Sold</th>
                      <th>Remaining there</th>
                      <th>Reserved total</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% destinationVariants.forEach(function (variant) {
                      var allocation = destination.allocations.get(Number(variant.id));
                      var allocated = allocation ? allocation.allocated_quantity : 0;
                      var sold = allocation ? allocation.sold_quantity : 0;
                      var remaining = allocation ? allocation.remaining_quantity : 0;
                      var available = Number(variant.inventory_quantity);
                      var maximum = Number(allocated) +
                        (Number.isFinite(available) ? Math.max(available, 0) : 0);
                      var variantName = [variant.option1, variant.option2, variant.option3]
                        .filter(Boolean).join(" / ") || variant.title;
                    %>
                      <tr>
                        <td><span class="table__title"><%= variantName === "Default Title" ? "Single variant" : variantName %></span></td>
                        <td><%= variant.inventory_quantity == null ? "—" : variant.inventory_quantity %></td>
                        <td><%= sold %></td>
                        <td><%= remaining %></td>
                        <td>
                          <div class="quantity-stepper">
                            <button class="quantity-stepper__button allocation-step" type="button" data-step="-1" <%= inventoryEnabled ? "" : "disabled" %>>&minus;</button>
                            <input
                              class="field__input allocation-input"
                              type="number"
                              min="<%= sold %>"
                              max="<%= maximum %>"
                              step="1"
                              value="<%= allocated %>"
                              data-connection="<%= connection.id %>"
                              data-variant="<%= variant.id %>"
                              data-sold="<%= sold %>"
                              data-current="<%= allocated %>"
                              data-tracked="<%= variant.inventory_tracked === 0 ? 0 : 1 %>"
                              <%= inventoryEnabled ? "" : "disabled" %>
                              aria-label="Reserved total for <%= variantName %> at <%= destinationName %>">
                            <button class="quantity-stepper__button allocation-step" type="button" data-step="1" <%= inventoryEnabled ? "" : "disabled" %>>+</button>
                          </div>
                          <span class="allocation-limit">
                            Remaining <%= remaining %> &middot; Max <%= maximum %>
                            <% if (variant.inventory_tracked === 0) { %>
                              &middot; Track quantity is off in source Shopify
                            <% } %>
                          </span>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
                <div
                  class="allocation-form__actions allocation-controls"
                  data-connection="<%= connection.id %>"
                  data-needs-allow="<%= destination.needsAllow ? 1 : 0 %>">
                  <button class="btn btn--small btn--primary allocation-save" type="submit" <%= inventoryEnabled ? "" : "disabled" %>>
                    <%= destination.needsAllow ? "Share & save" : "Save" %>
                  </button>
                </div>
              </form>
            <% }); %>
          </section>
        <% } %>

    </section>

  </main>

  <script>
    (function () {
      var pageError = document.getElementById("page-error");
      var productId = <%- json(String(product.id)) %>;

      function fail(message) {
        pageError.textContent = message;
        pageError.hidden = false;
      }

      async function post(url, body, button) {
        var response = await window.appFetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body || {}),
          busy: button
        });
        var data = await response.json().catch(function () { return {}; });
        if (!response.ok) throw new Error(data.error || "Request failed");
        return data;
      }

      document.getElementById("back").addEventListener("click", function () {
        window.appNavigate("/products");
      });

      Array.prototype.slice.call(document.querySelectorAll(".remove-variant"))
        .forEach(function (button) {
          button.addEventListener("click", async function () {
            pageError.hidden = true;
            button.disabled = true;

            try {
              await post("/products/" + productId + "/variants/remove", {
                variant_id: button.dataset.variant
              }, button);
              window.appToast("Variant removed from the offer");
              window.appNavigate("/products/" + productId);
            } catch (err) {
              button.disabled = false;
              fail(err.message);
            }
          });
        });

      var resetButton = document.getElementById("reset-variants");

      if (resetButton) {
        resetButton.addEventListener("click", async function () {
          pageError.hidden = true;
          resetButton.disabled = true;

          try {
            await post("/products/reset-variants", {
              source_product_ids: [productId]
            }, resetButton);
            window.appToast("All variants are shared again");
            window.appNavigate("/products/" + productId);
          } catch (err) {
            resetButton.disabled = false;
            fail(err.message);
          }
        });
      }

      function clampAllocation(input, value) {
        var minimum = Number(input.min || 0);
        var maximum = Number(input.max || minimum);
        return Math.min(maximum, Math.max(minimum, Math.round(value)));
      }

      Array.prototype.slice.call(document.querySelectorAll(".allocation-step"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            var input = button.parentElement.querySelector(".allocation-input");
            input.value = clampAllocation(
              input,
              Number(input.value || 0) + Number(button.dataset.step || 0)
            );
          });
        });

      var allAllocationInputs = Array.prototype.slice.call(
        document.querySelectorAll(".allocation-input")
      );

      allAllocationInputs.forEach(function (input) {
        input.title = "Click the field, then scroll to increase or decrease";
        input.addEventListener("wheel", function (event) {
          if (input.disabled || document.activeElement !== input) return;

          event.preventDefault();
          input.value = clampAllocation(
            input,
            Number(input.value || 0) + (event.deltaY < 0 ? 1 : -1)
          );
        }, { passive: false });
      });

      Array.prototype.slice.call(document.querySelectorAll(".allocation-controls"))
        .forEach(function (controls) {
          var connectionId = Number(controls.dataset.connection);
          var save = controls.querySelector(".allocation-save");
          var form = controls.closest("form");
          var inputs = allAllocationInputs.filter(function (input) {
            return Number(input.dataset.connection) === connectionId;
          });

          async function saveAllocation(event) {
            event.preventDefault();
            pageError.hidden = true;

            var isSharing = controls.dataset.needsAllow === "1";
            var isZeroInventory = true;

            for (var i = 0; i < inputs.length; i++) {
              var input = inputs[i];
              var quantity = Number(input.value);
              var maximum = Number(input.max);
              var minimum = Number(input.min);

              if (!Number.isInteger(quantity) || quantity < minimum || quantity > maximum) {
                fail(
                  "Inventory must be a whole number between " + minimum +
                  " and " + maximum + "."
                );
                input.focus();
                return;
              }

              if (quantity !== Number(input.dataset.current) &&
                  input.dataset.tracked === "0") {
                fail(
                  "This variant does not track inventory in the source Shopify store. " +
                  "Enable Track quantity, set its stock, then try again."
                );
                input.focus();
                return;
              }

              if (quantity !== 0) isZeroInventory = false;
            }

            try {
              if (isSharing) {
                await post(
                  "/products/allow",
                  {
                    selections: [{
                      source_product_id: productId,
                      variant_ids: inputs.map(function (input) {
                        return Number(input.dataset.variant);
                      })
                    }],
                    connection_ids: [connectionId]
                  },
                  save
                );
              }

              var data = await post(
                "/products/" + productId + "/inventory-allocation",
                {
                  connection_id: connectionId,
                  allocations: inputs.map(function (input) {
                    return {
                      variant_id: Number(input.dataset.variant),
                      quantity: Number(input.value)
                    };
                  })
                },
                save
              );

              var message;
              if (isSharing && isZeroInventory) {
                message = "Product shared with 0 inventory";
              } else if (isSharing) {
                message = "Product shared and inventory saved";
              } else if (isZeroInventory) {
                message = "Inventory saved at 0";
              } else {
                message = "Inventory saved";
              }
              if (data.queued) message += ". Destination sync is queued";
              window.appToast(message);
              window.appNavigate("/products/" + productId);
            } catch (err) {
              fail(err.message);
            }
          }

          if (form) {
            form.addEventListener("submit", saveAllocation);
          } else {
            save.addEventListener("click", saveAllocation);
          }
        });
    })();
  </script>

</body>

</html>
