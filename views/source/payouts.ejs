<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head") %>
  <title>Payouts</title>
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>

  <%- include("../partials/nav") %>

  <main class="shell shell--wide">

    <header class="shell__header">
      <div>
        <h1>Payouts</h1>
        <p class="shell__sub">
          What you have earned supplying your buyers, and what they still owe
          you for it.
        </p>
      </div>
    </header>

    <%
      /* One place to format money, so a null never reaches the page as "NaN"
         and every figure carries its currency. */
      var money = function (value) {
        var amount = Number(value);
        return currency + " " + (isFinite(amount) ? amount : 0).toFixed(2);
      };
    %>

    <%
      var earnedTotal = Number(totals.earned) || 0;
      var receivedTotal = Number(totals.received) || 0;
      /* Share of what was earned that has actually come in. */
      var collected = earnedTotal > 0
        ? Math.max(0, Math.min(100, Math.round((receivedTotal / earnedTotal) * 100)))
        : 0;
    %>

    <%# The balance first and biggest: it is the number a supplier opens this
        screen for. The other three explain how it was reached. %>
    <section class="payout-hero">
      <div class="payout-hero__main">
        <span class="payout-hero__label">Still owed to you</span>
        <span class="card__value <%= totals.outstanding > 0 ? "card__value--warn" : "" %>">
          <%= money(totals.outstanding) %>
        </span>
        <span class="payout-hero__note">
          <% if (totals.outstanding < 0) { %>
            You have been paid ahead
          <% } else if (totals.outstanding > 0) { %>
            Across every buyer
          <% } else { %>
            All settled &mdash; nothing outstanding
          <% } %>
        </span>

        <div class="payout-hero__progress">
          <div class="payout-hero__progress-row">
            <span>Collected</span>
            <strong><%= collected %>%</strong>
          </div>
          <span class="progress" aria-hidden="true"><span style="width: <%= collected %>%"></span></span>
          <span class="payout-hero__fine">
            <%= money(totals.received) %> received of <%= money(totals.earned) %> earned
          </span>
        </div>
      </div>

      <div class="payout-hero__stats">
        <div class="stat">
          <span class="stat__icon stat__icon--brand" aria-hidden="true"><%- include("../partials/icon", { name: "wallet" }) %></span>
          <span class="stat__body">
            <span class="stat__label">Earned</span>
            <span class="stat__value"><%= money(totals.earned) %></span>
            <span class="stat__note">Your prices, on orders you have fulfilled</span>
          </span>
        </div>
        <div class="stat">
          <span class="stat__icon stat__icon--ok" aria-hidden="true"><%- include("../partials/icon", { name: "check" }) %></span>
          <span class="stat__body">
            <span class="stat__label">Received</span>
            <span class="stat__value"><%= money(totals.received) %></span>
            <span class="stat__note">Payments your buyers have recorded</span>
          </span>
        </div>
        <div class="stat">
          <span class="stat__icon stat__icon--waiting" aria-hidden="true"><%- include("../partials/icon", { name: "truck" }) %></span>
          <span class="stat__body">
            <span class="stat__label">Not yet shipped</span>
            <span class="stat__value"><%= money(totals.upcoming) %></span>
            <span class="stat__note">Earned once you fulfil it</span>
          </span>
        </div>
      </div>
    </section>

    <section class="panel">
      <div class="panel__header">
        <h2 class="panel__title">By buyer</h2>
        <span class="muted">
          <%# The rule behind every figure, said once rather than guessed at. %>
          Counted when you mark a sale fulfilled &mdash; cancelled orders were
          refunded to the shopper and are not owed.
        </span>
      </div>

      <%# The table keeps its columns when it is empty and says so in a row of
          its own: a table that vanishes reads as a screen that failed. %>
      <table class="table">
        <thead>
          <tr>
            <th>Buyer</th>
            <th>Orders</th>
            <th>Earned</th>
            <th>Received</th>
            <th>Still owed</th>
            <th class="table__actions-head">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!buyers.length) { %>
            <tr class="row--empty">
              <td class="table__empty" colspan="6">
                <span class="linked__icon" aria-hidden="true">
                  <%- include("../partials/icon", { name: "wallet" }) %>
                </span>
                <strong>No records found</strong>
                <span>
                  No buyer is connected yet. Share your pairing code from
                  <a class="link" href="/stores" data-navigate="/stores">Stores</a> to start.
                </span>
              </td>
            </tr>
          <% } else { %>
          <% buyers.forEach(function (buyer) { %>
            <tr>
              <td>
                <% var buyerName = buyer.destination_store_name || buyer.destination_shop_domain || "?"; %>
                <span class="media">
                  <span class="avatar" aria-hidden="true"><%= String(buyerName).charAt(0).toUpperCase() %></span>
                  <span class="media__body">
                    <span class="table__title"><%= buyerName %></span>
                    <% if (buyer.destination_store_name) { %>
                      <span class="muted"><%= buyer.destination_shop_domain %></span>
                    <% } %>
                  </span>
                </span>
              </td>

              <td>
                <%= buyer.fulfilled_orders %>
                <% if (buyer.open_orders) { %>
                  <%# Work in hand, and money not earned yet. %>
                  <span class="muted"><%= buyer.open_orders %> to fulfil</span>
                <% } %>
              </td>

              <td><strong><%= money(buyer.earned) %></strong></td>
              <td>
                <% var buyerEarned = Number(buyer.earned) || 0; %>
                <% var buyerPct = buyerEarned > 0 ? Math.max(0, Math.min(100, Math.round((Number(buyer.received) || 0) / buyerEarned * 100))) : 0; %>
                <span class="muted"><%= money(buyer.received) %></span>
                <span class="progress progress--small" title="<%= buyerPct %>% collected" aria-hidden="true"><span style="width: <%= buyerPct %>%"></span></span>
              </td>

              <td>
                <% if (buyer.outstanding > 0) { %>
                  <strong><%= money(buyer.outstanding) %></strong>
                <% } else if (buyer.outstanding < 0) { %>
                  <%# Paid ahead. Saying so stops a supplier chasing money it
                      has already had. %>
                  <span class="muted">
                    <%= money(Math.abs(buyer.outstanding)) %> paid ahead
                  </span>
                <% } else { %>
                  <span class="pill pill--synced">settled</span>
                <% } %>
              </td>

              <td class="table__actions">
                <button
                  class="btn btn--small view-buyer"
                  type="button"
                  data-connection="<%= buyer.connection_id %>">
                  View
                </button>
              </td>
            </tr>
          <% }); %>
          <% } %>
        </tbody>
      </table>
    </section>

  </main>

  <script>
    (function () {
      Array.prototype.slice.call(document.querySelectorAll(".view-buyer"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            window.appNavigate("/payouts/" + button.dataset.connection);
          });
        });
    })();
  </script>

</body>

</html>
