<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head") %>
  <title>Products</title>
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>

  <%- include("../partials/nav") %>

  <main class="shell shell--wide">

    <header class="shell__header">
      <div>
        <h1>Products</h1>
        <p class="shell__sub">
          Products staged here, and which of them go out to your destination stores.
        </p>
      </div>

      <div class="shell__actions">
        <%# No sync button here on purpose: the source offers products, the
            destination decides when to pull them in. %>
        <button class="btn btn--primary" type="button" id="add-button">+ Add products</button>
      </div>
    </header>

    <p class="notice notice--error" id="page-error" hidden></p>

    <% if (!activeConnections.length) { %>
      <p class="notice notice--warn">
        No destination store is connected yet, so nothing can be pushed. Connect
        one from <a class="link" href="/stores" data-navigate="/stores">Stores</a> first &mdash; you can
        still add products to the table in the meantime.
      </p>
    <% } %>

    <%# One list, with a filter over it. Two tabs made the catalogue look like
        two catalogues; this shows how much of it is out there and lets the
        merchant narrow it when they want to. %>
    <% var selectedStore = typeof storeFilter !== "undefined" ? storeFilter : null; %>
    <div class="listbar">
      <%# Segmented filter. Real links, not a client-side hide: the server
          decides which rows there are, so counts and list cannot disagree.
          The search travels along -- "the shared ones OF WHAT I SEARCHED". %>
      <nav class="segment" aria-label="Filter products">
        <% [
          { key: "all", label: "All", dot: "" },
          { key: "shared", label: "Shared", dot: "ok" },
          { key: "unshared", label: "Not shared", dot: "muted" },
        ].forEach(function (tab) {
          var params = [];
          if (tab.key !== "all") params.push("filter=" + tab.key);
          if (selectedStore) params.push("store=" + selectedStore);
          if (search) params.push("q=" + encodeURIComponent(search));
          var href = "/products" + (params.length ? "?" + params.join("&") : "");
        %>
          <a class="segment__item <%= filter === tab.key ? "segment__item--on" : "" %>"
             href="<%= href %>" data-navigate="<%= href %>"
             <%= filter === tab.key ? 'aria-current="page"' : "" %>>
            <% if (tab.dot) { %><span class="dot dot--<%= tab.dot %>" aria-hidden="true"></span><% } %>
            <%= tab.label %>
            <span class="segment__count"><%= counts[tab.key] %></span>
          </a>
        <% }); %></nav>

      <%# One destination, or all of them. The selected store scopes both the
          rows and their Shared/Not shared state: a product may be shared with
          one destination and still be available to another. %>
      <% if (connections.length > 1) { %>
        <div class="listbar__filter">
          <label class="field__label" for="store-filter">Destination store</label>
          <select class="field__input field__input--compact" id="store-filter">
            <option value="" <%= selectedStore ? "" : "selected" %>>All stores</option>
            <% connections.forEach(function (connection) { %>
              <option
                value="<%= connection.id %>"
                <%= selectedStore === connection.id ? "selected" : "" %>>
                <%= connection.destination.store_name || connection.destination.shop_domain %><%=
                  connection.status !== "active" ? " (" + connection.status + ")" : "" %>
              </option>
            <% }); %>
          </select>
        </div>
      <% } %>

      <%# On the same row as the filter: both narrow the same list, and the two
          screens should not look like different designs. %>
      <%
        var clearParams = [];
        if (filter !== "all") clearParams.push("filter=" + filter);
        if (selectedStore) clearParams.push("store=" + selectedStore);
        var clearHref = "/products" + (clearParams.length ? "?" + clearParams.join("&") : "");
      %>
      <%- include("../partials/search", {
        action: "/products",
        search: search,
        placeholder: "Search by title, vendor, type or SKU",
        hidden: [
          { name: "filter", value: filter === "all" ? "" : filter },
          { name: "store", value: selectedStore || "" },
        ],
        clearHref: clearHref,
      }) %>
    </div>

    <%# The table keeps its columns when it is empty and says so in a row of
        its own: a table that vanishes reads as a screen that failed. %>
    <table class="table table--select">
      <thead>
        <tr>
          <th class="table__check">
            <%# Only this page's rows -- nothing off-screen is ever silently
                included in an action. %>
            <input type="checkbox" id="check-all" aria-label="Select all on this page">
          </th>
          <th>Product</th>
          <th>Status</th>
          <th>Shared</th>
          <th class="table__actions-head">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!products.length) { %>
          <tr class="row--empty">
            <td class="table__empty" colspan="5">
              <%# A genuinely empty catalogue stays deliberately terse. Search
                  and filter results still explain why their table is empty. %>
              <% if (!search && !counts.all) { %>
                <strong>No records found</strong>
              <% } else { %>
                <span class="linked__icon" aria-hidden="true"><%- include("../partials/icon", { name: "box" }) %></span>
                <strong>No records found</strong>
                <span>
                  <%# A search that found nothing is not an empty catalogue.
                      Saying so, and repeating the term, is the difference
                      between "you have no products" and "try another word". %>
                  <% if (search) { %>
                  Nothing matches <strong><%= search %></strong><%
                    %><% if (filter !== "all") { %> in this filter<% } %>.
                  Titles, vendors, product types and SKUs are all searched
                  &mdash; try a shorter term, or <strong>Clear</strong> to see
                  the whole catalogue again.
                  <% } else if (filter === "shared") { %>
                  <%# The catalogue is not empty -- the filter is. Saying which
                      one is hiding everything is the useful half. %>
                  Nothing is shared yet. Switch to <strong>All</strong>,
                  tick what you want to sell through a destination store, and
                  press Allow selected.
                  <% } else { %>
                  Everything staged here is already shared. Use
                  <strong>Add products</strong> to bring in more.
                  <% } %>
                </span>
              <% } %>
            </td>
          </tr>
        <% } else { %>
        <% products.forEach(function (product) { %>
          <tr>
            <td class="table__check">
              <%# Every row can be ticked: Delete works on any product, and an
                  existing share may be extended to another destination. %>
              <input
                type="checkbox"
                class="row-check"
                value="<%= product.id %>"
                data-allowed="<%= product.allowed ? 1 : 0 %>"
                data-title="<%= product.title %>"
                data-synced="<%= product.synced || 0 %>"
                aria-label="Select <%= product.title %>">
            </td>
            <td>
              <span class="media">
                <% if (product.image_url) { %>
                  <img class="media__thumb" src="<%= product.image_url %>"
                       alt="" loading="lazy" width="40" height="40">
                <% } else { %>
                  <span class="media__thumb media__thumb--empty" aria-hidden="true"></span>
                <% } %>
                <span class="media__body">
                  <a class="table__title record-link"
                     href="<%= shopifyAdminUrl(shop, 'products', product.shopify_product_id) %>"
                     target="_blank" rel="noopener noreferrer">
                    <%= product.title %>
                  </a>
                  <%# Vendor and variant count on one quiet line; the variants
                      themselves live on the product's own page, behind View. %>
                  <span class="muted">
                    <% if (product.vendor) { %><%= product.vendor %> &middot; <% } %><%
                    %><%= product.variants.length %><%
                    %><% if (product.variants.length < product.variant_count) { %> of <%= product.variant_count %><% } %>
                    variant<%= product.variant_count === 1 ? "" : "s" %>
                  </span>
                </span>
              </span>
            </td>
            <td>
              <% var status = String(product.status || "").toLowerCase(); %>
              <% if (status) { %>
                <span class="status status--<%= status %>">
                  <span class="dot" aria-hidden="true"></span><%= status %>
                </span>
              <% } else { %>
                <span class="muted">&mdash;</span>
              <% } %>
            </td>
            <td>
              <% if (!product.allowed) { %>
                <span class="muted">Not shared</span>
              <% } else { %>
                <% if (product.synced) { %>
                  <span class="pill pill--active"
                        title="Live in <%= product.synced %> destination store(s)">
                    &#10003; <%= product.synced %> synced
                  </span>
                <% } %>
                <% if (product.awaiting) { %>
                  <%# Offered, but the destination has not ticked it yet --
                      nothing the source can do about it. %>
                  <span class="pill pill--pending"
                        title="Offered, but the destination store has not accepted it yet. Nothing for you to do.">
                    <%= product.awaiting %> awaiting them
                  </span>
                <% } %>
                <% if (product.pending) { %>
                  <span class="pill pill--paused"
                        title="Accepted, and queued to be written to their store on the next sync">
                    <%= product.pending %> pending
                  </span>
                <% } %>
                <% if (product.failed) { %>
                  <span class="pill pill--failed" title="<%= product.error_message || "" %>">
                    <%= product.failed %> failed
                  </span>
                <% } %>
              <% } %>
            </td>
            <td class="table__actions">
              <button
                class="btn btn--small view-product"
                type="button"
                data-product="<%= product.id %>">
                View
              </button>
              <button
                class="icon-btn icon-btn--danger delete-product"
                type="button"
                data-product="<%= product.id %>"
                data-title="<%= product.title %>"
                data-synced="<%= product.synced %>"
                title="Delete"
                aria-label="Delete <%= product.title %>">
                <%- include("../partials/icon", { name: "trash" }) %>
              </button>
            </td>
          </tr>
        <% }); %>
        <% } %>
      </tbody>
    </table>

    <%# Floats in over the table once anything is ticked, so the actions sit
        next to the selection instead of up in the toolbar. %>
    <div class="bulkbar" id="bulkbar" role="region" aria-label="Bulk actions" hidden>
      <span class="bulkbar__count" id="bulk-count">0 selected</span>
      <button class="bulkbar__btn" type="button" id="allow-button">Allow selected</button>
      <button class="bulkbar__btn bulkbar__btn--danger" type="button" id="bulk-delete">
        <%- include("../partials/icon", { name: "trash" }) %> Delete
      </button>
      <button class="bulkbar__close" type="button" id="bulk-clear" aria-label="Clear selection">&times;</button>
    </div>

    <%- include("../partials/pager", { pager: pager, noun: "products" }) %>

  </main>

  <% if (activeConnections.length > 1) { %>
    <%# Sharing is scoped per connection. With one destination there is no
        useful choice, so the existing one-click flow stays one click. %>
    <s-modal id="destination-picker" heading="Choose destination stores">
      <p class="modal__copy">
        Select where the chosen products should be offered. Existing shares
        with other stores will not be changed.
      </p>

      <div class="toggles" role="group" aria-label="Destination stores">
        <% activeConnections.forEach(function (connection) {
          var destination = connection.destination;
          var destinationName = destination.store_name || destination.shop_domain;
        %>
          <label class="toggles__item">
            <input
              type="checkbox"
              class="destination-check"
              value="<%= connection.id %>">
            <span><%= destinationName %></span>
          </label>
        <% }); %>
      </div>

      <p class="notice notice--error" id="destination-error" hidden></p>

      <s-button slot="primary-action" variant="primary" id="destination-share" disabled>
        Allow products
      </s-button>
      <s-button slot="secondary-actions" id="destination-cancel">Cancel</s-button>
    </s-modal>
  <% } %>

  <script>
    (function () {
      var pageError = document.getElementById("page-error");

      function fail(node, message) {
        node.textContent = message;
        node.hidden = false;
      }

      async function post(url, body, button) {
        var response = await window.appFetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body || {}),
          busy: button
        });
        var data = await response.json().catch(function () { return {}; });
        if (!response.ok) {
          var error = new Error(data.error || "Request failed");
          error.redirect = data.redirect || null;
          throw error;
        }
        return data;
      }

      /* ---------------- the table: selection + bulk bar ---------------- */

      var bulkbar = document.getElementById("bulkbar");
      var bulkCount = document.getElementById("bulk-count");
      var allowButton = document.getElementById("allow-button");
      var bulkDelete = document.getElementById("bulk-delete");
      var bulkClear = document.getElementById("bulk-clear");
      var checkAll = document.getElementById("check-all");
      var activeDestinationIds = <%- json(activeConnections.map(function (connection) { return connection.id; })) %>;
      var destinationPicker = document.getElementById("destination-picker");
      var destinationShare = document.getElementById("destination-share");
      var destinationCancel = document.getElementById("destination-cancel");
      var destinationError = document.getElementById("destination-error");
      var currentFilter = <%- json(filter) %>;
      var currentSearch = <%- json(search || "") %>;
      var currentStore = <%- json(selectedStore ? String(selectedStore) : "") %>;

      function productsUrl(nextFilter) {
        var params = new URLSearchParams();

        if (nextFilter && nextFilter !== "all") params.set("filter", nextFilter);
        if (currentStore) params.set("store", currentStore);
        if (currentSearch) params.set("q", currentSearch);

        var query = params.toString();
        return query ? "/products?" + query : "/products";
      }

      var storeFilterControl = document.getElementById("store-filter");

      if (storeFilterControl) {
        storeFilterControl.addEventListener("change", function () {
          currentStore = storeFilterControl.value;
          window.appNavigate(productsUrl(currentFilter));
        });
      }

      function rowChecks() {
        return Array.prototype.slice.call(document.querySelectorAll(".row-check"));
      }

      function ticked() {
        return rowChecks().filter(function (c) { return c.checked; });
      }

      /**
       * One entry per ticked product. Already-shared products stay eligible so
       * they can be offered to a newly connected destination later. The
       * server's per-connection upsert keeps an existing share idempotent.
       */
      function selections() {
        return ticked()
          .map(function (c) {
            return { source_product_id: c.value, variant_ids: null };
          });
      }

      function refresh() {
        var checks = rowChecks();
        var count = 0;

        checks.forEach(function (c) {
          c.closest("tr").classList.toggle("is-selected", c.checked);
          if (c.checked) count++;
        });

        if (checkAll) {
          checkAll.checked = count > 0 && count === checks.length;
          checkAll.indeterminate = count > 0 && count < checks.length;
        }

        bulkbar.hidden = count === 0;
        bulkCount.textContent = count + " selected";

        allowButton.disabled = count === 0;
        allowButton.textContent = "Allow selected";
        allowButton.title = "";
      }

      rowChecks().forEach(function (check) {
        check.addEventListener("change", refresh);
      });

      if (checkAll) {
        checkAll.addEventListener("change", function () {
          rowChecks().forEach(function (c) { c.checked = checkAll.checked; });
          refresh();
        });
      }

      bulkClear.addEventListener("click", function () {
        rowChecks().forEach(function (c) { c.checked = false; });
        refresh();
      });

      function destinationChecks() {
        return Array.prototype.slice.call(
          document.querySelectorAll(".destination-check")
        );
      }

      function chosenDestinationIds() {
        return destinationChecks()
          .filter(function (check) { return check.checked; })
          .map(function (check) { return Number(check.value); });
      }

      function refreshDestinationPicker() {
        if (destinationShare) {
          destinationShare.disabled = chosenDestinationIds().length === 0;
        }
      }

      async function allowToDestinations(connectionIds, button) {
        pageError.hidden = true;
        if (destinationError) destinationError.hidden = true;

        try {
          var data = await post("/products/allow", {
            selections: selections(),
            connection_ids: connectionIds
          }, button);
          if (destinationPicker) window.appClose(destinationPicker);
          window.appToast("Allowed on " + data.destinations + " destination store(s)");
          // Reload where they were -- same filter, same search. Page 1,
          // though: newly shared rows may have moved.
          window.appNavigate(<%- json(pager.href(1)) %>);
        } catch (err) {
          // The last destination may have paused after this page loaded. The
          // server repeats the redirect hint so this stale page follows the
          // same pairing/resume flow instead of leaving an error at the top.
          if (err.redirect) return window.appNavigate(err.redirect);

          if (destinationError) {
            fail(destinationError, err.message);
          } else {
            fail(pageError, err.message);
          }
        }
      }

      allowButton.addEventListener("click", function () {
        // Products may be staged before pairing. When there is nowhere to
        // offer them yet, take the merchant straight to the source Stores
        // screen, where the pairing code is generated and connections live.
        if (!activeDestinationIds.length) {
          var returnTo = encodeURIComponent("/products?filter=unshared");
          return window.appNavigate("/stores?returnTo=" + returnTo);
        }

        if (activeDestinationIds.length === 1) {
          return allowToDestinations(activeDestinationIds, allowButton);
        }

        destinationChecks().forEach(function (check) { check.checked = false; });
        destinationError.hidden = true;
        refreshDestinationPicker();
        window.appOpen(destinationPicker);
      });

      destinationChecks().forEach(function (check) {
        check.addEventListener("change", refreshDestinationPicker);
      });

      if (destinationShare) {
        destinationShare.addEventListener("click", function () {
          var connectionIds = chosenDestinationIds();
          if (connectionIds.length) {
            allowToDestinations(connectionIds, destinationShare);
          }
        });
      }

      if (destinationCancel) {
        destinationCancel.addEventListener("click", function () {
          window.appClose(destinationPicker);
        });
      }

      bulkDelete.addEventListener("click", async function () {
        var rows = ticked();
        if (!rows.length) return;

        var synced = rows.filter(function (c) { return Number(c.dataset.synced) > 0; }).length;

        // This removes products from OTHER merchants' stores, so say so in as
        // many words before doing it.
        if (!(await window.appConfirm(
          "Delete " + rows.length + " product(s)?\n\n" +
          (synced
            ? synced + " of them are live in destination stores and will be " +
              "PERMANENTLY DELETED there, along with their variants and images.\n\n"
            : "") +
          "They will also be removed from this list. This cannot be undone.",
          { confirmLabel: "Delete", destructive: true }
        ))) return;

        pageError.hidden = true;
        bulkDelete.disabled = true;
        allowButton.disabled = true;

        // One at a time: each delete reaches out to every destination store,
        // and firing them all at once would trip Shopify's rate limits.
        var done = 0;
        try {
          for (var i = 0; i < rows.length; i++) {
            await post("/products/" + rows[i].value + "/delete", {}, bulkDelete);
            done++;
          }
          window.appToast("Deleted " + done + " product(s)");
        } catch (err) {
          window.appToast("Deleted " + done + " of " + rows.length + " product(s)");
          fail(pageError, err.message);
        }
        window.appNavigate(<%- json(pager.href(1)) %>);
      });

      /** "gid://shopify/Product/900" -> "900" */
      function numericId(gid) {
        return String(gid).split("/").pop();
      }

      /* ---------------- row actions: view / delete ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".view-product"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            window.appNavigate("/products/" + button.dataset.product);
          });
        });

      Array.prototype.slice.call(document.querySelectorAll(".delete-product"))
        .forEach(function (button) {
          button.addEventListener("click", async function () {
            var synced = Number(button.dataset.synced) || 0;

            // This removes the product from OTHER merchants' stores, so say so
            // in as many words before doing it.
            if (!(await window.appConfirm(
              'Delete "' + button.dataset.title + '"?\n\n' +
              (synced
                ? "It will be PERMANENTLY DELETED from " + synced +
                  " destination store(s), along with its variants and images.\n\n"
                : "") +
              "It will also be removed from this list. This cannot be undone.",
              { confirmLabel: "Delete", destructive: true }
            ))) return;

            pageError.hidden = true;
            button.disabled = true;

            try {
              var data = await post("/products/" + button.dataset.product + "/delete", {}, button);
              window.appToast("Deleted from " + data.deleted + " store(s)");
              window.appNavigate("/products");
            } catch (err) {
              button.disabled = false;
              fail(pageError, err.message);
            }
          });
        });

      /* ---------------- add products (App Bridge resource picker) ---------------- */

      var addButton = document.getElementById("add-button");

      if (!addButton) return;

      addButton.addEventListener("click", async function () {
        pageError.hidden = true;

        // The picker is provided by the admin, so it only exists when the app
        // is actually embedded in it.
        if (!window.shopify || typeof window.shopify.resourcePicker !== "function") {
          return fail(
            pageError,
            "Open this app from your Shopify admin to add products."
          );
        }

        var selected;

        try {
          // "product", not "variant": this picker groups variants under their
          // product with names, images and search. The variant picker renders
          // a flat list with none of that.
          //
          // Deliberately NOT pre-ticked with what is already staged. Doing so
          // made the picker hand every staged product back on every Add, and
          // the server then re-imported the whole catalogue to add one thing.
          // Opening blank means only what the merchant just picked is sent.
          selected = await window.shopify.resourcePicker({
            type: "product",
            multiple: true,
            action: "add",
            // Only active products should be available to add. Draft and
            // archived products are not ready to be shared with destinations.
            filter: { draft: false, archived: false }
          });
        } catch (error) {
          return fail(pageError, "The product picker could not open.");
        }

        // undefined means the merchant closed it -- a choice, not a failure.
        if (!selected || !selected.length) return;

        addButton.disabled = true;
        addButton.textContent = "Adding…";

        try {
          // Only ids are sent -- the product's, and whichever of its variants
          // were ticked. The server re-reads everything else from Shopify, so
          // nothing the browser says about a title or a price is trusted.
          var data = await post("/products/import", {
            products: selected.map(function (product) {
              return {
                id: numericId(product.id),
                variant_ids: (product.variants || []).map(function (variant) {
                  return numericId(variant.id);
                })
              };
            })
          }, addButton);

          window.appToast(data.message || "Products added.");
          // Show exactly what the picker just affected: Shared when every
          // selected product was already shared, Not shared when none were,
          // and All when the selection contained both kinds.
          var importDestinations = {
            shared: productsUrl("shared"),
            unshared: productsUrl("unshared"),
            all: productsUrl("all")
          };
          window.appNavigate(importDestinations[data.filter] || "/products");
        } catch (err) {
          addButton.disabled = false;
          addButton.textContent = "+ Add products";
          fail(pageError, err.message);
        }
      });
    })();
  </script>

</body>

</html>
