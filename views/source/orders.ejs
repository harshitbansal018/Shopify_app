<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head") %>
  <title>Orders</title>
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>

  <%- include("../partials/nav") %>

  <main class="shell shell--wide">

    <header class="shell__header">
      <div>
        <h1>Orders</h1>
        <p class="shell__sub">
          Sales in the destination stores you supply, raised here at your own prices.
        </p>
      </div>
    </header>

    <p class="notice notice--error" id="page-error" hidden></p>

    <%# One table, two tabs, the same shape as Products. "Waiting" holds
        anything not yet placed here -- queued, failed or skipped -- because
        from the merchant's side those are all "this store has not got it yet". %>
    <nav class="tabs">
      <button
        class="tabs__tab<%= tab === "placed" ? " tabs__tab--on" : "" %>"
        type="button" data-tab="placed">
        Placed (<%= counts.placed %>)
      </button>
      <button
        class="tabs__tab<%= tab === "waiting" ? " tabs__tab--on" : "" %>"
        type="button" data-tab="waiting">
        Waiting (<%= counts.waiting %>)
      </button>
    </nav>

    <section class="panel">

      <%# The table keeps its columns when it is empty and says so in a row of
          its own: a table that vanishes reads as a screen that failed. %>
      <table class="table">
        <thead>
          <tr>
            <th>Order</th>
            <th>Sold by</th>
            <th>Items</th>
            <%# Both totals, side by side: the difference between them IS the
                markup, and this is the only screen that shows it. This store's
                own money comes first. %>
            <th>You are owed</th>
            <th>Customer paid</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (!orders.length) { %>
            <tr class="row--empty">
              <td class="table__empty" colspan="7">
                <strong>No records found</strong>
                <span>
                  <% if (tab === "waiting") { %>
                    Nothing is waiting. Every sale so far has reached this store.
                  <% } else { %>
                    No orders yet. When a destination store sells one of your synced
                    products, the matching order appears here.
                  <% } %>
                </span>
              </td>
            </tr>
          <% } else { %>
          <% orders.forEach(function (order) { %>
            <tr>
              <td>
                <span class="media__body">
                  <span class="table__title">
                    <a class="record-link"
                       href="<%= shopifyAdminUrl(order.destination_shop_domain, 'orders', order.destination_shopify_order_id) %>"
                       target="_blank" rel="noopener noreferrer">
                      <%= order.destination_order_name || ("#" + order.destination_shopify_order_id) %>
                    </a>
                  </span>
                  <span class="muted">
                    <% if (order.source_order_name && order.source_shopify_order_id) { %>
                      &rarr;
                      <a class="record-link"
                         href="<%= shopifyAdminUrl(order.source_shop_domain, 'orders', order.source_shopify_order_id) %>"
                         target="_blank" rel="noopener noreferrer"><%= order.source_order_name %> here</a>
                    <% } else if (order.source_order_name) { %>
                      &rarr; <%= order.source_order_name %> here
                    <% } else { %>
                      not yet placed
                    <% } %>
                  </span>
                </span>
              </td>
              <td>
                <%= order.destination_store_name || order.destination_shop_domain %>
              </td>
              <td><%= order.line_count %></td>

              <td>
                <strong>
                  <%= order.currency %>
                  <%= order.source_total === null ? "—" : order.source_total.toFixed(2) %>
                </strong>
              </td>
              <td class="muted">
                <%= order.currency %>
                <%= order.destination_total === null ? "—" : order.destination_total.toFixed(2) %>
              </td>

              <td>
                <span class="pill pill--<%= order.sync_status %>">
                  <%= order.sync_status === "synced" ? "placed" : order.sync_status %>
                </span>
                <% if (order.error_message && order.sync_status !== "synced") { %>
                  <span class="muted"><%= order.error_message %></span>
                <% } %>
              </td>

              <td class="table__actions">
                <%# No "Place now" here: the destination's sale is what raised
                    this order, so it is the end that owns the retry. %>
                <button
                  class="btn btn--small view-order"
                  type="button"
                  data-order="<%= order.id %>">
                  View
                </button>
              </td>
            </tr>
          <% }); %>
          <% } %>
        </tbody>
      </table>
    </section>

  </main>

  <script>
    (function () {
      /* ---------------- tabs ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".tabs__tab"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            // A real navigation, not a class toggle: the two tabs hold
            // different rows and the server decides which.
            window.appNavigate("/orders?tab=" + button.dataset.tab);
          });
        });

      /* ---------------- view one order ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".view-order"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            window.appNavigate("/orders/" + button.dataset.order);
          });
        });
    })();
  </script>

</body>

</html>
