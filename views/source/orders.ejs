<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head") %>
  <title>Orders</title>
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>

  <%- include("../partials/nav") %>

  <main class="shell shell--wide">

    <header class="shell__header">
      <div>
        <h1>Orders</h1>
        <p class="shell__sub">
          Sales in the destination stores you supply, at your own prices. You
          work them here &mdash; nothing is added to your own Shopify admin, and
          what you mark reaches the buyer's store.
        </p>
      </div>
    </header>

    <p class="notice notice--error" id="page-error" hidden></p>

    <%# One table, two tabs. "Open" is what still needs picking and shipping;
        "Done" holds everything settled, cancelled included. %>
    <nav class="tabs">
      <button
        class="tabs__tab<%= tab === "open" ? " tabs__tab--on" : "" %>"
        type="button" data-tab="open">
        To fulfil (<%= counts.open %>)
      </button>
      <button
        class="tabs__tab<%= tab === "done" ? " tabs__tab--on" : "" %>"
        type="button" data-tab="done">
        Done (<%= counts.done %>)
      </button>
    </nav>

    <section class="panel">

      <%# The table keeps its columns when it is empty and says so in a row of
          its own: a table that vanishes reads as a screen that failed. %>
      <table class="table">
        <thead>
          <tr>
            <th>Order</th>
            <th>Sold by</th>
            <th>Ship to</th>
            <th>Items</th>
            <%# Only this store's own money. What the shopper paid is the
                destination's retail price, and their margin is not this
                store's business. %>
            <th>You are owed</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (!orders.length) { %>
            <tr class="row--empty">
              <td class="table__empty" colspan="7">
                <strong>No records found</strong>
                <span>
                  <% if (tab === "open") { %>
                    Nothing to fulfil. Everything you have been sent is done.
                  <% } else { %>
                    Nothing finished yet. Check the To fulfil tab.
                  <% } %>
                </span>
              </td>
            </tr>
          <% } else { %>
          <% orders.forEach(function (order) { %>
            <tr>
              <td>
                <span class="table__title">
                  <%= order.destination_order_name || ("#" + order.destination_shopify_order_id) %>
                </span>
              </td>
              <td>
                <%= order.destination_store_name || order.destination_shop_domain %>
              </td>

              <td>
                <%# The address is what makes this actionable at a glance --
                    without it the row is a number and no job. %>
                <% if (order.shipping_address) { %>
                  <span class="media__body">
                    <span>
                      <%= [order.shipping_address.first_name,
                           order.shipping_address.last_name]
                          .filter(Boolean).join(" ") || "—" %>
                    </span>
                    <span class="muted">
                      <%= [order.shipping_address.city,
                           order.shipping_address.country_code]
                          .filter(Boolean).join(", ") %>
                    </span>
                  </span>
                <% } else { %>
                  <span class="muted">no address</span>
                <% } %>
              </td>

              <td><%= order.line_count %></td>

              <td>
                <strong>
                  <%= order.currency %>
                  <%= order.source_total === null ? "—" : order.source_total.toFixed(2) %>
                </strong>
              </td>

              <td>
                <% if (order.source_fulfillment_status === "cancelled") { %>
                  <span class="pill pill--failed">cancelled</span>
                  <%# Says out loud that cancelling here refunded a real
                      shopper, which is not obvious from this side. %>
                  <span class="muted">
                    <% if (order.cancel_status === "cancelled") { %>
                      the buyer was refunded
                    <% } else if (order.cancel_status === "failed") { %>
                      <%= order.cancel_error %>
                    <% } else { %>
                      refunding the buyer&hellip;
                    <% } %>
                  </span>
                <% } else if (order.source_fulfillment_status === "fulfilled") { %>
                  <span class="pill pill--synced">fulfilled</span>
                  <% order.source_tracking.forEach(function (parcel) { %>
                    <span class="muted">
                      <%= parcel.company || "tracking" %>: <%= parcel.number %>
                    </span>
                  <% }); %>
                  <%# Whether the BUYER has been told, which is a different
                      thing from whether this store says it shipped. %>
                  <% if (order.fulfil_status === "failed") { %>
                    <span class="muted"><%= order.fulfil_error %></span>
                  <% } else if (order.fulfil_status !== "fulfilled") { %>
                    <span class="muted">telling the buyer&hellip;</span>
                  <% } %>
                <% } else { %>
                  <span class="pill pill--pending">to fulfil</span>
                <% } %>
              </td>

              <td class="table__actions">
                <button
                  class="btn btn--small view-order"
                  type="button"
                  data-order="<%= order.id %>">
                  View
                </button>
                <%# Only the two moves that matter from a list. Tracking is
                    typed on the order's own page, where there is room for it. %>
                <% if (order.source_fulfillment_status === "unfulfilled") { %>
                  <button
                    class="btn btn--small btn--primary fulfil-order"
                    type="button"
                    data-order="<%= order.id %>">
                    Mark fulfilled
                  </button>
                  <button
                    class="btn btn--small btn--danger cancel-order"
                    type="button"
                    data-order="<%= order.id %>"
                    data-name="<%= order.destination_order_name %>">
                    Cannot supply
                  </button>
                <% } else if (order.source_fulfillment_status === "fulfilled") { %>
                  <button
                    class="btn btn--small unfulfil-order"
                    type="button"
                    data-order="<%= order.id %>">
                    Undo
                  </button>
                <% } %>
              </td>
            </tr>
          <% }); %>
          <% } %>
        </tbody>
      </table>
    </section>

  </main>

  <script>
    (function () {
      var pageError = document.getElementById("page-error");

      function fail(message) {
        pageError.textContent = message;
        pageError.hidden = false;
      }

      async function act(button, url, body, busyLabel) {
        pageError.hidden = true;

        var label = button.textContent;
        button.disabled = true;
        button.textContent = busyLabel;

        try {
          var response = await window.appFetch(url, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body || {})
          });

          var data = await response.json().catch(function () { return {}; });

          if (!response.ok) throw new Error(data.error || "Request failed");

          return data;
        } catch (err) {
          button.disabled = false;
          button.textContent = label;
          fail(err.message);
          return null;
        }
      }

      /* ---------------- tabs ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".tabs__tab"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            // A real navigation, not a class toggle: the two tabs hold
            // different rows and the server decides which.
            window.appNavigate("/orders?tab=" + button.dataset.tab);
          });
        });

      /* ---------------- view one order ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".view-order"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            window.appNavigate("/orders/" + button.dataset.order);
          });
        });

      /* ---------------- fulfil ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".fulfil-order"))
        .forEach(function (button) {
          button.addEventListener("click", async function () {
            // No tracking from the list: this is the "shipped, nothing to
            // track" case. The order's own page is where a number is typed.
            var data = await act(
              button,
              "/orders/" + button.dataset.order + "/fulfil",
              { tracking: [] },
              "Saving…"
            );

            if (!data) return;

            window.appToast("Marked fulfilled");
            window.appNavigate("/orders?tab=done");
          });
        });

      Array.prototype.slice.call(document.querySelectorAll(".unfulfil-order"))
        .forEach(function (button) {
          button.addEventListener("click", async function () {
            var data = await act(
              button,
              "/orders/" + button.dataset.order + "/unfulfil",
              {},
              "Saving…"
            );

            if (!data) return;

            window.appToast("Back on the To fulfil list");
            window.appNavigate("/orders");
          });
        });

      /* ---------------- cannot supply ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".cancel-order"))
        .forEach(function (button) {
          button.addEventListener("click", async function () {
            // This one spends someone else's money, so it says so plainly.
            if (!window.confirm(
              "Cannot supply " + button.dataset.name + "?\n\n" +
              "The buyer's order will be CANCELLED and REFUNDED, and they will " +
              "be emailed about it. This cannot be undone."
            )) return;

            var data = await act(
              button,
              "/orders/" + button.dataset.order + "/cancel",
              {},
              "Cancelling…"
            );

            if (!data) return;

            window.appToast("The buyer's order is being cancelled");
            window.appNavigate("/orders?tab=done");
          });
        });
    })();
  </script>

</body>

</html>
