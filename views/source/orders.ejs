<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head") %>
  <title>Orders</title>
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>

  <%- include("../partials/nav") %>

  <main class="shell shell--wide">

    <header class="shell__header">
      <div>
        <h1>Orders</h1>
        <p class="shell__sub">
          Sales in the destination stores you supply, at your own prices. You
          work them here &mdash; nothing is added to your own Shopify admin, and
          what you mark reaches the buyer's store.
        </p>
      </div>
    </header>

    <p class="notice notice--error" id="page-error" hidden></p>

    <%# One table, two tabs. "Open" is what still needs picking and shipping;
        "Done" holds everything settled, cancelled included. %>
    <nav class="tabs">
      <button
        class="tabs__tab<%= tab === "open" ? " tabs__tab--on" : "" %>"
        type="button" data-tab="open">
        To fulfil (<%= counts.open %>)
      </button>
      <button
        class="tabs__tab<%= tab === "done" ? " tabs__tab--on" : "" %>"
        type="button" data-tab="done">
        Done (<%= counts.done %>)
      </button>
    </nav>

    <section class="panel">

      <%# The table keeps its columns when it is empty and says so in a row of
          its own: a table that vanishes reads as a screen that failed. %>
      <table class="table">
        <thead>
          <tr>
            <th>Order</th>
            <th>Sold by</th>
            <th>Ship to</th>
            <th>Items</th>
            <%# Only this store's own money. What the shopper paid is the
                destination's retail price, and their margin is not this
                store's business. %>
            <th>You are owed</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (!orders.length) { %>
            <tr class="row--empty">
              <td class="table__empty" colspan="7">
                <strong>No records found</strong>
                <span>
                  <% if (tab === "open") { %>
                    Nothing to fulfil. Everything you have been sent is done.
                  <% } else { %>
                    Nothing finished yet. Check the To fulfil tab.
                  <% } %>
                </span>
              </td>
            </tr>
          <% } else { %>
          <% orders.forEach(function (order) { %>
            <tr>
              <td>
                <span class="table__title">
                  <%= order.destination_order_name || ("#" + order.destination_shopify_order_id) %>
                </span>
              </td>
              <td>
                <%= order.destination_store_name || order.destination_shop_domain %>
              </td>

              <td>
                <%# The address is what makes this actionable at a glance --
                    without it the row is a number and no job. %>
                <% if (order.shipping_address) { %>
                  <span class="media__body">
                    <span>
                      <%= [order.shipping_address.first_name,
                           order.shipping_address.last_name]
                          .filter(Boolean).join(" ") || "—" %>
                    </span>
                    <span class="muted">
                      <%= [order.shipping_address.city,
                           order.shipping_address.country_code]
                          .filter(Boolean).join(", ") %>
                    </span>
                  </span>
                <% } else { %>
                  <span class="muted">no address</span>
                <% } %>
              </td>

              <td><%= order.line_count %></td>

              <td>
                <strong>
                  <%= order.currency %>
                  <%= order.source_total === null ? "—" : order.source_total.toFixed(2) %>
                </strong>
              </td>

              <td>
                <% if (order.source_fulfillment_status === "cancelled") { %>
                  <span class="pill pill--failed">cancelled</span>
                  <%# Says out loud that cancelling here refunded a real
                      shopper, which is not obvious from this side. %>
                  <span class="muted">
                    <% if (order.cancel_status === "cancelled") { %>
                      the buyer was refunded
                    <% } else if (order.cancel_status === "failed") { %>
                      <%= order.cancel_error %>
                    <% } else { %>
                      refunding the buyer&hellip;
                    <% } %>
                  </span>
                <% } else if (order.source_fulfillment_status === "fulfilled") { %>
                  <span class="pill pill--synced">fulfilled</span>
                <% } else if (order.source_fulfillment_status === "partial") { %>
                  <%# Some of it has gone; the rest is still this store's job,
                      which is why it stays on the To fulfil tab. %>
                  <span class="pill pill--paused">partially fulfilled</span>
                  <span class="muted">more to send</span>
                <% } else { %>
                  <span class="pill pill--pending">unfulfilled</span>
                <% } %>
              </td>

              <td class="table__actions">
                <%# View only. Marking shipped, partly shipped, undone or
                    cancelled all happen on the order's own page: each needs
                    the lines in front of the merchant, and a list row has no
                    room for that. One button here also means one place to
                    look, whatever state the sale is in. %>
                <button
                  class="btn btn--small view-order"
                  type="button"
                  data-order="<%= order.id %>">
                  View
                </button>
              </td>
            </tr>
          <% }); %>
          <% } %>
        </tbody>
      </table>

      <%- include("../partials/pager", { pager: pager, noun: "orders" }) %>
    </section>

  </main>

  <script>
    (function () {
      var pageError = document.getElementById("page-error");

      function fail(message) {
        pageError.textContent = message;
        pageError.hidden = false;
      }

      /* ---------------- tabs ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".tabs__tab"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            // A real navigation, not a class toggle: the two tabs hold
            // different rows and the server decides which.
            window.appNavigate("/orders?tab=" + button.dataset.tab);
          });
        });

      /* ---------------- view one order ---------------- */

      Array.prototype.slice.call(document.querySelectorAll(".view-order"))
        .forEach(function (button) {
          button.addEventListener("click", function () {
            window.appNavigate("/orders/" + button.dataset.order);
          });
        });

    })();
  </script>

</body>

</html>
