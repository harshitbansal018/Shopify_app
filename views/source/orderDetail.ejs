<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head") %>
  <title><%= order.destination_order_name || "Order" %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>

<body>

  <%- include("../partials/nav") %>

  <%
    var status = order.source_fulfillment_status;
    var buyer = order.destination_store_name || order.destination_shop_domain;
    var open = status === "unfulfilled" || status === "partial";
    var remaining = lines.reduce(function (sum, line) { return sum + line.remaining; }, 0);
    var pillClass = status === "fulfilled" ? "synced"
      : status === "cancelled" ? "failed"
      : status === "partial" ? "paused" : "pending";
    var pillText = status === "unfulfilled" ? "unfulfilled"
      : status === "partial" ? "partially fulfilled" : status;
  %>

  <main class="shell">

    <header class="shell__header">
      <div>
        <button class="link link--back" type="button" id="back">&larr; Orders</button>
        <h1>
          <a class="record-link"
             href="<%= shopifyAdminUrl(order.destination_shop_domain, 'orders', order.destination_shopify_order_id) %>"
             target="_blank" rel="noopener noreferrer"><%= order.destination_order_name || ("#" + order.destination_shopify_order_id) %></a>
        </h1>
        <p class="shell__sub">
          Sold by <strong><%= buyer %></strong>,
          supplied by
          <strong><%= order.source_store_name || order.source_shop_domain %></strong>
        </p>
      </div>
      <span class="pill pill--<%= pillClass %>"><%= pillText %></span>
    </header>

    <p class="notice notice--error" id="page-error" hidden></p>

    <section class="panel">
      <h2 class="panel__title">What was bought</h2>

      <p class="panel__copy">
        <%# What the shopper paid is deliberately absent: that is the
            destination's retail price, and their margin is not this store's
            business. Only this store's own money is shown. %>
        You are owed your own price for each line, whatever the destination
        store sold it for.
        <% if (open) { %>
          Enter how many of each you are sending now, or leave the numbers as
          they are to send everything that is left.
        <% } %>
      </p>

      <%# The table keeps its columns when it is empty and says so in a row of
          its own: a table that vanishes reads as a screen that failed. %>
      <table class="table">
        <thead>
          <tr>
            <th>Product</th>
            <th>SKU</th>
            <th>Qty</th>
            <th>Shipped</th>
            <% if (open) { %><th>Ship now</th><% } %>
            <th>Your price</th>
            <th>Your total</th>
          </tr>
        </thead>
        <tbody>
          <% var sourceTotal = 0; %>
          <% if (!lines.length) { %>
            <tr class="row--empty">
              <td class="table__empty" colspan="<%= open ? 7 : 6 %>">
                <strong>No records found</strong>
                <span>
                  None of the products on this order are synced from this store any
                  more, so there is nothing left to charge for.
                </span>
              </td>
            </tr>
          <% } else { %>
          <% lines.forEach(function (line) { %>
            <%
              var lineSource = (line.source_price || 0) * line.quantity;
              sourceTotal += lineSource;
            %>
            <tr class="<%= line.remaining === 0 && open ? "row--placeholder" : "" %>">
              <td>
                <span class="media__body">
                  <% if (line.source_shopify_product_id) { %>
                    <a class="table__title record-link"
                       href="<%= shopifyAdminUrl(order.source_shop_domain, 'products', line.source_shopify_product_id) %>"
                       target="_blank" rel="noopener noreferrer"><%= line.source_product_title || line.title %></a>
                  <% } else { %>
                    <span class="table__title"><%= line.source_product_title || line.title %></span>
                  <% } %>
                  <% if (line.source_variant_title) { %>
                    <span class="muted"><%= line.source_variant_title %></span>
                  <% } %>
                </span>
              </td>
              <td class="muted"><%= line.source_sku || line.destination_sku || "—" %></td>
              <td><%= line.quantity %></td>
              <td>
                <%# Shipped so far, against the sale's quantity. Green once the
                    line is done, so a half-shipped sale reads at a glance. %>
                <span class="<%= line.shipped >= line.quantity ? "ship-done" : line.shipped ? "ship-part" : "muted" %>">
                  <%= line.shipped %> / <%= line.quantity %>
                </span>
              </td>
              <% if (open) { %>
                <td>
                  <% if (line.remaining > 0) { %>
                    <input
                      class="field__input field__input--qty ship-qty"
                      type="number"
                      min="0"
                      max="<%= line.remaining %>"
                      step="1"
                      value="<%= line.remaining %>"
                      data-line="<%= line.line_id %>"
                      data-remaining="<%= line.remaining %>"
                      aria-label="Quantity of <%= line.source_product_title || line.title %> to ship now">
                  <% } else { %>
                    <span class="muted">done</span>
                  <% } %>
                </td>
              <% } %>
              <td>
                <%= order.currency %>
                <%= line.source_price === null ? "—" : line.source_price.toFixed(2) %>
              </td>
              <td><strong><%= order.currency %> <%= lineSource.toFixed(2) %></strong></td>
            </tr>
          <% }); %>
          <% } %>
        </tbody>
        <%# Nothing to total when there are no lines. %>
        <% if (lines.length) { %>
        <tfoot>
          <tr>
            <td colspan="<%= open ? 5 : 4 %>"></td>
            <td class="muted">Total</td>
            <td><strong><%= order.currency %> <%= sourceTotal.toFixed(2) %></strong></td>
          </tr>
        </tfoot>
        <% } %>
      </table>
    </section>

    <section class="panel">
      <h2 class="panel__title">Order</h2>
      <dl class="facts">
        <div class="facts__row">
          <dt>Sale</dt>
          <dd>
            <a class="record-link"
               href="<%= shopifyAdminUrl(order.destination_shop_domain, 'orders', order.destination_shopify_order_id) %>"
               target="_blank" rel="noopener noreferrer"><%= order.destination_order_name || ("#" + order.destination_shopify_order_id) %></a>
          </dd>
        </div>
        <div class="facts__row">
          <dt>Ship to</dt>
          <dd>
            <%# The job, in one place. Without it this page is just a number. %>
            <% if (order.shipping_address) { %>
              <% var a = order.shipping_address; %>
              <div><%= [a.first_name, a.last_name].filter(Boolean).join(" ") %></div>
              <% if (a.company) { %><div><%= a.company %></div><% } %>
              <div><%= a.address1 %></div>
              <% if (a.address2) { %><div><%= a.address2 %></div><% } %>
              <div>
                <%= [a.city, a.province_code, a.zip, a.country_code]
                    .filter(Boolean).join(", ") %>
              </div>
              <% if (a.phone) { %><div class="muted"><%= a.phone %></div><% } %>
            <% } else { %>
              <span class="muted">
                No address on this sale. Ask <%= buyer %> before shipping.
              </span>
            <% } %>
          </dd>
        </div>
        <div class="facts__row">
          <dt>Status</dt>
          <dd>
            <% if (order.source_cancelled_at) { %>
              cannot supply<%= order.source_cancel_reason ? ` (${order.source_cancel_reason})` : "" %>
            <% } else { %>
              <%= pillText %>
            <% } %>
          </dd>
        </div>

        <% if (order.source_cancelled_at) { %>
          <div class="facts__row">
            <dt>The buyer's order</dt>
            <dd>
              <%# Cancelling here refunds a real shopper in the destination
                  store. That is not obvious from this side, so it is said. %>
              <% if (order.cancel_status === "cancelled") { %>
                cancelled and refunded too
              <% } else if (order.cancel_status === "failed") { %>
                could not be cancelled &mdash; <%= order.cancel_error %>
              <% } else { %>
                being cancelled and refunded&hellip;
              <% } %>
            </dd>
          </div>
        <% } %>
      </dl>
    </section>

    <%# Every shipment so far, oldest first -- including ones since undone,
        which stay as history. Each one is a separate fulfillment on the
        buyer's real order, so each says on its own whether the buyer has
        been told. %>
    <% var standing = shipments.filter(function (s) { return s.push_status !== "cancelled"; }); %>
    <% if (shipments.length) { %>
      <section class="panel">
        <h2 class="panel__title">Shipments</h2>

        <table class="table shipments">
          <thead>
            <tr>
              <th>#</th>
              <th>Items</th>
              <th>Tracking</th>
              <th>Buyer's order</th>
            </tr>
          </thead>
          <tbody>
            <% shipments.forEach(function (shipment, index) { %>
              <% var units = shipment.lines.reduce(function (sum, l) { return sum + Number(l.quantity); }, 0); %>
              <tr class="<%= shipment.push_status === "cancelled" ? "row--placeholder" : "" %>">
                <td><%= index + 1 %></td>
                <td>
                  <%= units %> unit<%= units === 1 ? "" : "s" %>
                  <% if (shipment.push_status === "cancelled") { %>
                    <span class="muted">&mdash; undone</span>
                  <% } %>
                </td>
                <td>
                  <% if (shipment.tracking.length) { %>
                    <% shipment.tracking.forEach(function (parcel) { %>
                      <div><%= parcel.company || "Tracking" %>: <strong><%= parcel.number %></strong></div>
                    <% }); %>
                  <% } else { %>
                    <span class="muted">none</span>
                  <% } %>
                </td>
                <td>
                  <%# Whether the BUYER has been told, which is a different
                      thing from whether this store says it shipped. %>
                  <% if (shipment.push_status === "sent") { %>
                    <span class="pill pill--synced">told</span>
                  <% } else if (shipment.push_status === "failed") { %>
                    <span class="pill pill--failed">not yet</span>
                    <span class="muted"><%= shipment.push_error %> &mdash; retrying</span>
                  <% } else if (shipment.push_status === "cancelled") { %>
                    <span class="muted">withdrawn</span>
                  <% } else { %>
                    <span class="pill pill--pending">telling them&hellip;</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </section>
    <% } %>

    <%# The actions. Only while there is something to do: buttons over a
        cancelled sale are dead controls. %>
    <% if (status !== "cancelled") { %>
      <section class="panel">
        <h2 class="panel__title">
          <%= status === "fulfilled" ? "Shipped" : "Shipping" %>
        </h2>

        <% if (status === "fulfilled") { %>
          <p class="panel__copy">
            Everything on this order has shipped. If that was a mistake, or a
            parcel came back, mark it unfulfilled: every shipment is withdrawn
            from <%= buyer %>'s order too, so the shopper is not left with a
            shipping notice for a parcel that is not coming.
          </p>
        <% } else { %>
          <p class="panel__copy">
            <% if (status === "partial") { %>
              <%= remaining %> unit<%= remaining === 1 ? " is" : "s are" %> still to
              send.
            <% } %>
            Add a tracking number if you have one. Your own Shopify admin is not
            touched. <%= buyer %>'s order is fulfilled with this tracking and
            Shopify emails the shopper about it, so put the real number in.
          </p>

          <div class="toggles">
            <label class="field">
              <span class="field__label">Carrier</span>
              <input class="field__input" type="text" id="carrier"
                     placeholder="DHL" autocomplete="off">
            </label>
            <label class="field">
              <span class="field__label">Tracking number</span>
              <input class="field__input" type="text" id="tracking-number"
                     placeholder="Optional" autocomplete="off">
            </label>
            <label class="field">
              <span class="field__label">Tracking link</span>
              <input class="field__input" type="url" id="tracking-url"
                     placeholder="Optional" autocomplete="off">
            </label>
          </div>
        <% } %>

        <%# The four moves, in the order they are needed. Fulfilled and
            Partially fulfilled read the Ship now column; the difference is
            whether it is everything that is left. Cancel is coloured as the
            exit it is: it refunds the shopper. %>
        <div class="shell__actions order-actions">
          <% if (open) { %>
            <button class="btn btn--primary" type="button" id="fulfil">
              Fulfilled
            </button>
            <button class="btn" type="button" id="fulfil-partial">
              Partially fulfilled
            </button>
          <% } %>
          <% if (status === "partial" || status === "fulfilled") { %>
            <button class="btn" type="button" id="unfulfil">
              Unfulfilled
            </button>
          <% } %>
          <button class="btn btn--danger" type="button" id="cannot-supply">
            Cancel
          </button>
        </div>
      </section>
    <% } %>

  </main>

  <script>
    (function () {
      var pageError = document.getElementById("page-error");

      function fail(message) {
        pageError.textContent = message;
        pageError.hidden = false;
      }

      document.getElementById("back").addEventListener("click", function () {
        window.appNavigate("/orders");
      });

      async function post(button, path, body, busyLabel) {
        pageError.hidden = true;

        var label = button.textContent;
        button.disabled = true;
        button.textContent = busyLabel;

        try {
          var response = await window.appFetch(
            "/orders/<%= order.id %>/" + path,
            {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(body || {}),
              busy: button
            }
          );

          var data = await response.json().catch(function () { return {}; });

          if (!response.ok) throw new Error(data.error || "Request failed");

          return data;
        } catch (err) {
          button.disabled = false;
          button.textContent = label;
          fail(err.message);
          return null;
        }
      }

      /* ---------------- what is going out ---------------- */

      function tracking() {
        var number = document.getElementById("tracking-number").value.trim();

        // No number means nothing to track, which is allowed: plenty of
        // shipping has no tracking, and refusing would leave the merchant
        // unable to mark anything done.
        return number
          ? [{
              number: number,
              company: document.getElementById("carrier").value.trim() || null,
              url: document.getElementById("tracking-url").value.trim() || null
            }]
          : [];
      }

      // The Ship now column, as [{ line_id, quantity }], with what is left on
      // each line beside it so the buttons can tell "all of it" from "some".
      function shipNow() {
        return Array.prototype.slice.call(document.querySelectorAll(".ship-qty"))
          .map(function (input) {
            return {
              line_id: Number(input.dataset.line),
              quantity: Number(input.value) || 0,
              remaining: Number(input.dataset.remaining)
            };
          });
      }

      var fulfil = document.getElementById("fulfil");

      if (fulfil) {
        fulfil.addEventListener("click", async function () {
          // Everything that is left, whatever the column says: this button
          // means the order is done. Sent without `lines` so the server ships
          // the remainder as it counts it, not as the page last showed it.
          var data = await post(fulfil, "fulfil", { tracking: tracking() }, "Saving…");

          if (!data) return;

          window.appToast("Marked fulfilled");
          window.appNavigate("/orders?tab=done");
        });
      }

      var partial = document.getElementById("fulfil-partial");

      if (partial) {
        partial.addEventListener("click", async function () {
          var lines = shipNow();
          var sending = lines.reduce(function (sum, l) { return sum + l.quantity; }, 0);
          var left = lines.reduce(function (sum, l) { return sum + l.remaining; }, 0);

          if (!sending) {
            return fail("Enter how many of each line you are sending now.");
          }

          // The column says everything: that is not a partial shipment, and
          // saying so beats silently doing what the other button does.
          if (sending >= left) {
            return fail(
              "Those quantities cover everything that is left. Use Fulfilled " +
              "for that, or lower a quantity to ship part of the order."
            );
          }

          var data = await post(partial, "fulfil", {
            tracking: tracking(),
            lines: lines.map(function (l) { return { line_id: l.line_id, quantity: l.quantity }; })
          }, "Saving…");

          if (!data) return;

          window.appToast("Marked partially fulfilled");
          // Still open: there is more to send, so come back here.
          window.appNavigate("/orders/<%= order.id %>");
        });
      }

      var undo = document.getElementById("unfulfil");

      if (undo) {
        undo.addEventListener("click", async function () {
          if (!(await window.appConfirm(
            "Mark this order unfulfilled?\n\n" +
            "Every shipment on it is withdrawn from the buyer's order, and " +
            "the shopper's shipping confirmation no longer stands.",
            { confirmLabel: "Mark unfulfilled", destructive: true }
          ))) return;

          var data = await post(undo, "unfulfil", {}, "Saving…");

          if (!data) return;

          window.appToast("Back on the To fulfil list");
          window.appNavigate("/orders");
        });
      }

      var cannot = document.getElementById("cannot-supply");

      if (cannot) {
        cannot.addEventListener("click", async function () {
          // This one spends someone else's money, so it says so plainly.
          if (!(await window.appConfirm(
            "Cancel this order?\n\n" +
            "The buyer's order will be CANCELLED and REFUNDED, and they will " +
            "be emailed about it. This cannot be undone.",
            { confirmLabel: "Cancel order", cancelLabel: "Keep order", destructive: true }
          ))) return;

          var data = await post(cannot, "cancel", {}, "Cancelling…");

          if (!data) return;

          window.appToast("The buyer's order is being cancelled");
          window.appNavigate("/orders?tab=done");
        });
      }
    })();
  </script>

</body>

</html>
