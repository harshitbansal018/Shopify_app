<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Page</title>
  <link rel="stylesheet" href="/css/pageEditor.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body>

  <div class="editor-page">
    <div class="editor-header">
      <div>
        <p class="editor-eyebrow">Page editor</p>
        <h1>Edit Page: <%= page.title %>
        </h1>
        <p class="editor-copy">
          Manage blocks, add new sections, and keep the Shopify page synced with your saved content.
        </p>
      </div>

      <div class="editor-actions">
        <button class="primary-btn" type="button" onclick="openAddBlockModal()">
          Add Block
        </button>

        <button class="editor-back" type="button"
          onclick="window.location.href='/pages/create?shop=<%= page.shop_domain %>'">
          Back
        </button>
      </div>
    </div>

    <div class="editor-toolbar">
      <div class="editor-search">
        <label class="editor-search__label" for="blockSearch">Search blocks by title</label>
        <input
          id="blockSearch"
          class="editor-search__input"
          type="search"
          placeholder="Search hero title"
        >
      </div>
    </div>

    <div id="editorGrid" class="editor-grid">
      <% if (!blocks.length) { %>
        <div class="editor-empty">
          <h2>No blocks found</h2>
          <p>Add your first block to get started.</p>
        </div>
        <% } %>

          <% blocks.forEach((block, i)=> { %>
            <div
              class="block-card"
              data-block-title="<%= String(block.title || block.heading || block.text || '').toLowerCase() %>"
            >
              <span class="block-card__index">Block <%= i + 1 %></span>
              <h2>
                <%= block.type.toUpperCase() %>
              </h2>

              <button class="delete-btn" type="button" onclick="deleteBlock(<%= i %>)">
                <i class="fas fa-trash"></i>
              </button>

              <% if (block.type==="hero" ) { %>
                <p><strong>Title:</strong>
                  <%= block.title || "Untitled hero" %>
                </p>
                <p><strong>Subtitle:</strong>
                  <%= block.subtitle || "No subtitle" %>
                </p>
                <% } %>

                  <% if (block.type==="card" ) { %>
                    <p><strong>Title:</strong>
                      <%= block.title || "Untitled card" %>
                    </p>
                    <p><strong>Description:</strong>
                      <%= block.desc || "No description" %>
                    </p>
                    <% } %>

                      <% if (block.type==="grid" ) { %>
                        <p><strong>Heading:</strong>
                          <%= block.heading || "Untitled grid" %>
                        </p>
                        <p><strong>Items:</strong>
                          <%= Array.isArray(block.items) ? block.items.length : 0 %>
                        </p>
                        <% } %>

                          <% if (block.type==="richtext" ) { %>
                            <p><strong>Heading:</strong>
                              <%= block.heading || "Untitled rich text" %>
                            </p>
                            <p><strong>Content:</strong> Rich text content</p>
                            <% } %>

                              <% if (block.type==="footer" ) { %>
                                <p><strong>Text:</strong>
                                  <%= block.text || "No footer text" %>
                                </p>
                                <% } %>

                                  <button class="block-card__cta" onclick="editBlock(<%= i %>)">
                                    Edit block
                                  </button>
            </div>
            <% }) %>
    </div>
  </div>

  <div id="addBlockModal" class="editor-modal" hidden>
    <div class="editor-modal__dialog">
      <div class="editor-modal__header">
        <div>
          <p class="editor-eyebrow">Add block</p>
          <h2>Create a new section</h2>
        </div>
        <button class="modal-close" type="button" onclick="closeAddBlockModal()">
          X
        </button>
      </div>

      <div class="editor-modal__body">
        <label for="blockType">Block type</label>
        <select id="blockType" onchange="renderBlockFields()">
          <option value="">Select Block</option>
          <option value="hero">Hero</option>
          <option value="card">Card</option>
          <option value="grid">Grid</option>
          <option value="richtext">Rich Text</option>
          <option value="footer">Footer</option>
        </select>

        <div id="blockFields" class="block-fields"></div>
      </div>

      <div class="editor-modal__footer">
        <button class="secondary-btn" type="button" onclick="closeAddBlockModal()">Cancel</button>
        <button class="primary-btn" type="button" onclick="saveNewBlock()">Save block</button>
      </div>
    </div>
  </div>

  <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
  <script>
    const pageId = <%= page.id %>;
    let blocks = <%- JSON.stringify(blocks) %>;
    let pendingGridUploadId = null;
    let richTextEditor = null;

    function ensureHeroIds() {
      blocks = blocks.map((block) => {
        if (block.type !== "hero") {
          return block;
        }

        const images = Array.isArray(block.images)
          ? block.images.filter(Boolean)
          : block.image
            ? [block.image]
            : [];

        return {
          ...block,
          heroId: block.heroId || `hero${Date.now()}${Math.random().toString(36).slice(2, 7)}`,
          images
        };
      });
    }

    ensureHeroIds();

    function destroyRichTextEditor() {
      if (!richTextEditor) return;

      richTextEditor.destroy().catch((error) => console.error(error));
      richTextEditor = null;
    }

    function initRichTextEditor(selector) {
      if (!window.ClassicEditor) return;

      ClassicEditor.create(document.querySelector(selector))
        .then((editor) => {
          richTextEditor = editor;
        })
        .catch((error) => console.error(error));
    }

    function openAddBlockModal() {
      document.getElementById("addBlockModal").hidden = false;
    }

    function closeAddBlockModal() {
      document.getElementById("addBlockModal").hidden = true;
      document.getElementById("blockType").value = "";
      document.getElementById("blockFields").innerHTML = "";
      destroyRichTextEditor();
    }

    function renderBlockFields() {
      destroyRichTextEditor();
      const type = document.getElementById("blockType").value;
      const fields = document.getElementById("blockFields");

      if (type === "hero") {
        fields.innerHTML = `
        <label for="heroTitle">Title</label>
        <input id="heroTitle" placeholder="Hero title">

        <label for="heroSubtitle">Subtitle</label>
        <textarea id="heroSubtitle" rows="4" placeholder="Hero subtitle"></textarea>

        <label for="heroImageFile">Upload Images</label>
        <input id="heroImageFile" type="file" accept="image/*" multiple>
        <div id="heroImagePreviewList" class="block-image-preview-list"></div>
      `;
        return;
      }

      if (type === "card") {
        fields.innerHTML = `
        <label for="cardTitle">Title</label>
        <input id="cardTitle" placeholder="Card title">

        <label for="cardDesc">Description</label>
        <textarea id="cardDesc" rows="5" placeholder="Card description"></textarea>
      `;
        return;
      }

      if (type === "grid") {
        fields.innerHTML = `
        <label for="gridHeading">Heading</label>
        <input id="gridHeading" placeholder="Grid heading">

        <label for="gridSubheading">Subheading</label>
        <textarea id="gridSubheading" rows="3" placeholder="Grid subheading"></textarea>

        <label for="gridColumns">Columns</label>
        <input id="gridColumns" type="number" min="1" max="6" value="3">

        <label for="gridCount">Number of grid items</label>
        <input id="gridCount" type="number" min="1" max="12" value="3">
        <button class="secondary-btn" type="button" onclick="renderGridItemFields()">Create Grid Items</button>

        <div id="gridItems" class="grid-item-fields"></div>
      `;
        renderGridItemFields();
        return;
      }

      if (type === "richtext") {
        fields.innerHTML = `
        <label for="richTextHeading">Heading</label>
        <input id="richTextHeading" placeholder="Rich text heading">

        <label for="richTextContent">Content</label>
        <textarea id="richTextContent" rows="8"></textarea>
      `;
        initRichTextEditor("#richTextContent");
        return;
      }

      if (type === "footer") {
        fields.innerHTML = `
        <label for="footerText">Footer text</label>
        <textarea id="footerText" rows="4" placeholder="Footer text"></textarea>
      `;
        return;
      }

      fields.innerHTML = "";
    }

    function renderGridItemFields() {
      const countInput = document.getElementById("gridCount");
      const gridItems = document.getElementById("gridItems");

      if (!countInput || !gridItems) {
        return;
      }

      const count = Math.max(1, Math.min(Number(countInput.value || 1), 12));
      gridItems.innerHTML = Array.from({ length: count }, (_, i) => `
      <div class="grid-field-card">
        <h3>Grid Item ${i + 1}</h3>
        <label for="gridItemTitle${i}">Title</label>
        <input id="gridItemTitle${i}" placeholder="Item title">

        <label for="gridItemDesc${i}">Description</label>
        <textarea id="gridItemDesc${i}" rows="3" placeholder="Item description"></textarea>

        <label for="gridItemImage${i}">Image</label>
        <input id="gridItemImage${i}" type="file" accept="image/*">
      </div>
    `).join("");
    }

    function saveNewBlock() {
      const type = document.getElementById("blockType").value;

      if (!type) {
        alert("Select a block type first");
        return;
      }

      const nextBlock = { type };

      if (type === "hero") {
        const heroImageFile = document.getElementById("heroImageFile");
        const heroId = `hero${Date.now()}`;
        nextBlock.title = document.getElementById("heroTitle").value.trim();
        nextBlock.subtitle = document.getElementById("heroSubtitle").value.trim();
        nextBlock.heroId = heroId;
        nextBlock.images = heroImageFile ? Array.from(heroImageFile.files || []).map(() => "") : [];
      }

      if (type === "card") {
        nextBlock.title = document.getElementById("cardTitle").value.trim();
        nextBlock.desc = document.getElementById("cardDesc").value.trim();
      }

      if (type === "grid") {
        const count = Math.max(1, Math.min(Number(document.getElementById("gridCount").value || 1), 12));
        const gridId = `grid${Date.now()}`;

        nextBlock.gridId = gridId;
        pendingGridUploadId = gridId;
        nextBlock.heading = document.getElementById("gridHeading").value.trim();
        nextBlock.subheading = document.getElementById("gridSubheading").value.trim();
        nextBlock.columns = Number(document.getElementById("gridColumns").value || 3);
        nextBlock.items = Array.from({ length: count }, (_, i) => ({
          title: document.getElementById(`gridItemTitle${i}`).value.trim(),
          desc: document.getElementById(`gridItemDesc${i}`).value.trim(),
          image: "",
        }));
      }

      if (type === "richtext") {
        nextBlock.heading = document.getElementById("richTextHeading").value.trim();
        nextBlock.content = richTextEditor ? richTextEditor.getData() : document.getElementById("richTextContent").value;
      }

      if (type === "footer") {
        nextBlock.text = document.getElementById("footerText").value.trim();
      }

      blocks.push(nextBlock);
      persistBlocks("Block added successfully");
    }

    function deleteBlock(index) {
      if (!confirm("Delete this block?")) return;

      blocks.splice(index, 1);
      persistBlocks("Block deleted successfully");
    }

    function persistBlocks(successMessage) {
      ensureHeroIds();
      const heroImageFile = document.getElementById("heroImageFile");
      const formData = new FormData();
      formData.append("blocks", JSON.stringify(blocks));

      const pendingHero = [...blocks].reverse().find((block) => block.type === "hero" && block.heroId);
      if (heroImageFile && heroImageFile.files.length && pendingHero) {
        Array.from(heroImageFile.files).forEach((file) => {
          formData.append(`heroImage_${pendingHero.heroId}`, file);
        });
      }

      document.querySelectorAll('input[id^="gridItemImage"]').forEach((input) => {
        if (!input.files[0]) {
          return;
        }

        const index = Number(input.id.replace("gridItemImage", ""));
        const gridBlock = blocks.find((block) => block.type === "grid" && block.gridId === pendingGridUploadId);

        if (gridBlock) {
          formData.append(`gridImage_${gridBlock.gridId}_${index}`, input.files[0]);
        }
      });

      fetch(`/pages/${pageId}`, {
        method: "PUT",
        body: formData,
      })
        .then(async (response) => {
          const data = await response.json().catch(() => ({}));

          if (!response.ok) {
            throw new Error(data.error || "Failed to update page");
          }

          alert(successMessage);
          window.location.reload();
        })
        .catch((error) => {
          console.error(error);
          alert(error.message || "Error updating page");
        });
    }

    function editBlock(index) {
      window.location.href = window.location.pathname + "/block/" + index;
    }

    function filterBlocks() {
      const searchInput = document.getElementById("blockSearch");
      const query = (searchInput ? searchInput.value : "").trim().toLowerCase();
      const blockCards = document.querySelectorAll(".block-card");

      blockCards.forEach((card) => {
        const title = String(card.dataset.blockTitle || "");
        card.style.display = !query || title.includes(query) ? "" : "none";
      });
    }

    document.addEventListener("change", (event) => {
      if (event.target.id !== "heroImageFile") {
        return;
      }

      const previewList = document.getElementById("heroImagePreviewList");

      if (!previewList) {
        return;
      }

      previewList.innerHTML = Array.from(event.target.files || []).map((file) => `
      <img class="block-image-preview" src="${URL.createObjectURL(file)}" alt="Hero preview">
    `).join("");
    });

    const blockSearchInput = document.getElementById("blockSearch");
    if (blockSearchInput) {
      blockSearchInput.addEventListener("input", filterBlocks);
    }
  </script>

</body>

</html>
