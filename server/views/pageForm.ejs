<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>pageform</title>
  <link rel="stylesheet" href="/css/page.css">
  <script src="/javascript/pageForm.js"></script>
</head>
<body>

  <div id="formContainer" class="modal">
    <div class="modal-content">

      <!-- CLOSE -->
      <span class="close-btn" onclick="toggleForm()">✖</span>

      <!-- HEADER -->
      <div class="editor-header">
        <h3>
         Create New Page
        </h3>
      </div>

      <!-- BODY -->
      <div class="editor-body">

        <!-- LEFT -->
        <div class="editor-sidebar">

          <% if (mode !=="edit" ) { %>
            <input id="pageTitle" placeholder="Page Title" required>
            <% } %>

              <select id="blockType">
                <option value="">Select Block</option>
                <option value="hero">Hero</option>
                <option value="card">Cards</option>
                <option value="grid">Grid</option>
                <option value="richtext">Rich Text</option>
                <option value="footer">Footer</option>
              </select>

              <button class="add-block-btn" onclick="showBlockInputs()">Add Block</button>

              <div id="blockInputs"></div>
        </div>
        <!-- RIGHT -->
        <div class="editor-preview">

          <!-- 🔥 LIVE PREVIEW DROPDOWN -->
          <h3 onclick="toggleSection('previewSection')" class="dropdown-header">
            Live Preview 
          </h3>
          <div id="previewSection" class="dropdown-content">
            <div id="previewBox"></div>
          </div>

          <!-- 🔥 BLOCKS DROPDOWN -->
          <h3 onclick="toggleSection('blocksSection')" class="dropdown-header">
            Blocks 
          </h3>
          <div id="blocksSection" class="dropdown-content">
            <div id="blocksPreview"></div>
          </div>
        </div>
      </div>
      <!-- FOOTER -->
      <div class="editor-footer">
        <button type="submit" form="pageForm">Save</button>
      </div>

      <!-- FORM -->
      <form id="pageForm" method="POST" action="<%= formAction %>" enctype="multipart/form-data">

        <input type="hidden" name="blocks" id="blocksData">
        <input type="hidden" name="title" id="hiddenTitle">

       
      </form>

    </div>
  </div>

  <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>

</body>

</html>

