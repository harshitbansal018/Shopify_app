<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="shopify-api-key" content="<%= apiKey %>" />
  <title>Dashboard</title>
  <script src="https://cdn.shopify.com/shopifycloud/app-bridge.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://sdks.shopifycdn.com/polaris/2.0.0/polaris.min.css" />

  <link rel="stylesheet" href="/css/dashboard.css" />
</head>

<body>
  <%
    const totalPosts = Number(stats.total || 0);
    const activePosts = Number(stats.active || 0);
    const inactivePosts = Number(stats.inactive || 0);
    const activeRate = totalPosts ? Math.round((activePosts / totalPosts) * 100) : 0;
    const inactiveRate = totalPosts ? Math.round((inactivePosts / totalPosts) * 100) : 0;
  %>
   <s-app-nav>
        <s-link href="/?" rel="home">Home</s-link>
        <s-link href="/pages/create">Pages</s-link>
        <s-link href="/settings">Settings</s-link>
      </s-app-nav>

  <main class="dashboard-shell">

  <h1>📊 Dashboard</h1>

  <div class="card-container">
    <div class="card">
      <span class="card__label">Total posts</span>
      <span class="card__value"><%= totalPosts %></span>
      <span class="card__meta">All content items currently tracked in your app.</span>
    </div>

    <div class="card">
      <span class="card__label">Active posts</span>
      <span class="card__value"><%= activePosts %></span>
      <span class="card__meta"><%= activeRate %>% of your posts are visible and working as expected.</span>
    </div>

    <div class="card">
      <span class="card__label">Inactive posts</span>
      <span class="card__value"><%= inactivePosts %></span>
      <span class="card__meta"><%= inactiveRate %>% may need review, updates, or republishing.</span>
    </div>
  </div>



  </main>

  <script>
    const params = new URLSearchParams(window.location.search);
    const host = params.get("host");

    const app = window.appBridge.createApp({
      apiKey: document.querySelector('meta[name="shopify-api-key"]').content,
      host: host,
      forceRedirect: true,
    });

    const NavigationMenu = window.appBridge.actions.NavigationMenu;

    NavigationMenu.create(app, {
      items: [
        { label: "Dashboard", destination: "/dashboard" },
        { label: "Posts", destination: "/posts" },
        { label: "Create Post", destination: "/create-post" },
      ],
    });
  </script>
</body>

</html>
