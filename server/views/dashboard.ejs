<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="shopify-api-key" content="<%= apiKey %>" />
  <title>Dashboard</title>
  <script src="https://cdn.shopify.com/shopifycloud/app-bridge.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://sdks.shopifycdn.com/polaris/2.0.0/polaris.min.css" />

  <link rel="stylesheet" href="/css/dashboard.css" />
</head>

<body>

   <s-app-nav>
        <s-link href="/?" rel="home">Home</s-link>
        <s-link href="/pages/create">Pages</s-link>
        <s-link href="/plans">Plans</s-link>
      </s-app-nav>

  <main class="dashboard-shell">

  <h1>📊 Dashboard</h1>

  <div class="card-container">
  <div class="card">
    <span class="card__label">Total pages</span>
    <span class="card__value"><%= totalPages %></span>
    <span class="card__meta">All pages currently created in your store.</span>
  </div>

  <div class="card">
    <span class="card__label">Active pages</span>
    <span class="card__value"><%= activePages %></span>
    <span class="card__meta"><%= activeRate %>% of your pages are live.</span>
  </div>

  <div class="card">
    <span class="card__label">Inactive pages</span>
    <span class="card__value"><%= inactivePages %></span>
    <span class="card__meta"><%= inactiveRate %>% may need attention.</span>
  </div>
</div>



  </main>

  <script>
    const params = new URLSearchParams(window.location.search);
    const host = params.get("host");

    const app = window.appBridge.createApp({
      apiKey: document.querySelector('meta[name="shopify-api-key"]').content,
      host: host,
      forceRedirect: true,
    });

    const NavigationMenu = window.appBridge.actions.NavigationMenu;

    NavigationMenu.create(app, {
      items: [
        { label: "Dashboard", destination: "/dashboard" },
        { label: "Posts", destination: "/posts" },
        { label: "Create Post", destination: "/create-post" },
      ],
    });
  </script>
</body>

</html>
