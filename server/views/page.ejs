<!DOCTYPE html>
<html>

<head>
  <title>Pages</title>
  <link rel="stylesheet" href="/css/page.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body>

  <div class="topbar">
    <h2>My Pages</h2>
    <button onclick="toggleForm()">Create Page</button>
  </div>
  <div class="search">
    <search>
      <input type="text" placeholder="Search pages..." />
    </search>
  </div>

  <div class="table-container">
    <table class="pages-table">
      <thead>
        <tr>
          <th>Sr no</th>
          <th>Title</th>
          <th>Created</th>
          <th>View</th>
          <th>Status</th>
          <th>Actions</th>

        </tr>
      </thead>

      <tbody>

        <% pages.forEach(page=> { %>

          <tr>
            <td>
              <%= pages.indexOf(page) + 1 %>
            </td>
            <td>
              <%= page.title %>
            </td>
            <td>
              <%= page.created_at ? new Date(page.created_at).toLocaleString() : "N/A" %>
            </td>
            <td>
              <% if (page.status==='active' ) { %>
                <button type="button" onclick="openShopifyPage('<%= page.handle %>')">
                  Live
                </button>
                <% } else { %>
                  <button type="button" disabled style="opacity: 0.5; cursor: not-allowed;">
                    N/A
                  </button>
                  <% } %>
            </td>
            <td>
              <button class="status-btn <%= page.status === 'active' ? 'active' : 'inactive' %>"
                onclick="toggleStatus('<%= page.id %>', this)">
                <%= page.status==='active' ? 'Active' : 'Inactive' %>
              </button>
            </td>
            <td style="position: relative;">
              <button class="menu-btn" onclick="toggleMenu('<%= page.id %>')">⋮</button>

              <div id="menu-<%= page.id %>" class="dropdown-menu">
                <button onclick="openEditor('<%= page.id %>')">
                  <i class="fa-solid fa-pen"></i> Edit
                </button>

                <button onclick="deletePage('<%= page.id %>')">
                  <i class="fa-solid fa-trash"></i> Delete
                </button>
              </div>
            </td>

          </tr>
          <% }) %>
      </tbody>
    </table>
    <div id="pagination" style="margin-top:20px; text-align:center;">
      <button onclick="prevPage()">Prev</button>
      <span id="pageInfo"></span>
      <button onclick="nextPage()">Next</button>
    </div>
  </div>

  <%- include("pageForm", { formAction: `/pages/create?shop=${shop}`, mode: "create" , initialBlocks: [] }) %>

    <script>
      function openShopifyPage(handle) {
        const shop = "<%= shop %>";
        window.open(`https://${shop}/pages/${handle}`, "_blank");
      }

      function openEditor(id) {
        window.location.href = `/pages/editor/${id}`;
      }

      function deletePage(id) {
        if (!confirm("Are you sure you want to delete this page?")) return;

        fetch(`/pages/delete/${id}`, {
          method: "DELETE"
        })
          .then(res => {
            if (!res.ok) throw new Error("Delete failed");
            return res.json();
          })
          .then(data => {
            if (data.success) {
              location.reload();
            } else {
              alert("Delete failed");
            }
          })
          .catch(err => {
            console.error("Delete error:", err);
            alert("Something went wrong");
          });
      }
      function toggleMenu(id) {
        const menu = document.getElementById(`menu-${id}`);

        // Close all menus
        document.querySelectorAll(".dropdown-menu").forEach(m => {
          if (m !== menu) m.style.display = "none";
        });

        menu.style.display = (menu.style.display === "block") ? "none" : "block";

        const rect = menu.getBoundingClientRect();

        // 🔥 If going outside screen → open upward
        if (rect.bottom > window.innerHeight) {
          menu.style.top = "auto";
          menu.style.bottom = "40px";
        } else {
          menu.style.top = "40px";
          menu.style.bottom = "auto";
        }
      }

      // Close when clicking outside
      window.addEventListener("click", function (e) {
        if (!e.target.closest(".menu-btn")) {
          document.querySelectorAll(".dropdown-menu").forEach(menu => {
            menu.style.display = "none";
          });
        }
      });

      function toggleStatus(id, btn) {
        fetch(`/pages/toggle-status/${id}`, {
          method: "PUT"
        })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              if (data.status === "active") {
                btn.innerText = "Active";
                btn.classList.remove("inactive");
                btn.classList.add("active");
              } else {
                btn.innerText = "Inactive";
                btn.classList.remove("active");
                btn.classList.add("inactive");
              }
            }
            window.location.reload();
          })
          .catch(err => {
            console.error(err);
            alert("Failed to update status");
          });
      }
      document.querySelector("input").addEventListener("input", function (e) {
        const value = e.target.value.toLowerCase();

        document.querySelectorAll(".pages-table tbody tr").forEach(row => {
          const text = row.innerText.toLowerCase();

          row.style.display = text.includes(value) ? "" : "none";
        });
      });

      let currentPage = 1;
      const rowsPerPage = 5;

      function showPage(page) {
        const rows = document.querySelectorAll(".pages-table tbody tr");
        const totalPages = Math.ceil(rows.length / rowsPerPage);

        currentPage = page;

        rows.forEach((row, index) => {
          const start = (page - 1) * rowsPerPage;
          const end = start + rowsPerPage;

          row.style.display = (index >= start && index < end) ? "" : "none";
        });

        document.getElementById("pageInfo").innerText = `Page ${page} of ${totalPages}`;
      }

      function nextPage() {
        const rows = document.querySelectorAll(".pages-table tbody tr");
        const totalPages = Math.ceil(rows.length / rowsPerPage);

        if (currentPage < totalPages) {
          showPage(currentPage + 1);
        }
      }

      function prevPage() {
        if (currentPage > 1) {
          showPage(currentPage - 1);
        }
      }

      // 🔥 INIT
      document.addEventListener("DOMContentLoaded", () => {
        showPage(1);
      });
    </script>

</body>

</html>