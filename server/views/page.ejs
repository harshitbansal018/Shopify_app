<!DOCTYPE html>
<html>
<head>
  <title>Pages</title>
  <link rel="stylesheet" href="/css/page.css">
</head>

<body>

<div class="topbar">
  <h2>My Pages</h2>
  <button onclick="toggleForm()">Create Page</button>
</div>

<div class="table-container">
  <table class="pages-table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Created</th>
        <th>View</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% pages.forEach(page => { %>
        <tr>
          <td><%= page.title %></td>
          <td><%= page.created_at ? new Date(page.created_at).toLocaleString() : "N/A" %></td>
          <td>
            <button type="button" onclick="openShopifyPage('<%= page.handle %>')">Live</button>
          </td>
          <td>
            <button type="button" onclick="openEditor('<%= page.id %>')">Edit</button>
            <button type="button" onclick="deletePage('<%= page.id %>')">Delete</button>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include("pageForm", { 
  formAction: `/pages/create?shop=${shop}`,
  mode: "create",
  initialBlocks: []
}) %>

<script>
  function openShopifyPage(handle) {
    const shop = "<%= shop %>";
    window.open(`https://${shop}/pages/${handle}`, "_blank");
  }

  function openEditor(id) {
    window.location.href = `/pages/editor/${id}`;
  }

  function deletePage(id) {
    if (!confirm("Are you sure you want to delete this page?")) return;

    fetch(`/pages/delete/${id}`, {
      method: "DELETE"
    })
      .then(res => {
        if (!res.ok) throw new Error("Delete failed");
        return res.json();
      })
      .then(data => {
        if (data.success) {
          location.reload();
        } else {
          alert("Delete failed");
        }
      })
      .catch(err => {
        console.error("Delete error:", err);
        alert("Something went wrong");
      });
  }
</script>

</body>
</html>