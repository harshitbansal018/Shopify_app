# ===============================
# SERVER
# ===============================
PORT=3000

# Public HTTPS URL of this app, no trailing slash.
# Must match the App URL in the Partner Dashboard exactly, and the redirect
# URL there must be exactly HOST + /api/auth/callback.
HOST=https://your-public-url.com

# ===============================
# SHOPIFY
# ===============================
# Partner Dashboard > your app > Configuration > Client credentials
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret

# Admin API version used for GraphQL calls and webhook registration.
SHOPIFY_API_VERSION=2025-01

# Access scopes requested during OAuth. Start minimal and add only what your
# feature actually needs -- changing this requires merchants to reinstall.
SHOPIFY_SCOPES=read_products

# Timeout for outbound Shopify calls, in milliseconds.
SHOPIFY_TIMEOUT_MS=15000

# ===============================
# ENCRYPTION
# ===============================
# 32 bytes, base64 or hex. Encrypts stores.access_token / refresh_token at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every stored token undecryptable -- all stores must reinstall.
TOKEN_ENCRYPTION_KEY=generate_me

# ===============================
# DATABASE (MySQL)
# ===============================
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=shopify_app_db
DB_POOL_SIZE=10
